map pyramid_level_2(RIMSALA) {
    enum entrance {
        south = entrance(0x21, 0x3e, NORTH)
    }

    enum soundtrack {
        default = soundtrack(AREA_INVERTED_PYRAMID.MUSIC, 0xff)
    }

    enum stepon_trigger {
        exit_south = @install() {
            debug_subtext("S=0");

            _add_morph_ball_stone(False, True, False, {
                map_transition(pyramid, pyramid_3_1, SOUTH);
            });
        },
        stepon_1 = @install() {
            debug_subtext("S=1");
        },
        spawn_boss = @install() {
            debug_subtext("S=2");
        },
        entrance_side = @install() {
            debug_subtext("S=3");
        },
        entrance = @install() {
            debug_subtext("S=4");

            // object[0x06] = 0x05; // close door
        }
    }

    fun trigger_enter() {
        default_init_room(False, False);
    }
};
