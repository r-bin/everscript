map pyramid_level_1(PYRAMID_2) {
    enum entrance {
        south_2 = entrance(0x54, 0x70, NORTH),
        south_1 = entrance(0x74, 0x70, NORTH),
        stairs_up = entrance(0x8c, 0x48, SOUTH),
        stairs_down_north_west = entrance(0x06, 0x18, NORTH),
        stairs_down_south_east = entrance(0xb6, 0x68, NORTH),

        south_2_short = entrance(0x53, 0x7b, NORTH),

        test = entrance(0d103, 0d63, NONE),

        from_cutscene = entrance(0d182, 0d103, NONE),
    }

    enum soundtrack {
        default = soundtrack(AREA_INVERTED_PYRAMID.MUSIC, 0xff)
    }

    enum ROOM {
        WITH_RAIDED_GOURDS = True,

        TRAP_ID = memory(WORD, TEMP),
        TRAP_HP = 0d5,
    }

    enum stepon_trigger {
        door_switch = @install() {
            debug_subtext("S=0");

            object[0x00] = 0x05; // open door_stairs_down_west
            sound(THRAXX_BRIDGE_COLLAPSING);

            if(ROOM.TRAP_ID[HP] > 0d0) {
                cast(ROOM.TRAP_ID, ACTIVE, FLASH, 0d15);
                sleep(0d5);
                cast(ROOM.TRAP_ID, ACTIVE, FLASH, 0d15);
            }
        },
        stairs_down_west = @install() {
            debug_subtext("S=1");

            question("Jump into the tomb?[LF](No way back in sight…)[CHOICE]yes…[CHOICE]no…");
            if(MEMORY.QUESTION_ANSWER == 0d0) {
                animation_fall_pit(ACTIVE);

                map_transition(inverted_pyramid_level_0, tunnel_east, NONE);
            } else {
                error_walk_back(NORTH);
            }
        },
        door_down_east = @install() {
            debug_subtext("S=2");
        },
        stairs_up = @install() {
            debug_subtext("S=3");

            map_transition(pyramid, pyramid_3_2, NORTH);
        },
        door_south_2 = @install() {
            debug_subtext("S=4");

            map_transition(pyramid, pyramid_2_1, SOUTH);
        },
        door_south_1 = @install() {
            debug_subtext("S=5");

            map_transition(pyramid, pyramid_2_2, SOUTH);
        },
    }

    enum b_trigger {
        gourd_x__3_limestone = @install() {
            debug_subtext("B=0");
            _loot_chest(0x18, LIMESTONE, 0d03);
        },
        gourd_x__1_mushroom = @install() {
            debug_subtext("B=1");
            _loot_chest(0x17, MUSHROOM, 0d01);
        },
        gourd_x__2_call_beads = @install() {
            debug_subtext("B=2");
            // _loot_chest(0x16, CALL_BEADS, 0d02);

            _loot_chest(0x16, LIMESTONE_TABLET, 0d01);
        },
        gourd_x__1_petal = @install() {
            debug_subtext("B=3");
            _loot_chest(0x15, PETAL, 0d01);
        },
        gourd_x__2_iron = @install() {
            debug_subtext("B=4");
            _loot_chest(0x14, IRON, 0d02);
        },
        gourd_x__1_honey = @install() {
            debug_subtext("B=5");
            _loot_chest(0x13, HONEY, 0d01);
        },
        gourd_x__1_nectar = @install() {
            debug_subtext("B=6");
            _loot_chest(0x12, NECTAR, 0d01);
        },
        gourd_x__4_feather = @install() {
            debug_subtext("B=7");
            _loot_chest(0x11, FEATHER, 0d04);
        },
        gourd_x__1_biscuit = @install() {
            debug_subtext("B=8");
            _loot_chest(0x10, BISCUIT, 0d01);
        },
        gourd_x__1_herbal_essence = @install() {
            debug_subtext("B=9");
            _loot_chest(0x0f, HERBAL_ESSENCE, 0d01);
        },

        gourd_x__1_acorn = @install() {
            debug_subtext("B=10");
            _loot_chest(0x0e, ACORNS, 0d01);
        },
        gourd_x__2_meteorite = @install() {
            debug_subtext("B=11");
            _loot_chest(0x0d, METEORITE, 0d02);
        },
        gourd_x__3_clay = @install() {
            debug_subtext("B=12");
            _loot_chest(0x0c, CLAY, 0d03);
        },
        gourd_x__2_gunpowder = @install() {
            debug_subtext("B=13");
            _loot_chest(0x0b, GUNPOWDER, 0d02);
        },
        gourd_x__1_grease = @install() {
            debug_subtext("B=14");
            _loot_chest(0x0a, GREASE, 0d01);
        },
        gourd_x__1_wings = @install() {
            debug_subtext("B=15");
            _loot_chest(0x09, WINGS, 0d01);
        },
        gourd_x__3_ethanol = @install() {
            debug_subtext("B=16");
            _loot_chest(0x08, ETHANOL, 0d03);
        },
        gourd_x__2_dry_ice = @install() {
            debug_subtext("B=17");
            _loot_chest(0x07, DRY_ICE, 0d02);
        },
        gourd_x__1_nectar = @install() {
            debug_subtext("B=18");
            _loot_chest(0x06, NECTAR, 0d01);
        },
        gourd_x__2_limestone = @install() {
            debug_subtext("B=19");
            _loot_chest(0x05, LIMESTONE, 0d02);
        },

        gourd_x__1_herbal_essence = @install() {
            debug_subtext("B=20");
            _loot_chest(0x04, HERBAL_ESSENCE, 0d01);
        },
        gourd_x__3_water = @install() {
            debug_subtext("B=21");
            _loot_chest(0x03, WATER, 0d03);
        },
        gourd_x__1_petal = @install() {
            debug_subtext("B=22");
            _loot_chest(0x02, PETAL, 0d01);
        },
        axe2_door_gourd = @install() {
            debug_subtext("B=23");

            guard_axe_2();

            animate(BOY, ONCE, ANIMATION_ALL.SLASH_2);
            sound(THRAXX_BRIDGE_COLLAPSING);

            object[0x01] = 0x04;
        },
    }

    fun trigger_enter() {
        AREA_PYRAMID.UPPER_PYRAMID_OPENED = True;
        
        // object[0x00] = 0x04; // open door_stairs_down_west
        // object[0x01] = 0x04; // open door_gourd
        // gourds

        if(ROOM.WITH_RAIDED_GOURDS) {
            object[0x11] = 0x01; // open gourd_x
            object[0x10] = 0x01; // open gourd_x
            object[0x0a] = 0x01; // open gourd_x
            object[0x0f] = 0x01; // open gourd_x

            object[0x0e] = 0x01; // open gourd_x
            object[0x0b] = 0x01; // open gourd_x
            object[0x0d] = 0x01; // open gourd_x
        }

        if!(AREA_INVERTED_PYRAMID.STONE_UNDERGROUND_LEVEL_1_RIGHT_DROPPED) {
            add_enemy(STONE, 0d182, 0d106);
            attribute(LAST_ENTITY, INVINCIBLE_TEMP, True);
            attach_script(LAST_ENTITY, B, reference(@install() {
                AREA_INVERTED_PYRAMID.STONE_UNDERGROUND_LEVEL_1_RIGHT_DROPPED = True;
                
                map_transition(inverted_pyramid_level_1, cutscene_stone_right, NONE);
            }));
        }

        default_init_room(False, False);

        add_enemy(RIMSALA_STATUTE_ENTITY, 0d57, 0d25);
        <LAST_ENTITY>[HP] = ROOM.TRAP_HP;
        ROOM.TRAP_ID = <LAST_ENTITY>;
    }
};
