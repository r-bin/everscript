map inverted_pyramid_level_1_secret_entrance_room_west(PYRAMID_CAVE) {
    enum entrance {
        teleporter = entrance(0d23, 0d18, NONE, { teleporter_in(SOUTH); }),
        south = entrance(0x15, 0x23, NORTH),
        
        crash = entrance(0d23, 0d27, NONE, { crash_both(); }),
    }

    enum soundtrack {
        default = soundtrack(AREA_INVERTED_PYRAMID.MUSIC, 0xff)
    }

    enum stepon_trigger {
        exit_south = @install() {
            debug_subtext("S=0");

            map_transition(northwest_inbetwixx, tunnel, SOUTH);
        },
        exit_teleporter = @install() {
            debug_subtext("S=1");

            teleporter_out(0d23, 0d17);
            map_transition(inverted_pyramid_level_1, teleporter_room_west, NONE);
        },
    }

    fun trigger_enter() {
        default_init_room(False, False);
    }
};
