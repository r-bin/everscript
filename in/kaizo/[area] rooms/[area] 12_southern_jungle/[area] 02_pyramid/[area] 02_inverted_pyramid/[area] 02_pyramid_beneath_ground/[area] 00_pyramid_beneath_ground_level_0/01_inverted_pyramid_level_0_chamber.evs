map inverted_pyramid_level_0_chamber(RIMSALA) {
    enum entrance {
        south = entrance(0x21, 0x3e, NORTH)
    }

    enum soundtrack {
        default = soundtrack(AREA_INVERTED_PYRAMID.MUSIC, 0xff)
    }

    enum BOSS {
        PROGRESS = memory(FLAG, TEMP),

        HP = 0d800,
    }

    enum stepon_trigger {
        exit_south = @install() {
            debug_subtext("S=0");

            map_transition(inverted_pyramid_level_0, stairs_up_center, SOUTH);
        },
        stepon_1 = @install() {
            debug_subtext("S=1");
        },
        spawn_boss = @install() {
            debug_subtext("S=2");

            if((!SOULS_MEMORY.DEAD_PUDGE) && (!BOSS.PROGRESS)) {
                BOSS.PROGRESS = True;
                push_music(BOSS_DRUMS);
                
                add_custom_boss_pudge(0d34, 0d24, False, {
                    if(False) {
                        debug_subtext("-pudge");
                    }
                }, False, BOSS.HP);

                souls_boss_defeated_helper(PUDGE);
                BOSS.PROGRESS = False;

                object[0x06] = 0x00; // close door
            }
        },
        entrance_side = @install() {
            debug_subtext("S=3");
        },
        entrance = @install() {
            debug_subtext("S=4");

            if((!SOULS_MEMORY.DEAD_PUDGE) && (!BOSS.PROGRESS)) {
                object[0x06] = 0x05; // close door
            }
        }
    }

    fun trigger_enter() {
        default_init_room(False, False);
    }
};
