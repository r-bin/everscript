        },
        spawn_boss = @install() {
            debug_subtext("S=41");

            if((!SOULS_MEMORY.DEAD_DIABLO) && (!BOSS.PROGRESS)) {
                BOSS.PROGRESS = True;
                CUSTOM_FLAG.SLOW_GROUND_SWITCHES = True;

                push_music(BOSS);
                
                add_custom_boss_diablo(0d85, 0d23, False, {
                    if(False) {
                        debug_subtext("-boss");
                    }
                }, False, BOSS.HP);

                souls_boss_defeated_helper(DIABLO);

                BOSS.PROGRESS = False;
                CUSTOM_FLAG.SLOW_GROUND_SWITCHES = False;
                show_bonfire();
            }
