        });
    }

    fun trigger_enter() {
        restore_object_animator(AXE2_DOOR, ROOM.DOOR_CENTER_OPENED, 0x0e);
        restore_object_animator(AXE2_DOOR, ROOM.DOOR_MINI_BOSS_OPENED, 0x0c);
        restore_object_animator(AXE2_DOOR, ROOM.DOOR_ALCHEMIST_OPENED, 0x0d);
        restore_object_animator(AXE2_DOOR, ROOM.DOOR_HORACE_OPENED, 0x10);
        restore_object_animator(AXE2_DOOR, ROOM.DOOR_DOG_OPENED, 0x0f);

        if(ROOM.RESTORE_BRIDGES) {
            restore_object_animator(LOTUS_BRIDGE, ROOM.BRIDGE_WEST_1_COLLAPSED, 0x24, 0d5);
            restore_object_animator(LOTUS_BRIDGE, ROOM.BRIDGE_WEST_2_COLLAPSED, 0x25, 0d5);
            restore_object_animator(LOTUS_BRIDGE, ROOM.BRIDGE_WEST_3_COLLAPSED, 0x26, 0d7);
            restore_object_animator(LOTUS_BRIDGE, ROOM.BRIDGE_EAST_1_COLLAPSED, 0x27, 0d7);
            restore_object_animator(LOTUS_BRIDGE, ROOM.BRIDGE_EAST_2_COLLAPSED, 0x28, 0d7);
            restore_object_animator(LOTUS_BRIDGE, ROOM.BRIDGE_EAST_3_COLLAPSED, 0x29, 0d4);
            restore_object_animator(LOTUS_BRIDGE, ROOM.BRIDGE_EAST_4_COLLAPSED, 0x2a, 0d8);
        } else {
            ROOM.BRIDGE_WEST_1_COLLAPSED = False;
            ROOM.BRIDGE_WEST_2_COLLAPSED = False;
            ROOM.BRIDGE_WEST_3_COLLAPSED = False;
            ROOM.BRIDGE_EAST_1_COLLAPSED = False;
            ROOM.BRIDGE_EAST_2_COLLAPSED = False;
            ROOM.BRIDGE_EAST_3_COLLAPSED = False;
            ROOM.BRIDGE_EAST_4_COLLAPSED = False;
        }
        
        if!(AREA_INVERTED_PYRAMID.STONE_UNDERGROUND_LEVEL_1_LEFT_DROPPED) {
            add_enemy(STONE, 0d138, 0d121);
            attribute(LAST_ENTITY, INVINCIBLE_TEMP, True);
            attach_script(LAST_ENTITY, B, reference(@install() {
                AREA_INVERTED_PYRAMID.STONE_UNDERGROUND_LEVEL_1_LEFT_DROPPED = True;
                
                map_transition(inverted_pyramid_level_1, cutscene_stone_left, NONE);
            }));
        }

        if(SOULS_MEMORY.DEAD_DIABLO) {
            show_bonfire();
        }

        default_init_room(False, False);

        // object[0x00] = 0x03; // open gate_entry
        // object[0x01] = 0x03; // open gate_boss
        // object[0x02] = 0x03; // open gate_gourds
        // object[0x03] = 0x03; // open gate_horace
        // object[0x04] = 0x01; // activate switch_1
        // object[0x05] = 0x01; // activate switch_4
        // object[0x06] = 0x01; // activate switch_2
        // object[0x07] = 0x01; // activate switch_3
        // object[0x08] = 0x01; // activate snake_west_1
        // object[0x09] = 0x01; // activate snake_west_2
        // object[0x0a] = 0x01; // activate snake_west_4
        // object[0x0b] = 0x01; // activate snake_west_3
        // object[0x0c] = 0x01; // open door_miniboss
        // object[0x0d] = 0x01; // open door_gourds
        // object[0x0e] = 0x01; // open door_center
        // object[0x0f] = 0x01; // open door_dog
        // object[0x10] = 0x04; // open door_horace
        // object[0x11] = 0x04; // activate snake_east_1
        // object[0x12] = 0x04; // activate snake_east_2
        // object[0x13] = 0x04; // activate snake_east_3
        // ???
        // object[0x24] = 0x05; // collpse bridge_west_1
        // object[0x25] = 0x05; // collpse bridge_west_2
        // object[0x26] = 0x05; // collpse bridge_west_3
        // object[0x27] = 0x05; // collpse bridge_east_1
        // object[0x28] = 0x05; // collpse bridge_east_2
        // object[0x29] = 0x05; // collpse bridge_east_3
        // object[0x2a] = 0x05; // collpse bridge_east_4

        add_levitate_stone(0d141, 0d17, reference(@install() {
            guard_levitate_stone(0d1);
        }));
        ROOM.STONE_TOP_ID = <LAST_ENTITY>;
        add_levitate_stone(0d136, 0d96, reference(@install() {
            guard_levitate_stone(0d1);
        }));
        ROOM.STONE_CENTER_ID = <LAST_ENTITY>;

        remember_stone_handler(ROOM.STONE_TOP_ID, ROOM.STONE_CENTER_ID);

        switch_1_handler();
        switch_2_handler();
        switch_3_handler();
        switch_4_handler();

        special_script(LEVITATE, reference(@install() {
            guard_challenge_levitate();

            if(<SCRIPT_OWNER>[FLAGS_2] & ATTRIBUTE_FLAGS.INVINCIBLE_TEMP) {
                end();
            }

            attribute(SCRIPT_OWNER, INVINCIBLE_TEMP, True);

            sleep(0d120);

            while(arg[0x10] < ROOM.STONE_OFFSET) {
                arg[0x10]++;

                <SCRIPT_OWNER>[X]--;

                sleep(0d3);
            }

            sleep(0d360 - 0d3 * ROOM.STONE_OFFSET);

            attribute(SCRIPT_OWNER, INVINCIBLE_TEMP, False);
        }));

        // north
        add_enemy_spawner(DRAKE, 0d170, 0d36);

        // center
        add_enemy_spawner(DRAKE, 0d142, 0d71);

        // east
        add_enemy_spawner(DRAKE, 0d224, 0d111);
        add_enemy_spawner(DRAKE, 0d227, 0d93);
        add_enemy_spawner(DRAKE, 0d227, 0d76);

        add_enemy_spawner(DRAKE, 0d187, 0d54);

        // south west
        add_enemy_spawner(SPIDER, 0d86, 0d115);

        // west
        add_enemy_spawner(SPIDER, 0d11, 0d42);
        add_enemy_spawner(SPIDER, 0d15, 0d78);
        add_enemy_spawner(SPIDER, 0d11, 0d96);
        add_enemy_spawner(SPIDER, 0d11, 0d126);

        // north west
        add_enemy_spawner(SPIDER, 0d50, 0d43);

        add_enemy_spawner(SPIDER, 0d37, 0d13);

        // north west - stairs
        add_enemy_spawner(SPIDER, 0d40, 0d82);

        add_enemy_spawner(SPIDER, 0d61, 0d65);

        add_enemy_spawner(SPIDER, 0d38, 0d55);
    }
};
