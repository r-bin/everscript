        },
        bridge_east_1_south = @install() {
            debug_subtext("S=43");

            act2_lotus_bridge_3(0x27, ROOM.BRIDGE_EAST_1_COLLAPSED, 0x9e, 0x84, 0x9d, 0x7e, 0x9c, 0x78, 0d7, NORTH);
        },
        bridge_east_1_north = @install() {
