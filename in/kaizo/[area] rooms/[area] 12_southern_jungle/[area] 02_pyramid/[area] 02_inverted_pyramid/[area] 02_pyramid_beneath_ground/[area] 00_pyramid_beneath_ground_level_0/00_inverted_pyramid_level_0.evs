            act2_lotus_bridge_3(0x27, ROOM.BRIDGE_EAST_1_COLLAPSED, 0x9c, 0x78, 0x9d, 0x7e, 0x9e, 0x84, 0d7, SOUTH);
        },
        bridge_east_2_south = @install() {
            debug_subtext("S=45");

            act2_lotus_bridge_3(0x28, ROOM.BRIDGE_EAST_2_COLLAPSED, 0xaa, 0x84, 0xaa, 0x7e, 0xac, 0x78, 0d7, NORTH);
        },
        bridge_east_2_north = @install() {
            debug_subtext("S=46");

            act2_lotus_bridge_3(0x28, ROOM.BRIDGE_EAST_2_COLLAPSED, 0xac, 0x78, 0xaa, 0x7e, 0xaa, 0x87, 0d7, SOUTH);
        },
    }

