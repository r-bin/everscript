    @install()
    @async()
    fun remember_stone_handler(stone_top, stone_center) {
        if(ROOM.STONE_TOP_X && ROOM.STONE_TOP_Y) {
            _teleport(stone_top, ROOM.STONE_TOP_X, ROOM.STONE_TOP_Y);
        }
        if(ROOM.STONE_CENTER_X && ROOM.STONE_CENTER_Y) {
            _teleport(stone_center, ROOM.STONE_CENTER_X, ROOM.STONE_CENTER_Y);
        }

        while(True) {
            sleep(0d3, S);

            ROOM.STONE_TOP_X = stone_top[X];
            ROOM.STONE_TOP_Y = stone_top[Y];

            sleep(0d3, S);

            ROOM.STONE_CENTER_X = stone_center[X];
            ROOM.STONE_CENTER_Y = stone_center[Y];
        }
    }

    @install()
    @async()
    fun switch_1_handler() {
        souls_toggle_switch_trigger(False, 0d130, 0d74, {
            if(ROOM.DEBUG) {
                subtext("1");
            }

            object[0x04] = 0x01; // activate switch_1
            sound(ELEVATOR_DOOR);
            object[0x00] = 0x03; // open gate_entry
        }, {
            if(ROOM.DEBUG) {
                subtext("!1");
            }

            object[0x04] = 0x00; // activate switch_1
            sound(ELEVATOR_DOOR);
            object[0x00] = 0x00; // open gate_entry
        });
    }
    @install()
    @async()
    fun switch_2_handler() {
        souls_toggle_switch_trigger(False, 0d130, 0d96, {
            if(ROOM.DEBUG) {
                subtext("2");
            }

            object[0x06] = 0x01; // activate switch_2
            sound(ELEVATOR_DOOR);
            object[0x01] = 0x03; // open gate_boss
        }, {
            if(ROOM.DEBUG) {
                subtext("!2");
            }

            object[0x06] = 0x00; // activate switch_2
            sound(ELEVATOR_DOOR);
            object[0x01] = 0x00; // open gate_boss
        });
    }
    @install()
    @async()
    fun switch_3_handler() {
        souls_toggle_switch_trigger(False, 0d156, 0d96, {
            if(ROOM.DEBUG) {
                subtext("3");
            }

            object[0x07] = 0x01; // activate switch_3
            sound(ELEVATOR_DOOR);
            object[0x03] = 0x03; // open gate_horace
        }, {
            if(ROOM.DEBUG) {
                subtext("!3");
            }

            object[0x07] = 0x00; // activate switch_3
            sound(ELEVATOR_DOOR);
            object[0x03] = 0x00; // open gate_horace
        });
    }
    @install()
    @async()
    fun switch_4_handler() {
        souls_toggle_switch_trigger(False, 0d156, 0d74, {
            if(ROOM.DEBUG) {
                subtext("4");
            }

            object[0x05] = 0x01; // activate switch_4
            sound(ELEVATOR_DOOR);
            object[0x02] = 0x03; // open gate_gourds
        }, {
            if(ROOM.DEBUG) {
                subtext("!4");
            }

            object[0x05] = 0x00; // activate switch_4
            sound(ELEVATOR_DOOR);
