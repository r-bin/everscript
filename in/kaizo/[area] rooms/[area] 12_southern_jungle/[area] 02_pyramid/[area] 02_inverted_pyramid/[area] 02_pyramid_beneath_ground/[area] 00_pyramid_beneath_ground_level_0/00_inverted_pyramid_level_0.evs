map inverted_pyramid_level_0(PYRAMID_1) {
    enum ROOM {
        DEBUG = False,

        DOOR_CENTER_OPENED = memory(FLAG, SRAM),
        DOOR_MINI_BOSS_OPENED = memory(FLAG, SRAM),
        DOOR_ALCHEMIST_OPENED = memory(FLAG, SRAM),
        DOOR_HORACE_OPENED = memory(FLAG, SRAM),
        DOOR_DOG_OPENED = memory(FLAG, SRAM),

        RESTORE_BRIDGES = memory(FLAG, TEMP),
        BRIDGE_WEST_1_COLLAPSED = memory(FLAG, RAM),
        BRIDGE_WEST_2_COLLAPSED = memory(FLAG, RAM),
        BRIDGE_WEST_3_COLLAPSED = memory(FLAG, RAM),
        BRIDGE_EAST_1_COLLAPSED = memory(FLAG, RAM),
        BRIDGE_EAST_2_COLLAPSED = memory(FLAG, RAM),
        BRIDGE_EAST_3_COLLAPSED = memory(FLAG, RAM),
        BRIDGE_EAST_4_COLLAPSED = memory(FLAG, RAM),

        STONE_TOP_ID = memory(WORD, TEMP),
        STONE_TOP_X = memory(WORD, RAM),
        STONE_TOP_Y = memory(WORD, RAM),
        STONE_CENTER_ID = memory(WORD, TEMP),
        STONE_CENTER_X = memory(WORD, RAM),
        STONE_CENTER_Y = memory(WORD, RAM),

        STONE_OFFSET = 0d8 * 0d6,

        SNAKE_TRAP_TRIGGERED = memory(FLAG, TEMP),
        SNAKE_TRAP_2_TRIGGERED = memory(FLAG, TEMP),
    }

    enum entrance {
        south = entrance(0x8a, 0x90, NORTH),
        stairs_up_center = entrance(0x3e, 0x3e, SOUTH),
        stairs_up_south_east = entrance(0xd4, 0x6c, SOUTH),

        south_short = entrance(0x89, 0x97, SOUTH),

        tunnel_west = entrance(0d76, 0d100, NONE, { crash_both(); }),
        tunnel_east = entrance(0d111, 0d64, NONE, { crash_both(); }),

        from_cutscene = entrance(0d138, 0d115, NONE, { ROOM.RESTORE_BRIDGES = True; }),

        bonfire = entrance(0d97, 0d70, NONE, { bonfire_wakeup(0d0, -0d24, -0d24, -0d8); }),
    }

    enum soundtrack {
        default = soundtrack(AREA_INVERTED_PYRAMID.MUSIC, 0xff)
    }

    enum BOSS {
        PROGRESS = memory(FLAG, TEMP),

        HP = 0d400,
    }

    @install()
    fun trap_triggered() {
        debug_subtext("S=4…10");

        teleporter_out();
        map_transition(inverted_pyramid_level_0, tunnel_west, NONE);
    }

    @install()
    fun show_bonfire() {
        bonfire(0d97, 0d70, SOULS_MEMORY.BONFIRE_INVERTED_PYRAMID);
    }

    enum stepon_trigger {
        bridge_west_2_north = @install() {
            debug_subtext("S=0");

            act2_lotus_bridge_1(0x25, ROOM.BRIDGE_WEST_2_COLLAPSED, 0x35, 0x85, 0d5, NONE);
        },
        bridge_west_2_south = @install() {
            debug_subtext("S=1");

            act2_lotus_bridge_1(0x25, ROOM.BRIDGE_WEST_2_COLLAPSED, 0x33, 0x78, 0d5, NORTH);
        },
        bridge_west_1_north = @install() {
            debug_subtext("S=2");

            act2_lotus_bridge_1(0x24, ROOM.BRIDGE_WEST_1_COLLAPSED, 0x2d, 0x85, 0d5, NONE);
        },
        bridge_west_1_south = @install() {
            debug_subtext("S=3");

            act2_lotus_bridge_1(0x24, ROOM.BRIDGE_WEST_1_COLLAPSED, 0x29, 0x78, 0d5, NORTH);
        },
        trap_west_3 = trap_triggered(),
        trap_west_2 = trap_triggered(),
        trap_west_1 = @install() {
            debug_subtext("S=6");

            if(!ROOM.SNAKE_TRAP_TRIGGERED) {
                ROOM.SNAKE_TRAP_TRIGGERED = True;

                act2_snake_trap(0d10, 0d34, 0x08, True);
                arg[0x10] = <LAST_ENTITY>;

                cast(arg[0x10], ACTIVE, FLASH, 0d15);
                sleep(0d5);
                cast(arg[0x10], ACTIVE, FLASH, 0d15);

                wait(arg[0x10]);

                animate(arg[0x10], ONCE, SLASH_1);

                cast(arg[0x10], ACTIVE, FIREBALL, 0d50);
            }
        },
        trap_west_4 = trap_triggered(),
        trap_east_3 = trap_triggered(),
        trap_east_2 = trap_triggered(),

        trap_east_1 = trap_triggered(),
        bridge_east_4_north = @install() {
            debug_subtext("S=11");

            // act2_lotus_bridge_2(0x2a, 0xc4, 0x84, 0xc8, 0x78, 0d7, SOUTH);

            act2_lotus_bridge_1(0x2a, ROOM.BRIDGE_EAST_4_COLLAPSED, 0d197, 0d131, 0d8, SOUTH);
        },
        bridge_east_3_south = @install() {
            debug_subtext("S=12");

            act2_lotus_bridge_1(0x29, ROOM.BRIDGE_EAST_3_COLLAPSED, 0d183, 0d121, 0d4, NORTH);
        },
        bridge_east_4_south = @install() {
            debug_subtext("S=13");

            act2_lotus_bridge_1(0x2a, ROOM.BRIDGE_EAST_4_COLLAPSED, 0d199, 0d119, 0d8, NORTH);
        },
        bridge_east_3_north = @install() {
            debug_subtext("S=14");

            act2_lotus_bridge_1(0x29, ROOM.BRIDGE_EAST_3_COLLAPSED, 0d190, 0d132, 0d4, SOUTH);
        },
        bridge_west_3 = @install() {
            debug_subtext("S=15");

            if((<ACTIVE>[FACE_DIRECTION] >= FACE_DIRECTION.SOUTH_EAST) && (<ACTIVE>[FACE_DIRECTION] <= FACE_DIRECTION.SOUTH_WEST)) {
                act2_lotus_bridge_1(0x26, ROOM.BRIDGE_WEST_3_COLLAPSED, 0d91, 0d132, 0d7, NONE);
            } else {
                act2_lotus_bridge_1(0x26, ROOM.BRIDGE_WEST_3_COLLAPSED, 0x55, 0x76, 0d7, NONE);
