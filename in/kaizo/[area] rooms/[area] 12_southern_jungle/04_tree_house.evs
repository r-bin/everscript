map tree_house(STRONGHEART) {
    // chests=vanilla
    
    enum entrance {
        door = entrance(0x12, 0x23, NORTH)
    }

    enum stepon_trigger {
        door = @install() {
            map_transition(flowers, crash, NONE);
        }
    }

    enum b_trigger {
        gourd_1__1_oil = @install() {
            debug_subtext("B=0");
            _loot_chest(0x00, OIL, 0d01);
        },
        gourd_2__1_wax = @install() {
            debug_subtext("B=1");
            _loot_chest(0x02, WAX, 0d01);
        },
        gourd_3__1_wax = @install() {
            debug_subtext("B=2");
            _loot_chest(0x01, WAX, 0d01);
        },
    }

    fun trigger_enter() {
        add_placeholder(ANIMATION_ENEMY.KING_ROCKING, 0d12, 0d22);
        attach_script(LAST_ENTITY, B, reference(@install() {
            smart_conversation({
                conversation_question("[SLOW]Do you like music?[CHOICE]yes…[CHOICE]no…");

                if(MEMORY.QUESTION_ANSWER == 0d0) { // yes
                    arg[0x0e] = randrange(0d2);

                    if(arg[0x0e] == 0d0) {
                        conversation_dialog("[SLOW]The first instruments were made of stone.[B]");
                    } else {
                        conversation_dialog("[SLOW]Using something blunt can reveal a beautiful melody.[B]");
                    }
                } else if(MEMORY.QUESTION_ANSWER == 0d1) { // no
                    teleporter_out();
                    map_transition(northern_jungle, teleporter, NONE);
                }
            }, False, NONE);
        }));

        default_init_room(True, False);
    }
};
