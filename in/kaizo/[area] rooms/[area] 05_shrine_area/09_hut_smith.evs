map hut_smith(VILLAGE_HUTS) {
    enum entrance {
        door = entrance(0x32, 0x23, NORTH),
    }

    enum soundtrack {
        default = soundtrack(AREA_SHRINE.DEFAULT_MUSIC, 0xff)
    }

    enum stepon_trigger {
        exit_door_3_3 = nop(),
        exit_door_3_2 = nop(),
        exit_door_3_1 = nop(),
        exit_door_2_3 = nop(),
        exit_door_2_2 = nop(),
        exit_door_2_1 = nop(),
        exit_door_1_3 = nop(),
        exit_door = @install() {
            map_transition(shrine, hut_7__smith, SOUTH);
        },
        exit_door_1_1 = nop(),
    }

    enum b_trigger {
        gourd_3_3_3 = nop(),
        gourd_3_3_2 = nop(),
        gourd_3_3_1 = nop(),
        gourd_3_2_4 = nop(),
        gourd_3_2_3 = nop(),
        gourd_3_2_1 = nop(),
        gourd_3_2_2 = nop(),
        gourd_3_1_2 = nop(),
        gourd_3_1_1 = nop(),
        gourd_2_3_2 = nop(),

        gourd_2_3_1 = nop(),
        gourd_2_2_3 = nop(),
        gourd_2_2_2 = nop(),
        gourd_2_2_1 = nop(),
        gourd_2_1_3 = nop(),
        gourd_2_1_2 = nop(),
        gourd_2_1_1 = nop(),
        gourd_1_3_3 = nop(),
        gourd_1_3_2 = nop(),
        gourd_1_3_1 = nop(),

        gourd_3__30_money = @install() {
            debug_subtext("B=20");
            _loot_chest(0x04, MONEY, 0d10);
        },
        gourd_2__1_water = @install() {
            debug_subtext("B=21");
            _loot_chest(0x03, WATER, 0d01);
        },
        gourd_1__4_water = @install() {
            debug_subtext("B=22");
            _loot_chest(0x02, IRON, 0d02);
        },
        gourd_1_1_2 = nop(),
        gourd_1_1_1 = nop(),
    }

    fun init_map(index) {
        if(index == 0x01) {
            init_map(0x00, 0x00, 0x20, 0x24); // hut_1_1
        } else if(index == 0x02) {
            init_map(0x22, 0x00, 0x42, 0x24); // hut_1_2
        } else if(index == 0x03) {
            init_map(0x44, 0x00, 0x64, 0x24); // hut_1_3
        } else if(index == 0x04) {
            init_map(0x00, 0x26, 0x20, 0x4a); // hut_2_1
        } else if(index == 0x05) {
            init_map(0x22, 0x26, 0x42, 0x4a); // hut_2_2
        } else if(index == 0x06) {
            init_map(0x44, 0x26, 0x64, 0x4a); // hut_2_3
        } else if(index == 0x07) {
            init_map(0x00, 0x4c, 0x20, 0x70); // hut_3_1
        } else if(index == 0x08) {
            init_map(0x22, 0x4c, 0x42, 0x70); // hut_3_2 ?
        } else if(index == 0x09) {
            init_map(0x44, 0x4c, 0x64, 0x70); // hut_3_3
        }
    }

    fun trigger_enter() {
        init_map(0x02);

        // object[0x02] = 0x01; // open gourd_1_2_1
        // object[0x03] = 0x01; // open gourd_1_2_2
        // object[0x04] = 0x01; // open gourd_1_2_3

        if(NPC_SMITH.PROGRESS >= 0d1) {
            add_souls_npc_smith(0d49, 0d18);
        }

        default_shrine_init_room();
    }
};
