    @install()
    fun bonfire_triggered_jungle() {
        guard_boy_damage();

        control(NONE);
        text_box(0x0a, 0d6); // text_start();
        text("[SLOW]Return to Southern Jungle?");
        if(SOULS_MEMORY.BONFIRE_INVERTED_PYRAMID || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
            text("[CHOICE]Inverted Pyramid…");
        } else {
            text("[CHOICE]…");
        }
        if(SOULS_MEMORY.BONFIRE_JUNGLE_PIT || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
            text("[CHOICE]Jungle Pit…");
        } else {
            text("[CHOICE]…");
        }
        if(SOULS_MEMORY.BONFIRE_BUG || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
            text("[CHOICE]Bug…");
        } else {
            text("[CHOICE]…");
        }
        if(SOULS_MEMORY.BONFIRE_DESERT || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
            text("[CHOICE]Desert…");
        } else {
            text("[CHOICE]…");
        }
        await_answer();
        text_end();
        control(BOTH);

        if(MEMORY.QUESTION_ANSWER == 0d0) {
            if(SOULS_MEMORY.BONFIRE_INVERTED_PYRAMID || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
                SOULS_MEMORY.BONFIRE_MAP = MAP.PYRAMID_1;
                map_transition(inverted_pyramid_level_0, bonfire, NONE);
            }
        } else if(MEMORY.QUESTION_ANSWER == 0d1) {
            if(SOULS_MEMORY.BONFIRE_JUNGLE_PIT || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
                SOULS_MEMORY.BONFIRE_MAP = MAP.FIREPIT_JUNGLE;
                map_transition(jungle_firepit, bonfire, NONE);
            }
        } else if(MEMORY.QUESTION_ANSWER == 0d2) {
            if(SOULS_MEMORY.BONFIRE_BUG || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
                SOULS_MEMORY.BONFIRE_MAP = MAP.VOLCANO_ROOMS;
                SOULS_MEMORY.BONFIRE_VARIANT = 0d2;
                map_transition(bugmuck_cave_1, bonfire, NONE);
            }
        } else if(MEMORY.QUESTION_ANSWER == 0d3) {
            if(SOULS_MEMORY.BONFIRE_DESERT || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
                SOULS_MEMORY.BONFIRE_MAP = MAP.HALLS_NE;
                SOULS_MEMORY.BONFIRE_VARIANT = 0d1;
                map_transition(desert_temple_main, bonfire, NONE);
            }
        }
    }
    @install()
    fun bonfire_triggered_altus() {
        guard_boy_damage();

        control(NONE);
        text_box(0x0a, 0d5); // text_start();
        text("[SLOW]Return to Altus Plateu?");
        if(SOULS_MEMORY.BONFIRE_ALTUS_WELL || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
            text("[CHOICE]Well…");
        } else {
            text("[CHOICE]…");
        }
        if(SOULS_MEMORY.BONFIRE_ALTUS_STAIRS || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
            text("[CHOICE]Stairs…");
        } else {
            text("[CHOICE]…");
        }
        if(SOULS_MEMORY.BONFIRE_ALTUS_CELLAR || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
            text("[CHOICE]Cellar…");
        } else {
            text("[CHOICE]…");
        }
        if(SOULS_MEMORY.BONFIRE_CASTLE_PIT || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
            text("[CHOICE]Castle Pit…");
        } else {
            text("[CHOICE]…");
        }
        await_answer();
        text_end();
        control(BOTH);

        if(MEMORY.QUESTION_ANSWER == 0d0) {
            if(SOULS_MEMORY.BONFIRE_ALTUS_WELL || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
                SOULS_MEMORY.BONFIRE_MAP = MAP.WELL;
                map_transition(well, bonfire, NONE);
            }
        } else if(MEMORY.QUESTION_ANSWER == 0d1) {
            if(SOULS_MEMORY.BONFIRE_ALTUS_STAIRS || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
                SOULS_MEMORY.BONFIRE_MAP = MAP.CHESSBOARD_STAIRS;
                map_transition(stairs, bonfire, NONE);
            }
        } else if(MEMORY.QUESTION_ANSWER == 0d2) {
            if(SOULS_MEMORY.BONFIRE_ALTUS_CELLAR || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
                SOULS_MEMORY.BONFIRE_MAP = MAP.EBON_CELLAR;
                SOULS_MEMORY.BONFIRE_VARIANT = 0d2;
                map_transition(inner_castle_cellar, bonfire, NONE);
            }
        } else if(MEMORY.QUESTION_ANSWER == 0d3) {
            if(SOULS_MEMORY.BONFIRE_CASTLE_PIT || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
                SOULS_MEMORY.BONFIRE_MAP = MAP.FIREPIT_NOBILIA;
                SOULS_MEMORY.BONFIRE_VARIANT = 0d0;
                map_transition(castle_fire_pit, bonfire, NONE);
            }
        }
    }

    fun bonfire_portal(x, y, flag, active, trigger) {
        if(flag || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
            if!(active) {
                add_enemy(LANTERN_LIGHT, x, y, INACTIVE);
            } else {
                add_enemy(LANTERN_LIGHT_RED, x, y, INACTIVE);
            }
            attach_script(LAST_ENTITY, DAMAGE, trigger);
            attribute(LAST_ENTITY, ROOT, True);
            <LAST_ENTITY>[HP] = SYSTEM.HP_MAX;
            // <LAST_ENTITY>[PALETTE] = 0x0000;
        }
    }

    @install()
    fun add_bonfire() {
        guard_false(ROOM.BONFIRES_ADDED);

        if!(FLAG.MAGIC_GOURD || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
            end();
        }

        ROOM.BONFIRES_ADDED = True;

        bonfire_portal(0d77, 0d92, SOULS_MEMORY.BONFIRE_INBETWIXX, (SOULS_MEMORY.BONFIRE_MAP == MAP.CROSSING), reference(bonfire_triggered_inbetwixx)); // inbetwixx

        bonfire_portal(0d77, 0d100, (SOULS_MEMORY.BONFIRE_EAST_CROSSING || SOULS_MEMORY.BONFIRE_PIPES), ((SOULS_MEMORY.BONFIRE_MAP == MAP.BLIMP_EXTERIOR) || (SOULS_MEMORY.BONFIRE_MAP == MAP.PIPEMAZE_ROOMS)), reference(bonfire_triggered_east)); // east inbetwixx

        bonfire_portal(0d69, 0d104, (SOULS_MEMORY.BONFIRE_TOWN_CENTER || SOULS_MEMORY.BONFIRE_TEMPLE_PIT), ((SOULS_MEMORY.BONFIRE_MAP == MAP.NOBILIA_SQUARE) || ((SOULS_MEMORY.BONFIRE_MAP == MAP.FIREPIT_NOBILIA) && (SOULS_MEMORY.BONFIRE_VARIANT == 0d1))), reference(bonfire_triggered_town)); // town

        bonfire_portal(0d61, 0d104, (SOULS_MEMORY.BONFIRE_ISAAC_DUNGEON || SOULS_MEMORY.BONFIRE_VOLCANO_TOWER), ((SOULS_MEMORY.BONFIRE_MAP == MAP.DARK_FOREST) || (SOULS_MEMORY.BONFIRE_MAP == MAP.STERLING)), reference(bonfire_triggered_west)); // west inbetwixx

        bonfire_portal(0d53, 0d100, (SOULS_MEMORY.BONFIRE_INVERTED_PYRAMID || SOULS_MEMORY.BONFIRE_JUNGLE_PIT || SOULS_MEMORY.BONFIRE_BUG || SOULS_MEMORY.BONFIRE_DESERT), ((SOULS_MEMORY.BONFIRE_MAP == MAP.PYRAMID_1) || (SOULS_MEMORY.BONFIRE_MAP == MAP.FIREPIT_JUNGLE) || (SOULS_MEMORY.BONFIRE_MAP == MAP.VOLCANO_ROOMS) || (SOULS_MEMORY.BONFIRE_MAP == MAP.HALLS_NE)), reference(bonfire_triggered_jungle)); // southern jungle

        bonfire_portal(0d51, 0d92, (SOULS_MEMORY.BONFIRE_ALTUS_WELL || SOULS_MEMORY.BONFIRE_ALTUS_STAIRS || SOULS_MEMORY.BONFIRE_ALTUS_CELLAR || SOULS_MEMORY.BONFIRE_CASTLE_PIT), ((SOULS_MEMORY.BONFIRE_MAP == MAP.WELL) || (SOULS_MEMORY.BONFIRE_MAP == MAP.CHESSBOARD_STAIRS) || ((SOULS_MEMORY.BONFIRE_MAP == MAP.EBON_CELLAR) && (SOULS_MEMORY.BONFIRE_VARIANT == 0d2)) || ((SOULS_MEMORY.BONFIRE_MAP == MAP.FIREPIT_NOBILIA) && (SOULS_MEMORY.BONFIRE_VARIANT == 0d0))), reference(bonfire_triggered_altus)); // altus plateau 

        // bonfire_portal(0d59, 0d88, …); // omnitopia
    }

    @install()
    fun locked_door() {
        subtext("Locked.");
    }

    enum stepon_trigger {
        exit_hut_1 = @install() {
            map_transition(hut_dog_lady, door, NORTH);
        },
        exit_hut_2 = @install() {
            map_transition(hut_2, door, NORTH);
        },
        exit_hut_3 = @install() {
            map_transition(hut_3__bee_boy, door, NORTH);
