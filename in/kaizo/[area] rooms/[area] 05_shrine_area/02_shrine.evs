map shrine(VILLAGE) {
    // sniff=vanilla

    enum entrance {
        north = entrance(0x59, 0x0d, SOUTH),
        east = entrance(0x7d, 0x65, WEST),
        south = entrance(0x59, 0x73, NORTH),
        west = entrance(0x01, 0x2f, EAST),

        hut_1__dog_lady = entrance(0x0f, 0x1b, SOUTH),
        hut_2 = entrance(0x33, 0x2d, SOUTH),
        hut_3__bee_boy = entrance(0x53, 0x2f, SOUTH),
        hut_4__crafter = entrance(0x65, 0x35, SOUTH),
        hut_5__pyromancer = entrance(0x6f, 0x49, SOUTH),
        hut_6__fire_eyes = entrance(0x45, 0x53, SOUTH),
        hut_7__smith = entrance(0x25, 0x5b, SOUTH),
        hut_8__cat = entrance(0x21, 0x3b, SOUTH),

        crash = entrance(0d75, 0d95, NONE, { crash_both(); }),

        critter_door = entrance(0d20, 0d61, SOUTH),
    }

    enum soundtrack {
        default = soundtrack(AREA_SHRINE.DEFAULT_MUSIC, 0xff)
    }

    enum ROOM {
        SHRINE_BONFIRE_LIT = memory(FLAG, SRAM),
        BONFIRES_ADDED = memory(FLAG, TEMP),

        SMITH_UNLOCKED = memory(FLAG, SRAM),

        TREASURE_LOOTED = memory(FLAG, SRAM),
    }

    @install()
    fun bonfire_triggered_first_bonfire() {
        guard_boy({
            fake_b();
        });
        animate_boy_kneel(BOY);

        if!(SOULS_MEMORY.BONFIRE_MAP) {
            question("[SLOW]Return to the beginning?[CHOICE]Yes.[CHOICE]No.");
            
            if(MEMORY.QUESTION_ANSWER == 0d0) {
                map_transition(inbetwixx, center, NONE);
            }
        } else {
            question("[SLOW]Return to bonfire?[CHOICE]Yes.[CHOICE]No.");

            if(MEMORY.QUESTION_ANSWER == 0d0) {
                return_to_bonfire();
                end();
            }
        }

        animate(BOY, ONCE, DEFAULT);
    }

    @install()
    fun bonfire_triggered_inbetwixx() {
        guard_boy_damage();
        
        text_start();
        text("[SLOW]Return to Inbetwixx?");
        if(SOULS_MEMORY.BONFIRE_INBETWIXX || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
            text("[CHOICE]Inbetwixx…");
        } else {
            text("[CHOICE]…");
        }
        await_answer();
        text_end();
        control(BOTH);

        if(MEMORY.QUESTION_ANSWER == 0d0) {
            if(SOULS_MEMORY.BONFIRE_INBETWIXX || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
                SOULS_MEMORY.BONFIRE_MAP = MAP.CROSSING;
                map_transition(inbetwixx, bonfire, NONE);
            }
        }
    }
    @install()
    fun bonfire_triggered_east() {
        guard_boy_damage();

        text_start();
        text("[SLOW]Return to East Inbetwixx?");
        if(SOULS_MEMORY.BONFIRE_EAST_CROSSING || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
            text("[CHOICE]Eastern Cave");
        } else {
            text("[CHOICE]…");
        }
        if(SOULS_MEMORY.BONFIRE_PIPES || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
            text("[CHOICE]Pipe maze");
        } else {
            text("[CHOICE]…");
        }
        await_answer();
        text_end();
        control(BOTH);

        if(MEMORY.QUESTION_ANSWER == 0d0) {
            if(SOULS_MEMORY.BONFIRE_EAST_CROSSING || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
                SOULS_MEMORY.BONFIRE_MAP = MAP.BLIMP_EXTERIOR;
                map_transition(east_crossing, bonfire, NONE);
            }
        } else if(MEMORY.QUESTION_ANSWER == 0d1) {
            if(SOULS_MEMORY.BONFIRE_PIPES || SOULS_MEMORY.CHEAT_ALL_BONFIRES) {
                SOULS_MEMORY.BONFIRE_MAP = MAP.PIPEMAZE_ROOMS;
                map_transition(pipe_entrance, bonfire, NONE);
            }
        }
    }
