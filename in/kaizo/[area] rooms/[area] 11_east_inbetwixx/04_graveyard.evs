    fun trigger_enter() {
        if(ROOM.PASSAGE_OPENED) {
            object[0x00] = 0x01;
        }

        if(ROOM.ENTERED_FROM_NORTH) {
            boss_triggered();
        }

        default_init_room(True, True);
    }
};
