            generic_act1_volcano_cave_hole(0x46, 0x31, 0d74, 0d56);
        },
        pressure_plate_3_1_left = @install() {
            debug_subtext("S=4");
            
            pressure_plate_3_1();
        },
        cave_2_1_hole_0_1 = @install() {
