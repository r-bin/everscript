map inner_castle_hallway(EBON_GLASS) {
    enum entrance {
        east = entrance(0x2d, 0x19, WEST),
        west = entrance(0x03, 0x19, EAST),

        crash = entrance(0d35, 0d24, NONE, { crash_both(); }),
    }

    enum soundtrack {
        default = soundtrack(AREA_INNER_CASTLE.DEFAULT_MUSIC, 0xff)
    }

    enum ROOM {
        PROGRESS = memory(FLAG, TEMP),
    }

    @install()
    @async()
    fun clean_up_rats() {
        find_all(RAT, {
            walk(current_id, TILE_ABSOLUTE_DIRECT, 0d50, 0d25, False, False);
        });

        sleep(0d2, S);

        find_all(RAT, {
            destroy(current_id);
        });
    }

    enum stepon_trigger {
        exit_east = @install() {
            debug_subtext("S=0");
        },
        exit_west = @install() {
            debug_subtext("S=1");

            if(SOULS_MEMORY.DEAD_RAT_BOY) {
                map_transition(hidden_castle_entry, east, WEST);
            } else if(!ROOM.PROGRESS) {
                ROOM.PROGRESS = True;

                object[0x04] = 0x01; // hide image_5

                clean_up_rats();

                ROOM.PROGRESS = True;

                push_music(BOSS_DRUMS);

                add_custom_boss_rat_boy(0d39, 0d25, False, {
                    ROOM.PROGRESS = False;
                    souls_boss_defeated_helper(RAT_BOY);
                }, False, 0d100);
            } else {
                fog_wall_inside(!SOULS_MEMORY.DEAD_RAT_BOY, EAST);
            }
        },
    }

    fun trigger_enter() {
        object[0x00] = 0x01; // hide image_1
        object[0x01] = 0x01; // hide image_2
        object[0x02] = 0x01; // hide image_3
        object[0x03] = 0x01; // hide image_4

        if(!SOULS_MEMORY.DEAD_RAT_BOY) {
            if(True) {
                // east
                add_enemy(RAT, 0d12, 0d24);

                // center
                add_enemy(RAT, 0d24, 0d24);

                // west
                add_enemy(RAT, 0d38, 0d27);
            }
        } else {
            object[0x04] = 0x01; // hide image_5
        }

        default_init_room(False, False);
    }
};
