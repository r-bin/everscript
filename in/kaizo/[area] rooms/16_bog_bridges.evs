map bog_bridges(SWAMP_BRIDGE) {
    enum entrance {
        north = entrance(0x0b, 0x01, SOUTH),
        south = entrance(0x1b, 0x53, NORTH)
    }

    enum soundtrack {
        default = soundtrack(WIND_AMBIENT_BIRDS, 0xff)
    }

    enum stepon_trigger {
        exit_north = @install() {
            map_transition(bog_curve, south, NORTH);
        },
        exit_south = @install() {
            map_transition(bog_crossing, north_short, SOUTH);
        }
    }

    fun trigger_enter() {
        if(SOULS_MEMORY.WITH_TRASH_ENEMIES) {
            // north
            add_basic_souls_enemy(FLOWER_PURPLE, 0d19, 0d12);

            add_basic_souls_enemy(FLOWER_PURPLE, 0d38, 0d13);

            // center
            add_basic_souls_enemy(FLOWER_PURPLE, 0d22, 0d36);

            add_basic_souls_enemy(TENTACLE_WHIP, 0d35, 0d27);
            add_basic_souls_enemy(RAT, 0d40, 0d34);

            // south
            add_basic_souls_enemy(FLOWER_PURPLE, 0d22, 0d71);
        }

        default_init_room(True, True);
    }
};
