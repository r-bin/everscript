map temple_switch2(HALLS_NW) { // south-west
    enum entrance {
        east = entrance(0x83, 0xa3, WEST),
    }

    enum soundtrack {
        default = soundtrack(AREA_TEMPLE.MUSIC, 0xff)
    }

    enum ROOM {
        GOURD_LOOTED = memory(FLAG, SRAM),
        WALL_COLLAPSED = memory(FLAG, SRAM),

        BRIDGE_WEST_TIME = 0d14, // 0d16,
        BRIDGE_WEST_ACTIVE = memory(FLAG, TEMP),
        BRIDGE_EAST_TIME = 0d150,
        BRIDGE_EAST_ACTIVE = memory(FLAG, TEMP),

        BRIDGE_CROSSED = memory(FLAG, TEMP),

        PIT_NORTH = 0d625,
        PIT_SOUTH = 0d780,

        BRIDGE_REVEALED = memory(FLAG, SRAM),

        SWITCH_ENTITY = memory(WORD, TEMP),
        SWITCH_ACTIVATED = AREA_TEMPLE.SWITCH_BRIDGE,

        MUD_STONE = memory(WORD, TEMP),
        MUD_STONE_DESTROYED = memory(FLAG, SRAM),

        PASSAGE_STONE = memory(WORD, TEMP),
        PASSAGE_OPENED = memory(FLAG, SRAM),
    }

    fun switch_activated() {
        if!(ROOM.SWITCH_ACTIVATED) {
            ROOM.SWITCH_ACTIVATED = True;
            AREA_TEMPLE.UNLOCKED_LEVEL_1 = True;

            generic_switch_floor(0x00, True);
        }
    }
    @install()
    @async()
    fun ground_switch_scanner(x, y) {
        souls_ground_switch_trigger(ROOM.SWITCH_ENTITY, x, y, {
            switch_activated();
        });
    }

    @install()
    fun pit_triggered() {
        guard_z();
        
        generic_fall(0d100, 0d800);

        if(ROOM.BRIDGE_CROSSED) {
            dust_unreachable(0d53, 0d71);
        } else {
            dust_unreachable(0d116, 0d164);
        }

        damage(BOTH, 0d999, True);
        sleep(0d30);
        damage(BOTH, SYSTEM.HP_MAX, False);
    }

    enum stepon_trigger {
        fall_ = pit_triggered(),
        fall_ = pit_triggered(),
        bridge_west_exit = @install() {
            debug_subtext("S=2");
        },
        fall_ = pit_triggered(),
        revealer_hint = @install() {
            debug_subtext("S=4");
        },
        fall_ = pit_triggered(),
        fall_ = pit_triggered(),
        fall_ = pit_triggered(),
        fall_ = pit_triggered(),
        fall_ = pit_triggered(),

        fall_ = pit_triggered(),
        fall_ = pit_triggered(),
        fall_ = pit_triggered(),
        fall_ = pit_triggered(),
        fall_ = pit_triggered(),
        bridge_east_exit = @install() {
            debug_subtext("S=15");
        },
        switch_floor = @install() {
            debug_subtext("S=16");

            guard_ground_switch(ROOM.SWITCH_ENTITY);
            switch_activated();
        },
        exit_east = @install() {
            debug_subtext("S=17");

            map_transition(temple, west_1, EAST);
        },
        fall_ = pit_triggered(),
        fall_ = pit_triggered(),

        fall_ = pit_triggered(),
        stepon_21 = @install() {
            debug_subtext("S=21");
        },
        stepon_22 = @install() {
            debug_subtext("S=22");
        },
        stepon_23 = @install() {
            debug_subtext("S=23");
        },
        stepon_24 = @install() {
            debug_subtext("S=24");
        },
        fall_ = pit_triggered(),
        fall_ = pit_triggered(),
        fall_ = pit_triggered(),
        fall_ = pit_triggered(),
    }

    enum b_trigger {
        gourd_hidden__pixie_dust = @install() {
            debug_subtext("B=0");
            
            _loot_chest(0x0e, {
                ROOM.GOURD_LOOTED = True;
                reward(CHEST_2_1, True);
            });
        },
        gourd_x__1_call_beads = @install() {
            debug_subtext("B=1");
            // _loot_chest(0x0f, CALL_BEADS, 0d01);
            _loot_chest(0x10, LIMESTONE_TABLET, 0d01);
        },
        gourd_x__3_brimstone = @install() {
            debug_subtext("B=2");
            // _loot_chest(0x10, BRIMSTONE, 0d03);
            _loot_chest(0x0f, IRON, 0d01);
        },
        gourd_x__2_ash = @install() {
            debug_subtext("B=3");
            // _loot_chest(0x11, ASH, 0d02);
            _loot_chest(0x11, DRY_ICE, 0d01);
        },
        destructable_wall = @install() {
            debug_subtext("B=4");

            guard_weapon(AXE_2, AXE);
            sleep(0d15);

            sound(THRAXX_BRIDGE_COLLAPSING);

            object[0x05] = 0x7e;
            ROOM.WALL_COLLAPSED = True;
        },
        bridge_switch_south = @install() {
            debug_subtext("B=5");

            fake_b();

            ROOM.BRIDGE_WEST_ACTIVE = True;
            object_animator(SWITCH_SPEAR_HALLS, False, 0x04, True, False);
            object_animator(BRIDGE_HALLS_NORTH_WEST, False, 0x03, True, False);

            sleep(ROOM.BRIDGE_WEST_TIME, S);

            object_animator(BRIDGE_HALLS_NORTH_WEST, False, 0x03, False, False);
            object_animator(SWITCH_SPEAR_HALLS, False, 0x04, False, False);
            ROOM.BRIDGE_WEST_ACTIVE = False;
        },
        bridge_switch_north = @install() {
            debug_subtext("B=6");

            fake_b();

            ROOM.BRIDGE_EAST_ACTIVE = True;
            object_animator(SWITCH_SPEAR_HALLS, False, 0x01, True, False);
            object_animator(BRIDGE_HALLS_NORTH_WEST, False, 0x02, True, False);

            sleep(ROOM.BRIDGE_EAST_TIME);

            object_animator(BRIDGE_HALLS_NORTH_WEST, False, 0x02, False, False);
            object_animator(SWITCH_SPEAR_HALLS, False, 0x01, False, False);
            ROOM.BRIDGE_EAST_ACTIVE = False;
        },
    }

    @install()
    @async()
    fun revealer_approached(entity) {
        range_checker(entity, <ACTIVE>, 0d45, 0d45, { pit_triggered(); });
    }

    fun trigger_enter() {
        // object[0x00] = 0x01; // activate switch_floor
        // object[0x01] = 0x01; // activate bridge_switch_north
        // object[0x02] = 0x7e; // activate bridge_east
        // object[0x03] = 0x7e; // activate bridge_west
        // object[0x04] = 0x01; // activate bridge_switch_south
        // object[0x05] = 0x7e; // collapse wall
        // object[0x06] = 0x7e; // show bridge_1
        // object[0x07] = 0x7e; // show bridge_2
        // object[0x08] = 0x7e; // show bridge_3
        // object[0x09] = 0x7e; // show bridge_4
        // object[0x0a] = 0x7e; // show bridge_5
        // sniff spots?
        // object[0x0e] = 0x01; // loot gourd_hidden
        // object[0x0f] = 0x01; // loot gourd_
        // object[0x10] = 0x01; // loot gourd_
        // object[0x11] = 0x01; // loot gourd_

        player_message(0d43, 0d161, reference(@install() {
            player_message_triggered();

            subtext("visions of fatty…");
        }));

        if!(ROOM.SWITCH_ACTIVATED) {
            ground_switch_scanner(0d66, 0d16);
        } else {
            object[0x00] = 0x01; // activate switch_floor
        }

        if(ROOM.BRIDGE_REVEALED) {
            object_animator(REVEALER, False, 0x06, 0d5, True);
        } else {
            add_enemy(REVEALER_TARGET_ENTITY, 0d102, 0d84);

            special_script(REVEALER, reference(@install() {
                guard_challenge_revealer();

                object_animator(REVEALER, False, 0x06, 0d5, False);

                destroy(SCRIPT_OWNER);

                ROOM.BRIDGE_REVEALED = True;
            }));

            revealer_approached(<LAST_ENTITY>);
        }

        if(ROOM.GOURD_LOOTED) {
            object[0x0e] = 0x01;
        }
        if(ROOM.WALL_COLLAPSED) {
            object[0x05] = 0x7e;
        }

        // switch east
        add_enemy(FLOWER_ORANGE, 0d105, 0d108);
        // add_enemy(FRIPPO, 0d85, 0d107, INACTIVE);
        // add_enemy(STONE, 0d97, 0d112);
        if!(ROOM.MUD_STONE_DESTROYED) {
            add_mud_stone(0d97, 0d112, reference(@install() {
                guard_mud_stone();

                ROOM.MUD_STONE_DESTROYED = True;
            }), FRIPPO);
            ROOM.MUD_STONE = <LAST_ENTITY>;
            add_frippo_switch(0d85, 0d107, reference(@install() {
                small_explosion(0d97, 0d112);

                if(alive(ROOM.MUD_STONE)) {
                    destroy(ROOM.MUD_STONE);
                    ROOM.MUD_STONE_DESTROYED = True;

                    wait(SCRIPT_OWNER);
                    destroy(SCRIPT_OWNER);
                }
            }));
        }

        // normal gourd
        add_enemy(FLOWER_ORANGE, 0d75, 0d134);

        if!(ROOM.PASSAGE_OPENED) {
            add_enemy(STONE_ROUND, 0d40, 0d161, INACTIVE_INVISIBLE);
            ROOM.PASSAGE_STONE = <LAST_ENTITY>;

            add_frippo_switch(0d74, 0d102, reference(@install() {
                small_explosion(0d40, 0d161);

                if(alive(ROOM.PASSAGE_STONE)) {
                    destroy(ROOM.PASSAGE_STONE);
                    ROOM.PASSAGE_OPENED = True;

                    wait(SCRIPT_OWNER);
                    destroy(SCRIPT_OWNER);
                }
            }));
        }

        if(SOULS_MEMORY.WITH_TRASH_ENEMIES) {
            // entrance
            add_basic_souls_enemy(MAGGOT, 0d99, 0d190);

            // switch east
            add_basic_souls_enemy(MAGGOT, 0d117, 0d126);

            // bridge west
            add_basic_souls_enemy(MAGGOT, 0d49, 0d106);


            // ground switch
            add_basic_souls_enemy(MAGGOT, 0d45, 0d45);

            // switch north
            add_basic_souls_enemy(MAGGOT, 0d88, 0d56);
        }

        default_init_room(False, False);

        while(True) {
            if(ROOM.BRIDGE_WEST_ACTIVE && (<ACTIVE>[Y] < ROOM.PIT_NORTH)) {
                ROOM.BRIDGE_WEST_ACTIVE = False;
                ROOM.BRIDGE_CROSSED = True;

                control(NONE);

                walk(ACTIVE, TILE_ABSOLUTE, 0d51, 0d74, NONE, NONE);
                walk(INACTIVE, TILE_ABSOLUTE, 0d51 + 0d4, 0d74, BOTH, BOTH);
            } else if(ROOM.BRIDGE_EAST_ACTIVE) {
                if(<ACTIVE>[Y] > ROOM.PIT_SOUTH) {
                    ROOM.BRIDGE_EAST_ACTIVE = False;
                    ROOM.BRIDGE_CROSSED = False;

                    control(NONE);

                    walk(ACTIVE, TILE_ABSOLUTE, 0d114, 0d100, NONE, NONE);
                    walk(INACTIVE, TILE_ABSOLUTE, 0d114 + 0d4, 0d100, BOTH, BOTH);
                } else if(<ACTIVE>[Y] > ROOM.PIT_NORTH) {
                    if(((<ACTIVE>[CURRENT_GROUND] & 0xff) == 0x1f) || ((<ACTIVE>[CURRENT_GROUND] & 0xff) == 0x5f)) {
                        pit_triggered();
                        end();
                    }
                }
            }

            yield();
        }
    }
};
