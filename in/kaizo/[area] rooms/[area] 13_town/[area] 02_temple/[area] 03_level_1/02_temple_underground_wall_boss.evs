map temple_underground_wall_boss(HALLS_BRIDGE) { // north-west + north_east
    enum entrance {
        test = entrance(0x21, 0x95, NORTH),
        
        fake_lift = entrance(0d78, 0d68, NONE, { crash_both(); }),
    }

    enum soundtrack {
        default = soundtrack(AREA_TEMPLE.MUSIC, 0xff)
    }

    enum ROOM {
        DEBUG = False,
        DEBUG_STONE_POSITION = False,

        BRIDGE_1 = memory(WORD, TEMP), // trap 1
        BRIDGE_2 = memory(WORD, TEMP),
        BRIDGE_3 = memory(WORD, TEMP),
        BRIDGE_4 = memory(WORD, TEMP), // always 1
        BRIDGE_5 = memory(WORD, TEMP),
        BRIDGE_6 = memory(WORD, TEMP),
        BRIDGE_7 = memory(WORD, TEMP),
        BRIDGE_8 = memory(WORD, TEMP),
        BRIDGE_9 = memory(WORD, TEMP),
        BRIDGE_10 = memory(WORD, TEMP), // trap 2
        BRIDGE_11 = memory(WORD, TEMP),
        BRIDGE_12 = memory(WORD, TEMP), // always 2
        BRIDGE_13 = memory(WORD, TEMP),
        BRIDGE_14 = memory(WORD, TEMP),
        BRIDGE_15 = memory(WORD, TEMP),

        TRAP_1_TRIGGERED = memory(FLAG, TEMP),
        TRAP_2_TRIGGERED = memory(FLAG, TEMP),
    }

    fun lift_east_switch_triggered() {
        object_animator(SWITCH_SPEAR_HALLS, False, 0x04, True, False);
        object_animator(GATE_HALLS, False, 0x03, True, False);
    }
    fun lift_east_triggered() {
        control(NONE);

        walk(INACTIVE, COORDINATE_ABSOLUTE_DIRECT, <ACTIVE>[X], <ACTIVE>[Y], INACTIVE, NONE);

        face(ACTIVE, SOUTH);
        face(INACTIVE, SOUTH);

        object_animator(GATE_HALLS, False, 0x03, False, False);
        sleep(0d10);
    }

    group brigde_helper() {
        @install()
        fun levitate_triggered() {
            guard_challenge_revealer();

            if(ROOM.DEBUG) {
                debug_memory(<SCRIPT_OWNER>, alive(<SCRIPT_OWNER>), <SCRIPT_OWNER>[GENERAL_PURPOSE]);
            }

            teleport(SCRIPT_OWNER, 0d0, 0d0);

            object[<SCRIPT_OWNER>[GENERAL_PURPOSE]] = 0x00;

            destroy(SCRIPT_OWNER);
        }

        @install()
        fun _bridge_triggered(segment_memory) {
            if(ROOM.DEBUG) {
                debug_memory(segment_memory, _alive(segment_memory), segment_memory[GENERAL_PURPOSE]);
            }

            generic_fall(0d50, 0d1100);

            dust_unreachable(0d39, 0d129);
            damage(BOTH, 0d999, True);
            sleep(0d30);
            damage(BOTH, SYSTEM.HP_MAX, False);
        }
        fun bridge_triggered(segment_memory) {
            if(segment_memory != 0x0000) {
                if(_alive(segment_memory) && (segment_memory[Z] == 0d0)) {
                    _bridge_triggered(segment_memory);
                }
            }
        }

        fun _break_bridge(memory_entity, object_id, x) {
            if(ROOM.DEBUG && ROOM.DEBUG_STONE_POSITION) {
                add_enemy(STONE, x, 0d138, STONE_LEVITATE);
            } else {
                add_enemy(STONE, x, 0d138, STONE_LEVITATE_INVISIBLE); // bridge_3, trigger=17
            }
            <LAST_ENTITY>[GENERAL_PURPOSE] = object_id;
            memory_entity = <LAST_ENTITY>;

            object[object_id] = 0x7e;
        }
        @install()
        fun break_bridge(index) {
            if(index == 0d1) {
                _break_bridge(ROOM.BRIDGE_1, 0x11, 0d46);
            } else if(index == 0d2) {
                _break_bridge(ROOM.BRIDGE_2, 0x12, 0d50);
            } else if(index == 0d3) {
                _break_bridge(ROOM.BRIDGE_3, 0x13, 0d54);
            } else if(index == 0d4) {
                _break_bridge(ROOM.BRIDGE_4, 0x14, 0d58);
            } else if(index == 0d5) {
                _break_bridge(ROOM.BRIDGE_5, 0x15, 0d62);
            } else if(index == 0d6) {
                _break_bridge(ROOM.BRIDGE_6, 0x16, 0d66);
            } else if(index == 0d7) {
                _break_bridge(ROOM.BRIDGE_7, 0x17, 0d70);
            } else if(index == 0d8) {
                _break_bridge(ROOM.BRIDGE_8, 0x18, 0d74);
            } else if(index == 0d9) {
                _break_bridge(ROOM.BRIDGE_9, 0x19, 0d78);
            } else if(index == 0d10) {
                _break_bridge(ROOM.BRIDGE_10, 0x1a, 0d82);
            } else if(index == 0d11) {
                _break_bridge(ROOM.BRIDGE_11, 0x1b, 0d86);
            } else if(index == 0d12) {
                _break_bridge(ROOM.BRIDGE_12, 0x1c, 0d90);
            } else if(index == 0d13) {
                _break_bridge(ROOM.BRIDGE_13, 0x1d, 0d94);
            } else if(index == 0d14) {
                _break_bridge(ROOM.BRIDGE_14, 0x1e, 0d98);
            } else if(index == 0d15) {
                _break_bridge(ROOM.BRIDGE_15, 0x1f, 0d102);
            }
        }
    };

    enum BOSS {
        DEBUG = False,

        ID = memory(WORD, TEMP),
        BARRIER_1_ID = memory(WORD, TEMP),
        BARRIER_2_ID = memory(WORD, TEMP),

        HIT_WINDOW = 0d220,

        STEP_SIZE = 0d60,

        THRESHOLD_STEP_NORMAL = 0d15,
        THRESHOLD_STEP_BIG = 0d25,

        BARRAGE_COOLDOWN = 0d1,
        BARRAGE_REPEAT = 0d2,
        BARRAGE_LEVEL = 0d1, // unused
        BARRAGE_SHOT_COOLDOWN = 0d60,
        BARRAGE_SHOT_PAUSE = 0d20 + randrange(0d10),
    }

    fun update_camera_limit(x) {
        if(False) {
            _init_map(0d0, 0d0, x, 0d164 << 0d0003);
        } else {
            MEMORY.CAMERA_BOUNDRY_X_END = x + 0d5;
        }
    }

    @install()
    fun boss_defeated() {
        destroy(BOSS.BARRIER_1_ID);
        destroy(BOSS.BARRIER_2_ID);

        if(alive(BOSS.ID)) {
            destroy(BOSS.ID);
        }

        souls_boss_defeated_helper(WALL);

        update_camera_limit(0xfff);
    }

    fun set_bridge(index, entity) {
        if(index == 0d1) {
            ROOM.BRIDGE_1 = entity;
        } else if(index == 0d2) {
            ROOM.BRIDGE_2 = entity;
        } else if(index == 0d3) {
            ROOM.BRIDGE_3 = entity;
        } else if(index == 0d4) {
            ROOM.BRIDGE_4 = entity;
        } else if(index == 0d5) {
            ROOM.BRIDGE_5 = entity;
        } else if(index == 0d6) {
            ROOM.BRIDGE_6 = entity;
        } else if(index == 0d7) {
            ROOM.BRIDGE_7 = entity;
        } else if(index == 0d8) {
            ROOM.BRIDGE_8 = entity;
        } else if(index == 0d9) {
            ROOM.BRIDGE_9 = entity;
        } else if(index == 0d10) {
            ROOM.BRIDGE_10 = entity;
        } else if(index == 0d11) {
            ROOM.BRIDGE_11 = entity;
        } else if(index == 0d12) {
            ROOM.BRIDGE_12 = entity;
        } else if(index == 0d13) {
            ROOM.BRIDGE_13 = entity;
        } else if(index == 0d14) {
            ROOM.BRIDGE_14 = entity;
        } else if(index == 0d15) {
            ROOM.BRIDGE_15 = entity;
        }
    }
    fun get_bridge(index, entity) {
        if(index == 0d1) {
            entity = ROOM.BRIDGE_1;
        } else if(index == 0d2) {
            entity = ROOM.BRIDGE_2;
        } else if(index == 0d3) {
            entity = ROOM.BRIDGE_3;
        } else if(index == 0d4) {
            entity = ROOM.BRIDGE_4;
        } else if(index == 0d5) {
            entity = ROOM.BRIDGE_5;
        } else if(index == 0d6) {
            entity = ROOM.BRIDGE_6;
        } else if(index == 0d7) {
            entity = ROOM.BRIDGE_7;
        } else if(index == 0d8) {
            entity = ROOM.BRIDGE_8;
        } else if(index == 0d9) {
            entity = ROOM.BRIDGE_9;
        } else if(index == 0d10) {
            entity = ROOM.BRIDGE_10;
        } else if(index == 0d11) {
            entity = ROOM.BRIDGE_11;
        } else if(index == 0d12) {
            entity = ROOM.BRIDGE_12;
        } else if(index == 0d13) {
            entity = ROOM.BRIDGE_13;
        } else if(index == 0d14) {
            entity = ROOM.BRIDGE_14;
        } else if(index == 0d15) {
            entity = ROOM.BRIDGE_15;
        }
    }

    @install()
    fun collapse_bridge(index) {
        if(False) {
            get_bridge(index, arg[0x10]);

            if(arg[0x10] != 0x0000 && _alive(arg[0x10])) {
                debug_memory(arg[0x10], _alive(arg[0x10]));

                end();
            }
        }

        arg[0x10] = 0d42 + index * 0d4;

        add_enemy(STONE, arg[0x10], 0d138);
        arg[0x12] = <LAST_ENTITY>[X];
        arg[0x14] = <LAST_ENTITY>[Y];
        _teleport(LAST_ENTITY, <LAST_ENTITY>[X], <ACTIVE>[Y]);

        attribute(LAST_ENTITY, INVINCIBLE_TEMP, True);
        attach_to_script(LAST_ENTITY);

        set_bridge(index, <LAST_ENTITY>);

        generic_crash_through(<SCRIPT_OWNER>, 0d2000, arg[0x14] - <LAST_ENTITY>[Y], 0d1100, {
            break_bridge(arg[0x00]);
        });

        if(False) { // TODO: reuse stone
            attribute(SCRIPT_OWNER, INVINCIBLE_TEMP, False);
        } else {
            destroy(SCRIPT_OWNER);
        }
    }

