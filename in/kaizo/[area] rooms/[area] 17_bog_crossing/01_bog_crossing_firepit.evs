map bog_crossing_firepit(FIREPIT_BEACH) { // unused
    enum entrance {
        west = entrance(0x03, 0x1f, EAST),
    }

    enum stepon_trigger {
        exit_east = @install() {
            map_transition(bog_crossing, east, WEST);
        },
        windwalker = @install() {
            debug_subtext("S=1");
        },
    }

    fun trigger_enter() {
        default_init_room(False, False);
    }
};
