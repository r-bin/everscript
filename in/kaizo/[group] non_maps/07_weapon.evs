group weapon() {
    @install(WEAPON_DATA.POINTER + WEAPON_DATA.SIZE * (WEAPON_INDEX.SWORD_1 / 0d02 - 0d01), False)
    fun sword_1_attack() {
        code(0d0010 + 0d2, "// sword 1 / bone crusher attack"); // compensates for fixed silver sheath
    }
    @install(WEAPON_DATA.POINTER + WEAPON_DATA.SIZE * (WEAPON_INDEX.SWORD_2 / 0d02 - 0d01), False)
    fun sword_2_attack() {
        code(0d0015, "// sword 2 attack");
    }
