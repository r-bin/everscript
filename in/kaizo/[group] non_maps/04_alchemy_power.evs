group alchemy_power() {
    // metroidvania
    @install(ALCHEMY_POWER.POINTER + ALCHEMY_POWER.SIZE * (ALCHEMY_INDEX.ATLAS / 0d02), False)
    fun alchemy_power_drain() {
        code(0d0005, "// atlas power (0x19)");
    }
    // @install(ALCHEMY_DURATION.POINTER_ATLAS, False)
    // fun alchemy_atlas_drain() {
    //     code(0d0300, "// atlas duration (0x1518)");
    // }

    // damage
    @install(ALCHEMY_POWER.POINTER + ALCHEMY_POWER.SIZE * (ALCHEMY_INDEX.DRAIN / 0d02), False)
    fun alchemy_power_drain() {
        code(0d0008, "// drain power (0x12)");
    }
};
