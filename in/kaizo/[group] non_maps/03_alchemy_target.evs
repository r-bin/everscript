group alchemy_target() {
    @install(ALCHEMY_TARGET.POINTER + ALCHEMY_TARGET.SIZE * (ALCHEMY_INDEX.HEAL / 0d02), False)
    fun alchemy_target_heal() {
        code(ALCHEMY_TARGET.ENEMY_ALL, "// heal (enemy or all enemies)");
    }
    @install(ALCHEMY_TARGET.POINTER + ALCHEMY_TARGET.SIZE * (ALCHEMY_INDEX.MIRACLE_CURE / 0d02), False)
    fun alchemy_target_miracle_cure() {
        code(ALCHEMY_TARGET.ENEMY_ALL, "// miracle cure (enemy or all enemies)");
    }

    // @install(ALCHEMY_TARGET.POINTER + ALCHEMY_TARGET.SIZE * (ALCHEMY_INDEX.CRUSH / 0d02))
    // fun alchemy_target_crush() {
    //     code(ALCHEMY_TARGET.ENEMY_ALL, "// crush (single enemy)");
    // }
};
