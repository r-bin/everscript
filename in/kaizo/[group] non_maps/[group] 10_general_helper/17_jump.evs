group jump() {
    fun jump_hole(callback, no_animation) {
        if(no_animation is None) {
            animate_boy_kneel(BOY);
        }

        question("[SLOW]Jump into the hole?[LF](No way back in sight…)[CHOICE]yes…[CHOICE]no…");
        if(MEMORY.QUESTION_ANSWER == 0d0) {
            if(no_animation is None) {
                animation_fall_pit(ACTIVE);
            }

            callback();
        } else {
            if(no_animation is None) {
                animate(BOY, ONCE, DEFAULT);
            }
        }
    }
};
