group shared() {
    fun _cheat_menu_challenge(unlock) {
        SOULS_MEMORY.CHALLENGE_NO_DOG = unlock;
        SOULS_MEMORY.CHALLENGE_NO_REVEALER = unlock;
        SOULS_MEMORY.CHALLENGE_NO_LEVITATE = unlock;
        SOULS_MEMORY.CHALLENGE_EXTRA_WEAK = unlock;
        SOULS_MEMORY.CHALLENGE_NO_MAGIC_GOURD = unlock;
    }
    @install()
    fun cheat_menu_challenge(lock_all, unlock_all) {
        if(lock_all) {
            _cheat_menu_challenge(False);
            end();
        } else if(unlock_all) {
            _cheat_menu_challenge(True);
            end();
        }
    
        MEMORY.QUESTION_ANSWER = 0d0;
        while(MEMORY.QUESTION_ANSWER != 0xffff) {
            init_cheat_page();
    
            font(OUTRO);
            text("Challenges");
    
            font(DEFAULT);
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.CHALLENGE_NO_DOG;
            text("[CHOICE][MEM1] - No Dog - [MEM1]");
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.CHALLENGE_NO_REVEALER;
            text("[CHOICE][MEM1] - No Revealer - [MEM1]");
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.CHALLENGE_NO_LEVITATE;
            text("[CHOICE][MEM1] - No Levitate - [MEM1]");
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.CHALLENGE_EXTRA_WEAK;
            text("[CHOICE][MEM1] - Extra Weak - [MEM1]");
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.CHALLENGE_NO_MAGIC_GOURD;
            text("[CHOICE][MEM1] - No Magic Gourd - [MEM1]");
    
            await_answer(MEMORY.QUESTION_ANSWER);
    
            if(MEMORY.QUESTION_ANSWER == 0d0) { // no dog
                SOULS_MEMORY.CHALLENGE_NO_DOG = !SOULS_MEMORY.CHALLENGE_NO_DOG;
            } else if(MEMORY.QUESTION_ANSWER == 0d1) { // no revealer
                SOULS_MEMORY.CHALLENGE_NO_REVEALER = !SOULS_MEMORY.CHALLENGE_NO_REVEALER;
            } else if(MEMORY.QUESTION_ANSWER == 0d2) { // no levitate
                SOULS_MEMORY.CHALLENGE_NO_LEVITATE = !SOULS_MEMORY.CHALLENGE_NO_LEVITATE;
            } else if(MEMORY.QUESTION_ANSWER == 0d3) { // extra weak
                SOULS_MEMORY.CHALLENGE_EXTRA_WEAK = !SOULS_MEMORY.CHALLENGE_EXTRA_WEAK;
            } else if(MEMORY.QUESTION_ANSWER == 0d4) { // no magic gourd
                SOULS_MEMORY.CHALLENGE_NO_MAGIC_GOURD = !SOULS_MEMORY.CHALLENGE_NO_MAGIC_GOURD;
            }
    
            text_end();
            control(BOTH);
        }
    }
    
    fun _cheat_menu_cheat(unlock) {
        SOULS_MEMORY.CHEAT_SAVE_MENU = unlock;
        SOULS_MEMORY.CHEAT_ALL_BONFIRES = unlock;
        SOULS_MEMORY.CHEAT_PERMANENT_MARKET = unlock;
    }
    @install()
    fun cheat_menu_cheat(lock_all, unlock_all) {
        if(lock_all) {
            _cheat_menu_cheat(False);
            end();
        } else if(unlock_all) {
            _cheat_menu_cheat(True);
            end();
        }
    
        MEMORY.QUESTION_ANSWER = 0d0;
        while(MEMORY.QUESTION_ANSWER != 0xffff) {
            init_cheat_page();
    
            font(OUTRO);
            text("Cheats");
    
            font(DEFAULT);
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.CHEAT_SAVE_MENU;
            text("[CHOICE][MEM1] - Save Menu - [MEM1]");
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.CHEAT_ALL_BONFIRES;
            text("[CHOICE][MEM1] - All Bonfires - [MEM1]");
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.CHEAT_PERMANENT_MARKET;
            text("[CHOICE][MEM1] - Permanent Market - [MEM1]");
    
            await_answer(MEMORY.QUESTION_ANSWER);
    
            if(MEMORY.QUESTION_ANSWER == 0d0) { // save menu
                SOULS_MEMORY.CHEAT_SAVE_MENU = !SOULS_MEMORY.CHEAT_SAVE_MENU;
            } else if(MEMORY.QUESTION_ANSWER == 0d1) { // all bonfires
                SOULS_MEMORY.CHEAT_ALL_BONFIRES = !SOULS_MEMORY.CHEAT_ALL_BONFIRES;
            } else if(MEMORY.QUESTION_ANSWER == 0d2) { // permanent market
                SOULS_MEMORY.CHEAT_PERMANENT_MARKET = !SOULS_MEMORY.CHEAT_PERMANENT_MARKET;
            }
    
            text_end();
            control(BOTH);
        }
    }
    
    fun _cheat_menu_debug(unlock) {
        SOULS_MEMORY.DEBUG_LOADOUT = unlock;
        SOULS_MEMORY.DEBUG_FULL_LOADOUT = unlock;
        SOULS_MEMORY.DEBUG_ENTITIES = unlock;
        SOULS_MEMORY.DEBUG_HOTKEYS = unlock;
    }
    @install()
    fun cheat_menu_debug(lock_all, unlock_all) {
        if(lock_all) {
            _cheat_menu_debug(False);
            end();
        } else if(unlock_all) {
            _cheat_menu_debug(True);
            end();
        }
        
        MEMORY.QUESTION_ANSWER = 0d0;
        while(MEMORY.QUESTION_ANSWER != 0xffff) {
            init_cheat_page();
    
            font(OUTRO);
            text("Debug");
    
            font(DEFAULT);
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.DEBUG_LOADOUT;
            text("[CHOICE][MEM1] - Debug Loadout - [MEM1]");
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.DEBUG_FULL_LOADOUT;
            text("[CHOICE][MEM1] - Debug Full Loadout - [MEM1]");
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.DEBUG_ENTITIES;
            text("[CHOICE][MEM1] - Debug Entities - [MEM1]");
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.DEBUG_HOTKEYS;
            text("[CHOICE][MEM1] - Debug Hotkeys - [MEM1]");
    
            await_answer(MEMORY.QUESTION_ANSWER);
    
            if(MEMORY.QUESTION_ANSWER == 0d0) { // debug loadout
                SOULS_MEMORY.DEBUG_LOADOUT = !SOULS_MEMORY.DEBUG_LOADOUT;
            } else if(MEMORY.QUESTION_ANSWER == 0d1) { // debug full loadout
                SOULS_MEMORY.DEBUG_FULL_LOADOUT = !SOULS_MEMORY.DEBUG_FULL_LOADOUT;
            } else if(MEMORY.QUESTION_ANSWER == 0d2) { // debug entities
                SOULS_MEMORY.DEBUG_ENTITIES = !SOULS_MEMORY.DEBUG_ENTITIES;
            } else if(MEMORY.QUESTION_ANSWER == 0d3) { // debug hotkeys
                SOULS_MEMORY.DEBUG_HOTKEYS = !SOULS_MEMORY.DEBUG_HOTKEYS;
            }
    
            text_end();
            control(BOTH);
        }
    }
    
    @install()
    fun cheat_menu() {
        control(NONE);
        hide_non_dialog_layers();
        _fade_in();
    
        MEMORY.QUESTION_ANSWER = 0d0;
        while(MEMORY.QUESTION_ANSWER != 0xffff) {
            init_cheat_page();
    
            font(OUTRO);
            text("Debug Menu:");
    
            font(DEFAULT);
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY_HELPER.SUM_SETTINGS;
            text("[CHOICE][MEM1] - [Settings] - [MEM1]");
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY_HELPER.SUM_WEAPONS;
            text("[CHOICE][MEM1] - [Cheat in Weapons] - [MEM1]");
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY_HELPER.SUM_ARMOR_HELM + SOULS_MEMORY_HELPER.SUM_ARMOR_CHEST + SOULS_MEMORY_HELPER.SUM_ARMOR_GLOVE + SOULS_MEMORY_HELPER.SUM_ARMOR_COLLAR;
            text("[CHOICE][MEM1] - [Cheat in Armor] - [MEM1]");
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY_HELPER.SUM_START_ABILITIES;
            text("[CHOICE][MEM1] - [Start Ability] - [MEM1]");
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY_HELPER.SUM_FORMS;
            text("[CHOICE][MEM1] - [Morph Forms] - [MEM1]");
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY_HELPER.SUM_CHALLENGES;
            text("[CHOICE][MEM1] - [Challenge] - [MEM1]");
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY_HELPER.SUM_CHEATS;
            text("[CHOICE][MEM1] - [Cheats] - [MEM1]");
            if(SOULS_MEMORY.DEBUG) {
                MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY_HELPER.SUM_DEBUG_FEATURES;
                text("[CHOICE][MEM1] - [Debug] - [MEM1]");
            }
    
            await_answer(MEMORY.QUESTION_ANSWER);
            arg[0x10] = MEMORY.QUESTION_ANSWER;
    
            text_end();
    
            if(MEMORY.QUESTION_ANSWER == 0d0) { // settings
                cheat_menu_settings(CHEAT_MENU.MODIFIER_LOCK, CHEAT_MENU.MODIFIER_UNLOCK);
            } else if(MEMORY.QUESTION_ANSWER == 0d1) { // cheat in weapon
                cheat_menu_weapon(CHEAT_MENU.MODIFIER_LOCK, CHEAT_MENU.MODIFIER_UNLOCK);
            } else if(MEMORY.QUESTION_ANSWER == 0d2) { // cheat in armor
                cheat_menu_armor_useful(CHEAT_MENU.MODIFIER_LOCK, CHEAT_MENU.MODIFIER_UNLOCK);
            } else if(MEMORY.QUESTION_ANSWER == 0d3) { // start ability
                cheat_menu_start_ability(CHEAT_MENU.MODIFIER_LOCK, CHEAT_MENU.MODIFIER_UNLOCK);
            } else if(MEMORY.QUESTION_ANSWER == 0d4) { // forms
                cheat_menu_forms(CHEAT_MENU.MODIFIER_LOCK, CHEAT_MENU.MODIFIER_UNLOCK);
            } else if(MEMORY.QUESTION_ANSWER == 0d5) { // challange
                cheat_menu_challenge(CHEAT_MENU.MODIFIER_LOCK, CHEAT_MENU.MODIFIER_UNLOCK);
            } else if(MEMORY.QUESTION_ANSWER == 0d6) { // cheats
                cheat_menu_cheat(CHEAT_MENU.MODIFIER_LOCK, CHEAT_MENU.MODIFIER_UNLOCK);
            } else if(MEMORY.QUESTION_ANSWER == 0d7) { // debug
                cheat_menu_debug(CHEAT_MENU.MODIFIER_LOCK, CHEAT_MENU.MODIFIER_UNLOCK);
            } else {
                arg[0x12] = True;
            }
            MEMORY.QUESTION_ANSWER = arg[0x10];
        }
    }
    
    @install()
    fun souls_handle_cheat_menu() {
        control(NONE);
    
        if((MEMORY.INPUT_P1 & INPUT.START) == INPUT.START) {
            hide_non_dialog_layers();
            _fade_in();
    
            cheat_menu_settings(False, False);
        } else {
            handle_cheat_menu(SOULS_MEMORY.DEBUG, {
                cheat_menu();
            });
        }
    
        reset_timer();
    }
};
