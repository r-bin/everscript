group cheat_menu__inventory() {
    fun _cheat_menu_armor_useful(unlock) {
        MEMORY.HELM_1_1 = unlock; // mushroom helm
        MEMORY.CHEST_1_1 = unlock; // mushroom chest
        MEMORY.GLOVE_1_1 = unlock; // mushroom glove
        MEMORY.CHEST_2_3 = unlock; // red tunic
        MEMORY.GLOVE_2_3 = unlock; // power gloves
        MEMORY.GLOVE_2_2 = unlock; // golden power gloves
        MEMORY.GLOVE_3_2 = unlock; // cat ring
        MEMORY.GLOVE_1_3 = unlock; // thorne guard
        MEMORY.CHEST_2_2 = unlock; // stone vest
        MEMORY.GLOVE_4_2 = unlock; // pip boy
        MEMORY.HELM_4_3 = unlock; // scanner
    }
    @install()
    fun cheat_menu_armor_useful(lock_all, unlock_all) {
        if(lock_all) {
            _cheat_menu_armor_useful(False);
            end();
        } else if(unlock_all) {
            _cheat_menu_armor_useful(True);
            end();
        }

        MEMORY.QUESTION_ANSWER = 0d0;
        while(MEMORY.QUESTION_ANSWER != 0xffff) {
            init_cheat_page();

            font(OUTRO);
            text("Useful Armor");

            font(DEFAULT);
            MEMORY.STRING_PARAMETER_1 = MEMORY.HELM_1_1;
            text("[CHOICE][MEM1] - Mushroom Helm - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = MEMORY.CHEST_1_1;
            text("[CHOICE][MEM1] - Mushroom Chest - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = MEMORY.GLOVE_1_1;
            text("[CHOICE][MEM1] - Mushroom Glove - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = MEMORY.CHEST_2_3;
            text("[CHOICE][MEM1] - Red Tunic - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = MEMORY.GLOVE_2_3;
            text("[CHOICE][MEM1] - Power Gloves - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = MEMORY.GLOVE_2_2;
            text("[CHOICE][MEM1] - Titan's Mitt - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = MEMORY.GLOVE_3_2;
            text("[CHOICE][MEM1] - Cat Ring - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = MEMORY.GLOVE_1_3;
            text("[CHOICE][MEM1] - Thorne Guards - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = MEMORY.CHEST_2_2;
            text("[CHOICE][MEM1] - Stone Vest - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = MEMORY.GLOVE_4_2;
            text("[CHOICE][MEM1] - PIP Boy - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = MEMORY.HELM_4_3;
            text("[CHOICE][MEM1] - Scanner - [MEM1]");

            await_answer(MEMORY.QUESTION_ANSWER);

            if(MEMORY.QUESTION_ANSWER == 0d0) { // mushroom helm
                MEMORY.HELM_1_1 = !MEMORY.HELM_1_1;
            } else if(MEMORY.QUESTION_ANSWER == 0d1) { // mushroom chest
                MEMORY.CHEST_1_1 = !MEMORY.CHEST_1_1;
            } else if(MEMORY.QUESTION_ANSWER == 0d2) { // mushroom glove
                MEMORY.GLOVE_1_1 = !MEMORY.GLOVE_1_1;
            } else if(MEMORY.QUESTION_ANSWER == 0d3) { // red tunic
                MEMORY.CHEST_2_3 = !MEMORY.CHEST_2_3;
            } else if(MEMORY.QUESTION_ANSWER == 0d4) { // power gloves
                MEMORY.GLOVE_2_3 = !MEMORY.GLOVE_2_3;
            } else if(MEMORY.QUESTION_ANSWER == 0d5) { // golden power gloves
                MEMORY.GLOVE_2_2 = !MEMORY.GLOVE_2_2;
            } else if(MEMORY.QUESTION_ANSWER == 0d6) { // cat ring
                MEMORY.GLOVE_3_2 = !MEMORY.GLOVE_3_2;
            } else if(MEMORY.QUESTION_ANSWER == 0d7) { // thorne guard
                MEMORY.GLOVE_1_3 = !MEMORY.GLOVE_1_3;
            } else if(MEMORY.QUESTION_ANSWER == 0d8) { // stone vest
                MEMORY.CHEST_2_2 = !MEMORY.CHEST_2_2;
            } else if(MEMORY.QUESTION_ANSWER == 0d9) { // pip boy
                MEMORY.GLOVE_4_2 = !MEMORY.GLOVE_4_2;
            } else if(MEMORY.QUESTION_ANSWER == 0d10) { // scanner
                MEMORY.HELM_4_3 = !MEMORY.HELM_4_3;
            }

            text_end();
            control(BOTH);
        }
    }

    fun _cheat_menu_start_ability(unlock) {
        SOULS_MEMORY.BOMB_ENABLED = unlock;
        SOULS_MEMORY.MARIO_YUMP_ENABLED = unlock;
        SOULS_MEMORY.ISAAC_TEARS_ENABLED = unlock;
        SOULS_MEMORY.PUPPER_ENABLED = unlock;
        SOULS_MEMORY.MORPH_RAT_ENABLED = unlock;
        SOULS_MEMORY.ROCKET_JUMP_ENABLED = unlock;
        SOULS_MEMORY.QUANTUM_JUMP_ENABLED = unlock;
        SOULS_MEMORY.DASH_JUMP_ENABLED = unlock;
    }
    @install()
    fun cheat_menu_start_ability(lock_all, unlock_all) {
        if(lock_all) {
            _cheat_menu_start_ability(False);
            end();
        } else if(unlock_all) {
            _cheat_menu_start_ability(True);
            end();
        }

        MEMORY.QUESTION_ANSWER = 0d0;
        while(MEMORY.QUESTION_ANSWER != 0xffff) {
            init_cheat_page();

            font(OUTRO);
            text("Debug Menu: Start Ability");

            font(DEFAULT);
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.BOMB_ENABLED;
            text("[CHOICE][MEM1] - Bomb - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.MARIO_YUMP_ENABLED;
            text("[CHOICE][MEM1] - Yump - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.ISAAC_TEARS_ENABLED;
            text("[CHOICE][MEM1] - Tear - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.PUPPER_ENABLED;
            text("[CHOICE][MEM1] - Pupper - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.MORPH_RAT_ENABLED;
            text("[CHOICE][MEM1] - Morph Ball - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.ROCKET_JUMP_ENABLED;
            text("[CHOICE][MEM1] - Rocket Jump - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.QUANTUM_JUMP_ENABLED;
            text("[CHOICE][MEM1] - Quantum Jump - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.DASH_JUMP_ENABLED;
            text("[CHOICE][MEM1] - Dash Jump - [MEM1]");

            await_answer(MEMORY.QUESTION_ANSWER);

            if(MEMORY.QUESTION_ANSWER == 0d0) { // bomb
                SOULS_MEMORY.BOMB_ENABLED = !SOULS_MEMORY.BOMB_ENABLED;
            } else if(MEMORY.QUESTION_ANSWER == 0d1) { // yump
                SOULS_MEMORY.MARIO_YUMP_ENABLED = !SOULS_MEMORY.MARIO_YUMP_ENABLED;
            } else if(MEMORY.QUESTION_ANSWER == 0d2) { // tear
                SOULS_MEMORY.ISAAC_TEARS_ENABLED = !SOULS_MEMORY.ISAAC_TEARS_ENABLED;
            } else if(MEMORY.QUESTION_ANSWER == 0d3) { // pupper
                SOULS_MEMORY.PUPPER_ENABLED = !SOULS_MEMORY.PUPPER_ENABLED;
            } else if(MEMORY.QUESTION_ANSWER == 0d4) { // morph ball
                SOULS_MEMORY.MORPH_RAT_ENABLED = !SOULS_MEMORY.MORPH_RAT_ENABLED;
            } else if(MEMORY.QUESTION_ANSWER == 0d5) { // rocket jump
                SOULS_MEMORY.ROCKET_JUMP_ENABLED = !SOULS_MEMORY.ROCKET_JUMP_ENABLED;
            } else if(MEMORY.QUESTION_ANSWER == 0d6) { // quantum jump
                SOULS_MEMORY.QUANTUM_JUMP_ENABLED = !SOULS_MEMORY.QUANTUM_JUMP_ENABLED;
            } else if(MEMORY.QUESTION_ANSWER == 0d7) { // dash jump
                SOULS_MEMORY.DASH_JUMP_ENABLED = !SOULS_MEMORY.DASH_JUMP_ENABLED;
            }

            text_end();
            control(BOTH);
        }
    }

    fun _cheat_menu_forms(unlock) {
        SOULS_MEMORY.UNLOCKED_FORM_RAT = unlock;
        SOULS_MEMORY.UNLOCKED_FORM_STONE = unlock;
        SOULS_MEMORY.UNLOCKED_FORM_BOMB = unlock;
        SOULS_MEMORY.UNLOCKED_FORM_OGLIN = unlock;
        SOULS_MEMORY.UNLOCKED_FORM_RIMSALA = unlock;
        SOULS_MEMORY.UNLOCKED_FORM_MOSQUITO = unlock;
    }
    @install()
    fun cheat_menu_forms(lock_all, unlock_all) {
        if(lock_all) {
            _cheat_menu_forms(False);
            end();
        } else if(unlock_all) {
            _cheat_menu_forms(True);
            end();
        }

        MEMORY.QUESTION_ANSWER = 0d0;
        while(MEMORY.QUESTION_ANSWER != 0xffff) {
            init_cheat_page();

            font(OUTRO);
            text("Morph Forms");

            font(DEFAULT);
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.UNLOCKED_FORM_RAT;
            text("[CHOICE][MEM1] - Rat - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.UNLOCKED_FORM_STONE;
            text("[CHOICE][MEM1] - Stone - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.UNLOCKED_FORM_BOMB;
            text("[CHOICE][MEM1] - Bomb - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.UNLOCKED_FORM_OGLIN;
            text("[CHOICE][MEM1] - Oglin - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.UNLOCKED_FORM_RIMSALA;
            text("[CHOICE][MEM1] - Rimsala - [MEM1]");

            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.UNLOCKED_FORM_MOSQUITO;
            text("[CHOICE][MEM1] - Mosquito - [MEM1]");

            await_answer(MEMORY.QUESTION_ANSWER);

            if(MEMORY.QUESTION_ANSWER == 0d0) { // rat
                SOULS_MEMORY.UNLOCKED_FORM_RAT = !SOULS_MEMORY.UNLOCKED_FORM_RAT;
            } else if(MEMORY.QUESTION_ANSWER == 0d1) { // stone
                SOULS_MEMORY.UNLOCKED_FORM_STONE = !SOULS_MEMORY.UNLOCKED_FORM_STONE;
            } else if(MEMORY.QUESTION_ANSWER == 0d2) { // bomb
                SOULS_MEMORY.UNLOCKED_FORM_BOMB = !SOULS_MEMORY.UNLOCKED_FORM_BOMB;
            } else if(MEMORY.QUESTION_ANSWER == 0d3) { // oglin
                SOULS_MEMORY.UNLOCKED_FORM_OGLIN = !SOULS_MEMORY.UNLOCKED_FORM_OGLIN;
            } else if(MEMORY.QUESTION_ANSWER == 0d4) { // rimsala
                SOULS_MEMORY.UNLOCKED_FORM_RIMSALA = !SOULS_MEMORY.UNLOCKED_FORM_RIMSALA;
            } else if(MEMORY.QUESTION_ANSWER == 0d5) { // mosquito
                SOULS_MEMORY.UNLOCKED_FORM_MOSQUITO = !SOULS_MEMORY.UNLOCKED_FORM_MOSQUITO;
            }

            text_end();
            control(BOTH);
        }
    }
};
