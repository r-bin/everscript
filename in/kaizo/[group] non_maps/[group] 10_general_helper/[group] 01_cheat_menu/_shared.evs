group shared() {
    fun _cheat_menu_settings(unlock) {
        SOULS_MEMORY.SETTING_HINTS = unlock;
        SOULS_MEMORY.SETTING_NO_WEATHER = unlock;
        SOULS_MEMORY.SETTING_SNIFF_WITH_L = unlock;
    }
    @install()
    fun cheat_menu_settings(lock_all, unlock_all) {
        if(lock_all) {
            _cheat_menu_settings(False);
            end();
        } else if(unlock_all) {
            _cheat_menu_settings(True);
            end();
        }
        
        MEMORY.QUESTION_ANSWER = 0d0;
        while(MEMORY.QUESTION_ANSWER != 0xffff) {
            init_cheat_page();
    
            font(OUTRO);
            text("Settings");
    
            font(DEFAULT);
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.SETTING_HINTS;
            text("[CHOICE][MEM1] - Explicit hints - [MEM1]");
    
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.SETTING_NO_WEATHER;
            text("[CHOICE][MEM1] - No weather effects - [MEM1]");
    
            MEMORY.STRING_PARAMETER_1 = SOULS_MEMORY.SETTING_SNIFF_WITH_L;
            text("[CHOICE][MEM1] - Sniff with [L] - [MEM1]");
    
            await_answer(MEMORY.QUESTION_ANSWER);
    
            if(MEMORY.QUESTION_ANSWER == 0d0) { // hints
                SOULS_MEMORY.SETTING_HINTS = !SOULS_MEMORY.SETTING_HINTS;
            } else if(MEMORY.QUESTION_ANSWER == 0d1) { // setting weather
                SOULS_MEMORY.SETTING_NO_WEATHER = !SOULS_MEMORY.SETTING_NO_WEATHER;
            } else if(MEMORY.QUESTION_ANSWER == 0d2) { // sniff with L
                SOULS_MEMORY.SETTING_SNIFF_WITH_L = !SOULS_MEMORY.SETTING_SNIFF_WITH_L;
            }
    
            text_end();
            control(BOTH);
        }
    }
    
};
