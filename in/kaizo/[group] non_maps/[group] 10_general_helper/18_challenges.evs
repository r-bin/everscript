group challenges() {
    fun guard_challenge_revealer() {
        if(SOULS_MEMORY.CHALLENGE_NO_REVEALER) {
            subtext("nope.");
            end();
        }
    }
    fun guard_challenge_levitate() {
        if(SOULS_MEMORY.CHALLENGE_NO_REVEALER) {
            subtext("nope.");
            end();
        }
    }

    fun add_revealer_entity(callback, trigger, flag) {
        if!(SOULS_MEMORY.CHALLENGE_NO_REVEALER) {
            special_script(REVEALER, trigger);

            callback();
        }
    }
};
