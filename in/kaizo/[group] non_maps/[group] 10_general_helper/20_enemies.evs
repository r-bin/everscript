group enemies() {
    fun guard_crush_teleport() {
        guard_alchemy_animation_damage(<SCRIPT_OWNER>, CRUSH, CRUSH, {
            punish_yump(<BOY>[X], <BOY>[Y]);

            heal(SCRIPT_OWNER, 0d0, False);
            _teleport(BOY, <SCRIPT_OWNER>[X], <SCRIPT_OWNER>[Y]);
        });
    }
    
    @install()
    fun default_damage_death_script() {
        guard_crush_teleport();

        clean_up(<SCRIPT_OWNER>);
    }

    fun add_basic_souls_enemy(enemy:ENEMY, x, y, flags:FLAG_ENEMY) {
        if(flags !is None) {
            add_enemy(enemy, x, y, flags);
        } else {
            add_enemy(enemy, x, y);
        }
        attach_script(LAST_ENTITY, DAMAGE_DEATH, reference(default_damage_death_script));
    }
};
