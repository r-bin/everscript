group metroidvania() {
    fun vanishing_stone_triggered(flag) {
        flag = True;
        destroy(SCRIPT_OWNER);
        smart_sound(WEIRD_SOUND);
    }
    fun add_vanishing_rock(x, y, stone_trigger) {
        add_enemy(STONE_ROUND, x, y, INACTIVE_INVISIBLE);
        // animate(LAST_ENTITY, LOOP, INVISIBLE);
        attach_script(LAST_ENTITY, B, stone_trigger);
    }

    fun _add_morph_ball_stone(with_walk_in, with_phasing, with_fake_b, callback) {
        if(<ACTIVE>[TYPE] == CHARACTER_TYPE.RAT) {
            if(with_walk_in) {
                arg[0x10] = <ACTIVE>[FACE_DIRECTION];
            
                if(True) { // TODO: sound often missing
                    control(ACTIVE, False);
                    yield();
                    // smart_sound(WEIRD_SOUND);
                    yield();
                }
                
                smart_sound(WEIRD_SOUND);

                if(with_phasing) {
                    walk(ACTIVE, COORDINATE_ABSOLUTE_DIRECT, <SCRIPT_OWNER>[X], <SCRIPT_OWNER>[Y], ACTIVE, ACTIVE);
                } else {
                    walk(ACTIVE, COORDINATE_ABSOLUTE, <SCRIPT_OWNER>[X], <SCRIPT_OWNER>[Y], ACTIVE, ACTIVE);
                }

                _face(<ACTIVE>, arg[0x10]);
            } else {
                smart_sound(WEIRD_SOUND);
            }

            if(callback !is None) {
                callback();
            }
        } else {
            if(SOULS_MEMORY.MORPH_RAT_ENABLED) {
                error_message(TOO_NARROW);
            }

            if(with_fake_b) {
                fake_b();
            }
        }
    }
    fun add_morph_ball_stone(x, y, trigger) {
        add_enemy(STONE_ROUND, x, y, INACTIVE_INVISIBLE);

        if(trigger !is None) {
            attach_script(LAST_ENTITY, B, trigger);
        } else {
            attach_script(LAST_ENTITY, B, reference(@install() {
                _add_morph_ball_stone(True, False, True);
            }));
        }
    }

    fun guard_critter_door() {
        guard_critter(<ACTIVE>, {
            if(SOULS_MEMORY.MORPH_RAT_ENABLED) {
                error_message(TOO_NARROW);
            }

            fake_b();
        });
    }

    fun add_critter_door(x, y, trigger) {
        add_enemy(PLACEHOLDER, x, y);
        attach_script(LAST_ENTITY, B, trigger);
    }
};
