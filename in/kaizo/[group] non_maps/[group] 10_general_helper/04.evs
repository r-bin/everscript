group shared() {
    enum HELPER_START_ABILITY {
        BOMB = 0d1,
        TEAR = 0d2,
        
        YUMP = 0d3,
    
        PUPPER = 0d4,
        
        MORPH_RAT = 0d5,
    
        ROCKET_JUMP = 0d6,
        QUANTUM_JUMP = 0d7,
        DASH_JUMP = 0d8,
    }
    
    fun _show_start_ability(ability:HELPER_START_ABILITY) {
        if(ability == HELPER_START_ABILITY.BOMB) {
            subtext("[START] = Bomb");
        } else if(ability == HELPER_START_ABILITY.TEAR) {
            subtext("[START] = Tear");
        } else if(ability == HELPER_START_ABILITY.YUMP) {
            subtext("[START] = Yump");
        } else if(ability == HELPER_START_ABILITY.PUPPER) {
            subtext("[START] = Pupper");
        } else if(ability == HELPER_START_ABILITY.MORPH_RAT) {
            subtext("[START] = Morph Ball");
        } else if(ability == HELPER_START_ABILITY.ROCKET_JUMP) {
            subtext("[START] = Rocket Jump");
        } else if(ability == HELPER_START_ABILITY.QUANTUM_JUMP) {
            subtext("[START] = Quantum Jump");
        } else if(ability == HELPER_START_ABILITY.DASH_JUMP) {
            subtext("[START] = Dash Jump");
        } else {
            subtext("[START] = Nothing");
        }
    }
    @install()
    fun show_start_ability() {
        if(SOULS_MEMORY.MENU_CHOICE == 0d1) {
            arg[0x10] = SOULS_MEMORY.DEBUG_MENU_BUTTON_1;
        } else if(SOULS_MEMORY.MENU_CHOICE == 0d2) {
            arg[0x10] = SOULS_MEMORY.DEBUG_MENU_BUTTON_2;
        } else if(SOULS_MEMORY.MENU_CHOICE == 0d3) {
            arg[0x10] = SOULS_MEMORY.DEBUG_MENU_BUTTON_3;
        } else if(SOULS_MEMORY.MENU_CHOICE == 0d4) {
            arg[0x10] = SOULS_MEMORY.DEBUG_MENU_BUTTON_4;
        } else if(SOULS_MEMORY.MENU_CHOICE == 0d5) {
            arg[0x10] = SOULS_MEMORY.DEBUG_MENU_BUTTON_5;
        } else if(SOULS_MEMORY.MENU_CHOICE == 0d6) {
            arg[0x10] = SOULS_MEMORY.DEBUG_MENU_BUTTON_6;
        } else if(SOULS_MEMORY.MENU_CHOICE == 0d7) {
            arg[0x10] = SOULS_MEMORY.DEBUG_MENU_BUTTON_7;
        } else if(SOULS_MEMORY.MENU_CHOICE == 0d8) {
            arg[0x10] = SOULS_MEMORY.DEBUG_MENU_BUTTON_8;
        }
    
        _show_start_ability(arg[0x10]);
    }
    
    fun asign_debug_button_function(flag, feature) {
        if(flag) {
            arg[0x00]++;
    
            if(
                (SOULS_MEMORY.DEBUG_MENU_BUTTON_1 != feature)
                && (SOULS_MEMORY.DEBUG_MENU_BUTTON_2 != feature)
                && (SOULS_MEMORY.DEBUG_MENU_BUTTON_3 != feature)
                && (SOULS_MEMORY.DEBUG_MENU_BUTTON_4 != feature)
                && (SOULS_MEMORY.DEBUG_MENU_BUTTON_5 != feature)
                && (SOULS_MEMORY.DEBUG_MENU_BUTTON_6 != feature)
                && (SOULS_MEMORY.DEBUG_MENU_BUTTON_7 != feature)
                && (SOULS_MEMORY.DEBUG_MENU_BUTTON_8 != feature)
            ) {
                if(SOULS_MEMORY.DEBUG_MENU_BUTTON_1 == 0d0) {
                    SOULS_MEMORY.DEBUG_MENU_BUTTON_1 = feature;
                } else if(SOULS_MEMORY.DEBUG_MENU_BUTTON_2 == 0d0) {
                    SOULS_MEMORY.DEBUG_MENU_BUTTON_2 = feature;
                } else if(SOULS_MEMORY.DEBUG_MENU_BUTTON_3 == 0d0) {
                    SOULS_MEMORY.DEBUG_MENU_BUTTON_3 = feature;
                } else if(SOULS_MEMORY.DEBUG_MENU_BUTTON_4 == 0d0) {
                    SOULS_MEMORY.DEBUG_MENU_BUTTON_4 = feature;
                } else if(SOULS_MEMORY.DEBUG_MENU_BUTTON_5 == 0d0) {
                    SOULS_MEMORY.DEBUG_MENU_BUTTON_5 = feature;
                } else if(SOULS_MEMORY.DEBUG_MENU_BUTTON_6 == 0d0) {
                    SOULS_MEMORY.DEBUG_MENU_BUTTON_6 = feature;
                } else if(SOULS_MEMORY.DEBUG_MENU_BUTTON_7 == 0d0) {
                    SOULS_MEMORY.DEBUG_MENU_BUTTON_7 = feature;
                } else if(SOULS_MEMORY.DEBUG_MENU_BUTTON_8 == 0d0) {
                    SOULS_MEMORY.DEBUG_MENU_BUTTON_8 = feature;
                }
            }
        }
    }
    
    @install()
    fun update_debug_menu() {
        if(False) {
            SOULS_MEMORY.DEBUG_MENU_BUTTON_1 = 0d0;
            SOULS_MEMORY.DEBUG_MENU_BUTTON_2 = 0d0;
            SOULS_MEMORY.DEBUG_MENU_BUTTON_3 = 0d0;
            SOULS_MEMORY.DEBUG_MENU_BUTTON_4 = 0d0;
            SOULS_MEMORY.DEBUG_MENU_BUTTON_5 = 0d0;
            SOULS_MEMORY.DEBUG_MENU_BUTTON_6 = 0d0;
            SOULS_MEMORY.DEBUG_MENU_BUTTON_7 = 0d0;
            SOULS_MEMORY.DEBUG_MENU_BUTTON_8 = 0d0;
        }
    
        asign_debug_button_function(SOULS_MEMORY.BOMB_ENABLED, DEBUG_MENU_ENTRY.BOMBS);
        asign_debug_button_function(SOULS_MEMORY.ISAAC_TEARS_ENABLED, DEBUG_MENU_ENTRY.ISAAC);
        asign_debug_button_function(SOULS_MEMORY.MARIO_YUMP_ENABLED, DEBUG_MENU_ENTRY.MARIO);
        asign_debug_button_function(SOULS_MEMORY.PUPPER_ENABLED, DEBUG_MENU_ENTRY.PUPPER);
        asign_debug_button_function(SOULS_MEMORY.MORPH_RAT_ENABLED, DEBUG_MENU_ENTRY.MORPH_RAT);
        asign_debug_button_function(SOULS_MEMORY.ROCKET_JUMP_ENABLED, DEBUG_MENU_ENTRY.ROCKET_JUMP);
        asign_debug_button_function(SOULS_MEMORY.QUANTUM_JUMP_ENABLED, DEBUG_MENU_ENTRY.QUANTUM_JUMP);
        asign_debug_button_function(SOULS_MEMORY.DASH_JUMP_ENABLED, DEBUG_MENU_ENTRY.DASH_JUMP);
    
        MEMORY.RING_MENU_DEBUG = arg[0x00];
    }
    @install()
    fun debug_menu_select(index) {
        nop();
    }
    
    @install()
    fun bone_helper() {
        if!(FLAG.SWORD_1) {
            reward(SWORD_1);
    
            if(MEMORY.BONE) {
                MEMORY.BONE--;
            }
        }
    }
    
    @install()
    fun orb_helper_dialog() {
        if!(SOULS_MEMORY.ORB_USED) {
            dialog("I should bring the orb to the black smith.[B]");
        }
    }
    @install()
    fun formula_helper_dialog() {
        if!(SOULS_MEMORY.FORMULA_USED) {
            dialog("I should bring the formula to a trainer.[B]");
        }
    }
    @install()
    fun petal_shard_helper_dialog() {
        if(SOULS_MEMORY.ESTUS_CHARGES <= 0d1) {
            dialog("I should bring the shard to the fire keeper.[B]");
        }
    }
    @install()
    fun start_menu_helper_dialog() {
        if!(SOULS_MEMORY.DEBUG_MENU_BUTTON_1) {
            dialog("A new ring has been added to the ring menu.[B]Selecing an ability binds it to the [START]-button.[B]");
        }
    }
    @install()
    fun cheat_warning_dialog() {
        dialog("(Using this reward is considered cheating)[B]");
    }
    fun learn_alchemy(flag:FLAG, formula:ITEM, level_high, level_low, push_music) {
        if(flag) {
            level_high++;
        }
        
        reward(formula, push_music);
    }
    fun add_alchemy_recipe(level_high, level_low, push_music) {
        fanfare_item(True, push_music);
    
        level_low++;
    
        formula_helper_dialog();
    }
    fun custom_reward(item:CUSTOM_ITEM, push_music) {
        if(item < 0xf000) {
            reward(item, push_music);
        } else if(item == CUSTOM_ITEM.SWORD_ORB) { // weapons
            subtext("Sword Orb");
                
            fanfare_item(push_music);
    
            SOULS_MEMORY.ORB_SWORD++;
    
            orb_helper_dialog();
        } else if(item == CUSTOM_ITEM.SPEAR_ORB) {
            subtext("Spear Orb");
                
            fanfare_item(push_music);
    
            SOULS_MEMORY.ORB_SPEAR++;
    
            orb_helper_dialog();
        } else if(item == CUSTOM_ITEM.AXE_ORB) {
            subtext("Axe Orb");
                
            fanfare_item(push_music);
    
            SOULS_MEMORY.ORB_AXE++;
    
            orb_helper_dialog();
        
        } else if(item == CUSTOM_ITEM.CHEST_HEAVY) { // armor
            reward(CHEST_2_2, push_music);
        } else if(item == CUSTOM_ITEM.CHEST_RED) {
            reward(CHEST_2_3, push_music);
        } else if(item == CUSTOM_ITEM.HELM_ARCHAEOLOGY) {
            reward(HELM_4_3, push_music);
    
            dialog("[SLOW]What in the world is this? I hope someone can help me understand it.[B]");
        } else if(item == CUSTOM_ITEM.GLOVE_HACKER) {
            reward(GLOVE_4_1, push_music);
    
            dialog("[SLOW]You feel like hacker man.[B]");
        } else if(item == CUSTOM_ITEM.GLOVE_PIPBOY_NORTH_EAST) {
            unlock(GLOVE_4_2, push_music);
            subtext("Pip-Boy (V-31)");
            fanfare_item(push_music);
    
            if!(MEMORY.GLOVE_4_3) {
                dialog("[SLOW]It has a glowing display that says `Pip-Boy´.[B]");
            }
        } else if(item == CUSTOM_ITEM.GLOVE_PIPBOY_NORTH_WEST) {
            unlock(GLOVE_4_3, push_music);
            subtext("Pip-Boy (V-32)");
            fanfare_item(push_music);
    
            if!(MEMORY.GLOVE_4_2) {
                dialog("[SLOW]It has a glowing display that says `Pip-Boy´.[B]");
            }
        } else if(item == CUSTOM_ITEM.SMITH_KEY) { // quest items
            subtext("Gained Smith Key");
                
            fanfare_item(push_music);
    
            SOULS_MEMORY.SMITH_KEY = True;
        } else if(item == CUSTOM_ITEM.BIG_MUSHROOM) {
            subtext("Gained Big Mushroom");
                
            fanfare_item(push_music);
    
            SOULS_MEMORY.BIG_MUSHROOM = True;
        } else if(item == CUSTOM_ITEM.ISAAC_LETTER) {
            subtext("Gained Letter to Maggy");
                
            fanfare_item(push_music);
    
            SOULS_MEMORY.ISAAC_LETTER = True;
        } else if(item == CUSTOM_ITEM.ISAAC_WANTED_POSTER) {
            subtext("Gained Article `Wanted: Maggy´");
                
            fanfare_item(push_music);
    
            SOULS_MEMORY.ISAAC_WANTED_POSTER = True;
        } else if(item == CUSTOM_ITEM.BUG_CATCHER_BROKEN) {
            subtext("Gained Broken Bug Catcher");
                
            fanfare_item(push_music);
    
            SOULS_MEMORY.BUG_CATCHER_BROKEN = True;
        } else if(item == CUSTOM_ITEM.BUG_CATCHER) {
            subtext("Gained Bug Catcher");
                
            fanfare_item(push_music);
    
            SOULS_MEMORY.BUG_CATCHER = True;
        } else if(item == CUSTOM_ITEM.PATTERN_DRAGON_LEATHERWORK) {
            subtext("Gained Pattern Dragon Leather");
                
            fanfare_item(push_music);
    
            SOULS_MEMORY.PATTERN_DRAGON_LEATHERWORK = True;
        } else if(item == CUSTOM_ITEM.DRAGON_SCALES_RED) {
            subtext("Red Dragon Scales");
            SOULS_MEMORY.DRAGON_SCALES_RED = True;
    
            fanfare_item(True, push_music);
        } else if(item == CUSTOM_ITEM.DRAGON_SCALES_GREEN) {
            subtext("Green Dragon Scales");
            SOULS_MEMORY.DRAGON_SCALES_GREEN = True;
    
            fanfare_item(True, push_music);
        } else if(item == CUSTOM_ITEM.ISAAC_BOMB) { // active abilties
            subtext("Unlocked Bombs");
                
            fanfare_item(push_music);
    
            SOULS_MEMORY.BOMB_ENABLED = True;
            update_debug_menu();
    
            cheat_warning_dialog();
            start_menu_helper_dialog();
    
            dialog("[SLOW]New ability has been added to the ability ring![LF]Bombs require 2 Iron.[B]");
        } else if(item == CUSTOM_ITEM.MARIO_YUMP) {
            subtext("Unlocked Yump");
                
            fanfare_item(push_music);
    
            SOULS_MEMORY.MARIO_YUMP_ENABLED = True;
            update_debug_menu();
    
            cheat_warning_dialog();
            start_menu_helper_dialog();
    
            dialog("[SLOW]New ability has been added to the ability ring![LF]Yumps require 1 Mushroom.[B](Warning: Don't get softlocked, by not carrying Wings!)[B]");
        } else if(item == CUSTOM_ITEM.ISAAC_TEARS) {
            subtext("Unlocked Tears");
                
            fanfare_item(push_music);
    
            SOULS_MEMORY.ISAAC_TEARS_ENABLED = True;
        } else if(item == CUSTOM_ITEM.ROCKET_JUMP) {
            subtext("Unlocked Rocket Jump");
                
            fanfare_item(push_music);
    
            SOULS_MEMORY.ROCKET_JUMP_ENABLED = True;
            update_debug_menu();
    
            start_menu_helper_dialog();
    
            dialog("[SLOW]New ability has been added to the ability ring![LF]Rocket jumps damage you.[B]");
        } else if(item == CUSTOM_ITEM.PUPPER_MODE) {
            subtext("Unlocked Pupper Mode");
                
            fanfare_item(push_music);
    
            SOULS_MEMORY.PUPPER_ENABLED = True;
            update_debug_menu();
    
            start_menu_helper_dialog();
    
            dialog("[SLOW]New ability has been added to the ability ring![LF]Puppers require 1 Biscuit.[B]");
        } else if(item == CUSTOM_ITEM.MORPH_RAT) {
            subtext("Unlocked Morph Ball");
                
            fanfare_item(push_music);
    
            SOULS_MEMORY.MORPH_RAT_ENABLED = True;
            if!(SOULS_MEMORY.FORM_PREFERENCE) {
                SOULS_MEMORY.FORM_PREFERENCE = CHARACTER_TYPE.RAT;
            }
            update_debug_menu();
    
            start_menu_helper_dialog();
    
            dialog("[SLOW]New ability has been added to the ability ring![B]");
        } else if(item == CUSTOM_ITEM.PUPPER_MODE) {
            subtext("Unlocked Pupper Mode");
                
            fanfare_item(push_music);
    
            SOULS_MEMORY.PUPPER_ENABLED = True;
            update_debug_menu();
    
            start_menu_helper_dialog();
    
            dialog("[SLOW]New ability has been added to the ability ring![LF]Puppers require 1 Biscuit.[B]");
        } else if(item == CUSTOM_ITEM.MORPH_RAT) {
            subtext("Unlocked Morph Ball");
                
            fanfare_item(push_music);
    
            SOULS_MEMORY.MORPH_RAT_ENABLED = True;
            if!(SOULS_MEMORY.FORM_PREFERENCE) {
                SOULS_MEMORY.FORM_PREFERENCE = CHARACTER_TYPE.RAT;
            }
            update_debug_menu();
    
            start_menu_helper_dialog();
    
            dialog("[SLOW]New ability has been added to the ability ring![B]");
        } else if(item == CUSTOM_ITEM.QUANTUM_JUMP) {
            subtext("Unlocked Quantum Jump");
                
            fanfare_item(push_music);
    
            SOULS_MEMORY.QUANTUM_JUMP_ENABLED = True;
            update_debug_menu();
    
            cheat_warning_dialog();
            start_menu_helper_dialog();
    
            dialog("[SLOW]New ability has been added to the ability ring![B](Warning: Don't get softlocked, by not carrying Wings!)[B]");
        } else if(item == CUSTOM_ITEM.DASH_JUMP) {
            subtext("Unlocked Dash Jump");
                
            fanfare_item(push_music);
    
            SOULS_MEMORY.DASH_JUMP_ENABLED = True;
            update_debug_menu();
    
            start_menu_helper_dialog();
    
            dialog("[SLOW]New ability has been added to the ability ring![B]");
        } else if(item == CUSTOM_ITEM.ZELDA_POWER_GLOVE) { // passive abilties
            if(MEMORY.GLOVE_2_3 == 0d0) {
                subtext("Gained Power Gloves");
                unlock(GLOVE_2_3);
    
                fanfare_item(push_music);
            } else if(MEMORY.GLOVE_2_2 == 0d0) {
                subtext("Gained Titan's Mitt");
                unlock(GLOVE_2_2);
    
                fanfare_item(push_music);
            }
        } else if(item == CUSTOM_ITEM.TUNIC_GREEN) {
            subtext("Gained Green Tunic");
            unlock(CHEST_1_1);
                
            fanfare_item(True, push_music);
        } else if(item == CUSTOM_ITEM.TUNIC_RED) {
            subtext("Gained Red Tunic");
            unlock(CHEST_2_3);
                
            fanfare_item(True, push_music);
        } else if(item == CUSTOM_ITEM.ESTUS_SHARD) {
            subtext("Petal Shard");
            SOULS_MEMORY.ESTUS_SHARDS++;
                
            fanfare_item(True, push_music);
    
            petal_shard_helper_dialog();
        } else if(item == CUSTOM_ITEM.PICKAXE_HEAD) {
            subtext("Pickaxe Head");
            SOULS_MEMORY.PICKAXE_HEAD = True;
    
            fanfare_item(True, push_music);
            
            if!(SOULS_MEMORY.PICKAXE_SHAFT) {
                dialog("[SLOW]Wait, only the head, without the shaft?[B]");
            }
        } else if(item == CUSTOM_ITEM.PICKAXE_SHAFT) {
            subtext("Pickaxe Shaft");
            SOULS_MEMORY.PICKAXE_SHAFT = True;
    
            fanfare_item(True, push_music);
            
            if!(SOULS_MEMORY.PICKAXE_HEAD) {
                dialog("[SLOW]Wait, only the shaft, without the head?[B]");
            }
        } else if(item == CUSTOM_ITEM.PICKAXE) {
            subtext("Pickaxe");
            SOULS_MEMORY.PICKAXE = True;
    
            fanfare_item(True, push_music);
        } else if(item == CUSTOM_ITEM.ANGRY_BIRD) {
            subtext("Gained Angry Bird");
            MEMORY.CHICKEN++;
    
            fanfare_item(True, push_music);
        } else if(item == CUSTOM_ITEM.UPGRADE_MAGIC_SLOTS) {
            if!(SOULS_MEMORY.MAGIC_SLOTS_2) {
                SOULS_MEMORY.MAGIC_SLOTS_2 = True;
    
                MEMORY.STRING_PARAMETER_1 = 0d2;
            } else if!(SOULS_MEMORY.MAGIC_SLOTS_4) {
                SOULS_MEMORY.MAGIC_SLOTS_4 = True;
    
                MEMORY.STRING_PARAMETER_1 = 0d4;
            } else if!(SOULS_MEMORY.MAGIC_SLOTS_9) {
                SOULS_MEMORY.MAGIC_SLOTS_9 = True;
    
                MEMORY.STRING_PARAMETER_1 = 0d9;
            } else {
                MEMORY.STRING_PARAMETER_1 = 0d0;
            }
    
            if(MEMORY.STRING_PARAMETER_1) {
                subtext("Gained [MEM1] magic slots");
            } else {
                subtext("Gained Nothing");
            }
    
            fanfare_item(True, push_music);
        } else if(item == CUSTOM_ITEM.RANDOM_CHARM) {
            if!(FLAG.MOXA_STICK && FLAG.SILVER_SHEATH && FLAG.SUN_STONE && FLAG.RUBY_HEART && FLAG.THUGS_CLOAK && FLAG.WIZARDS_COIN) {
                arg[0x20] = False;
    
                while!(arg[0x20]) {
                    arg[0x22] = randrange(0d6);
    
                    if((arg[0x22] == 0d0) && (!FLAG.MOXA_STICK)) {
                        reward(MOXA_STICK);
                        arg[0x20] = True;
                    } else if((arg[0x22] == 0d1) && (!FLAG.SILVER_SHEATH)) {
                        reward(SILVER_SHEATH);
                        arg[0x20] = True;
                    } else if((arg[0x22] == 0d2) && (!FLAG.SUN_STONE)) {
                        reward(SUN_STONE);
                        arg[0x20] = True;
                    } else if((arg[0x22] == 0d3) && (!FLAG.RUBY_HEART)) {
                        reward(RUBY_HEART);
                        arg[0x20] = True;
                    } else if((arg[0x22] == 0d4) && (!FLAG.THUGS_CLOAK)) {
                        reward(THUGS_CLOAK);
                        arg[0x20] = True;
                    } else if((arg[0x22] == 0d5) && (!FLAG.WIZARDS_COIN)) {
                        reward(WIZARDS_COIN);
                        arg[0x20] = True;
                    }
                }
            } else {
                reward(NOTHING);
            }
        } else if(item == CUSTOM_ITEM.ENERGY_CORE) {
            CUSTOM_FLAG.NO_START = False;
    
            reward(ENERGY_CORE, push_music);
            
            if(False) {
                dialog("[SLOW]Abilities can't be supressed anymore.[B]");
            }
        } else if(item == CUSTOM_ITEM.ACID_RAIN) { // fake alchemy
            learn_alchemy(ACID_RAIN, ACID_RAIN, MEMORY.LEVEL_HIGH_ACID_RAIN, MEMORY.LEVEL_LOW_ACID_RAIN, push_music);
        } else if(item == CUSTOM_ITEM.FORMULA_ACID_RAIN) {
            subtext("Gained Acid Rain Formula");
    
            add_alchemy_recipe(MEMORY.LEVEL_HIGH_ACID_RAIN, MEMORY.LEVEL_LOW_ACID_RAIN, push_music);
        } else if(item == CUSTOM_ITEM.CORROSION) {
            learn_alchemy(CORROSION, CORROSION, MEMORY.LEVEL_HIGH_CORROSION, MEMORY.LEVEL_LOW_CORROSION, push_music);
        } else if(item == CUSTOM_ITEM.FORMULA_CORROSION) {
            subtext("Gained Corrosion Formula");
    
            add_alchemy_recipe(MEMORY.LEVEL_HIGH_CORROSION, MEMORY.LEVEL_LOW_CORROSION, push_music);
        } else if(item == CUSTOM_ITEM.DEFEND) {
            learn_alchemy(DEFEND, DEFEND, MEMORY.LEVEL_HIGH_DEFEND, MEMORY.LEVEL_LOW_DEFEND, push_music);
        } else if(item == CUSTOM_ITEM.FORMULA_DEFEND) {
            subtext("Gained Defend Formula");
    
            add_alchemy_recipe(MEMORY.LEVEL_HIGH_DEFEND, MEMORY.LEVEL_LOW_DEFEND, push_music);
        } else if(item == CUSTOM_ITEM.DRAIN) {
            learn_alchemy(DRAIN, DRAIN, MEMORY.LEVEL_HIGH_DRAIN, MEMORY.LEVEL_LOW_DRAIN, push_music);
        } else if(item == CUSTOM_ITEM.FORMULA_DRAIN) {
            subtext("Gained Drain Formula");
    
            add_alchemy_recipe(MEMORY.LEVEL_HIGH_DRAIN, MEMORY.LEVEL_LOW_DRAIN, push_music);
        } else if(item == CUSTOM_ITEM.ENERGIZE) {
            learn_alchemy(ENERGIZE, ENERGIZE, MEMORY.LEVEL_HIGH_ENERGIZE, MEMORY.LEVEL_LOW_ENERGIZE, push_music);
        } else if(item == CUSTOM_ITEM.FORMULA_ENERGIZE) {
            subtext("Gained Energize Formula");
    
            add_alchemy_recipe(MEMORY.LEVEL_HIGH_ENERGIZE, MEMORY.LEVEL_LOW_ENERGIZE, push_music);
        } else if(item == CUSTOM_ITEM.ESCAPE) {
            learn_alchemy(ESCAPE, ESCAPE, MEMORY.LEVEL_HIGH_ESCAPE, MEMORY.LEVEL_LOW_ESCAPE, push_music);
        } else if(item == CUSTOM_ITEM.FORMULA_ESCAPE) {
            subtext("Gained Escape Formula");
    
            add_alchemy_recipe(MEMORY.LEVEL_HIGH_ESCAPE, MEMORY.LEVEL_LOW_ESCAPE, push_music);
        } else if(item == CUSTOM_ITEM.FIRE_POWER) {
            learn_alchemy(FIRE_POWER, FIRE_POWER, MEMORY.LEVEL_HIGH_FIRE_POWER, MEMORY.LEVEL_LOW_FIRE_POWER, push_music);
        } else if(item == CUSTOM_ITEM.FORMULA_FIRE_POWER) {
            subtext("Gained Fire Power Formula");
    
            add_alchemy_recipe(MEMORY.LEVEL_HIGH_FIRE_POWER, MEMORY.LEVEL_LOW_FIRE_POWER, push_music);
        } else if(item == CUSTOM_ITEM.FLASH) {
            learn_alchemy(FLASH, FLASH, MEMORY.LEVEL_HIGH_FLASH, MEMORY.LEVEL_LOW_FLASH, push_music);
        } else if(item == CUSTOM_ITEM.FORMULA_FLASH) {
            subtext("Gained Flash Formula");
    
            add_alchemy_recipe(MEMORY.LEVEL_HIGH_FLASH, MEMORY.LEVEL_LOW_FLASH, push_music);
        } else if(item == CUSTOM_ITEM.FORCE_FIELD) {
            learn_alchemy(FORCE_FIELD, FORCE_FIELD, MEMORY.LEVEL_HIGH_FORCE_FIELD, MEMORY.LEVEL_LOW_FORCE_FIELD, push_music);
        } else if(item == CUSTOM_ITEM.FORMULA_FORCE_FIELD) {
            subtext("Gained Force Field Formula");
    
            add_alchemy_recipe(MEMORY.LEVEL_HIGH_FORCE_FIELD, MEMORY.LEVEL_LOW_FORCE_FIELD, push_music);
        } else if(item == CUSTOM_ITEM.HEAL) {
            learn_alchemy(HEAL, HEAL, MEMORY.LEVEL_HIGH_HEAL, MEMORY.LEVEL_LOW_HEAL, push_music);
        } else if(item == CUSTOM_ITEM.FORMULA_HEAL) {
            subtext("Gained Heal Formula");
    
            add_alchemy_recipe(MEMORY.LEVEL_HIGH_HEAL, MEMORY.LEVEL_LOW_HEAL, push_music);
        } else if(item == CUSTOM_ITEM.REVIVE) {
            learn_alchemy(REVIVE, REVIVE, MEMORY.LEVEL_HIGH_REVIVE, MEMORY.LEVEL_LOW_REVIVE, push_music);
        } else if(item == CUSTOM_ITEM.FORMULA_REVIVE) {
            subtext("Gained Revive Formula");
    
            add_alchemy_recipe(MEMORY.LEVEL_HIGH_REVIVE, MEMORY.LEVEL_LOW_REVIVE, push_music);
        } else if(item == CUSTOM_ITEM.SPEED) {
            learn_alchemy(SPEED, SPEED, MEMORY.LEVEL_HIGH_SPEED, MEMORY.LEVEL_LOW_SPEED, push_music);
        } else if(item == CUSTOM_ITEM.FORMULA_SPEED) {
            subtext("Gained Speed Formula");
    
            add_alchemy_recipe(MEMORY.LEVEL_HIGH_SPEED, MEMORY.LEVEL_LOW_SPEED, push_music);
        } else if(item == CUSTOM_ITEM.STOP) {
            learn_alchemy(STOP, STOP, MEMORY.LEVEL_HIGH_STOP, MEMORY.LEVEL_LOW_STOP, push_music);
        } else if(item == CUSTOM_ITEM.FORMULA_STOP) {
            subtext("Gained Stop Formula");
    
            add_alchemy_recipe(MEMORY.LEVEL_HIGH_STOP, MEMORY.LEVEL_LOW_STOP, push_music);
        } else if(item == CUSTOM_ITEM.ARCARDE_COIN) { // misc
            subtext("Arcade Coin");
    
            fanfare_item(True, push_music);
        } else {
            subtext("Found Invalid Custom Item");
        }
    }
    @install()
    fun trade_custom_items(out_type:CUSTOM_ITEM, out_count, in_1_type:ITEM, in_1_count, in_2_type:ITEM, in_2_count, in_3_type:ITEM, in_3_count) {
        trade_items(out_type, out_count, in_1_type, in_1_count, in_2_type, in_2_count, in_3_type, in_3_count);
    
        if(CUSTOM_MEMORY.RETURN > 0d0) {
            if(out_type != ITEM.NO_ITEM) {
                MEMORY.STRING_PARAMETER_1 = out_count;
    
                if(out_type == CUSTOM_ITEM.AXE_ORB) {
                    SOULS_MEMORY.ORB_AXE += out_count;
                    subtext("Gained [MEM1] axe orbs");
                } else {
                    MEMORY.STRING_PARAMETER_1 = out_type;
                    debug_subtext("unknown custom item #[MEM1]");
                }
            }
        }
    }
    
    @install()
    fun souls_select_alchemy(alchemy_index:ALCHEMY_PRESELECT_INDEX?) {
        select_alchemy(alchemy_index);
    
        if(SOULS_MEMORY.MAGIC_SLOTS_9) {
            end();
        }
    
        MEMORY.SELECTED_ALCHEMY_8 = 0xff;
        MEMORY.SELECTED_ALCHEMY_7 = 0xff;
        MEMORY.SELECTED_ALCHEMY_6 = 0xff;
        MEMORY.SELECTED_ALCHEMY_5 = 0xff;
        MEMORY.SELECTED_ALCHEMY_4 = 0xff;
    
        if(SOULS_MEMORY.MAGIC_SLOTS_4) {
            end();
        }
    
        MEMORY.SELECTED_ALCHEMY_3 = 0xff;
        MEMORY.SELECTED_ALCHEMY_2 = 0xff;
        
        if(SOULS_MEMORY.MAGIC_SLOTS_2) {
            end();
        }
    
        MEMORY.SELECTED_ALCHEMY_1 = 0xff;
    
        if(True) {
            end();
        }
    
        MEMORY.SELECTED_ALCHEMY_0 = 0xff;
    }
    
    @install()
    fun souls_quest_progress() {
        SOULS_MEMORY.PROGRESS_COUNTER++;
    }
    
    @install()
    fun _souls_boss_defeated_prepare() {
        control(NONE);
    
        attribute(BOY, INVINCIBLE_TEMP, True);
        attribute(DOG, INVINCIBLE_TEMP, True);
    
        // if!(ITEM.NO_ITEM) {
        //     reward(reward_item);
        // }
    
        SOULS_MEMORY.BOSSES_DEFEATED_COUNTER++;
        SOULS_MEMORY.PROGRESS_COUNTER++;
    
        update_reputation();
    
        subtext("Enemy Felled");
    
        fanfare_boss();
    
        if(SOULS_MEMORY.BOSSES_DEFEATED_COUNTER >= 0d02) {
            if!(FLAG.JAGUAR_RING) {
                reward(JAGUAR_RING);
            }
        }
    }
    fun _souls_boss_defeated(reward_item:SOULS_MEMORY, force) {
        if(reward_item is Function) {
            reward_item();
    
            fanfare_item(False);
        } else {
            if(reward_item != ITEM.NO_ITEM) {
                if(reward_item < 0xf000) {
                    reward(reward_item, False);
                } else {
                    custom_reward(reward_item, False);
                }
            }
        }
    }
    fun souls_boss_defeated(flag:SOULS_MEMORY, money:SOULS_MEMORY, reward_item_1:SOULS_MEMORY, reward_item_2:SOULS_MEMORY, reward_item_3:SOULS_MEMORY) {
        if(flag is Memory) {
            flag = True;
        }
    
        _souls_boss_defeated_prepare();
    
        currency_get(TALONS, money);
    
        if(reward_item_1 !is None) {
            _souls_boss_defeated(reward_item_1);
        }
        if(reward_item_2 !is None) {
            // CUSTOM_FLAG.REPLACE_MUSIC_INSTEAD = True;
            _souls_boss_defeated(reward_item_2);
        }
        if(reward_item_3 !is None) {
            // CUSTOM_FLAG.REPLACE_MUSIC_INSTEAD = True;
            _souls_boss_defeated(reward_item_3);
        }
    
        // subtext("Enemy Felled");
    
        pop_music();
    
        attribute(BOY, INVINCIBLE_TEMP, False);
        attribute(DOG, INVINCIBLE_TEMP, False);
        control(BOTH);
    }
    
