group souls_ground_switch() {
    fun guard_ground_switch(entity) {
        if(entity[GENERAL_PURPOSE] >= GROUND_SWITCH.WEIGHT_REQUIRED) {
            nop();
        } else if((<ACTIVE> == <BOY>) && (SOULS_MEMORY_HELPER.WEIGHT_BOY_INCREASED)) {
            nop();
        } else {
            if(entity[GENERAL_PURPOSE] > 0d0) {
                nop();
            } else if(MEMORY.CHEST_2_1 || MEMORY.CHEST_2_2) {
                error_message(TOO_LIGHT);
            } else if(entity[GENERAL_PURPOSE] == 0d0) {
                error_message(UNKNOWN);
            }
            end();
        }
    }

    fun souls_ground_switch_trigger(memory, x, y, callback) {
        ground_switch_trigger(memory, x, y, callback, False, GROUND_SWITCH.WEIGHT_REQUIRED, False);
    }

    fun souls_toggle_switch_trigger(memory, x, y, callback_activated, callback_deactivated) {
        ground_switch_trigger(memory, x, y, callback_activated, callback_deactivated, 0d2, True);
    }
};
