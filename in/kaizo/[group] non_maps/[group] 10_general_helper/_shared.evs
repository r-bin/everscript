        ONLY_DOG = CUSTOM_FLAG.NO_BOY,
    
        ALL_FORMS = SOULS_MEMORY.UNLOCKED_FORM_RAT && SOULS_MEMORY.UNLOCKED_FORM_STONE && SOULS_MEMORY.UNLOCKED_FORM_BOMB && SOULS_MEMORY.UNLOCKED_FORM_OGLIN && SOULS_MEMORY.UNLOCKED_FORM_RIMSALA && SOULS_MEMORY.UNLOCKED_FORM_MOSQUITO,
    
        WEIGHT_BOY_REDUCED = CUSTOM_MEMORY.WEIGHT_BOY < SYSTEM.WEIGHT_BOY,
        WEIGHT_BOY_INCREASED = CUSTOM_MEMORY.WEIGHT_BOY > SYSTEM.WEIGHT_BOY,
        WEIGHT_DOG_REDUCED = CUSTOM_MEMORY.WEIGHT_DOG < SYSTEM.WEIGHT_DOG,
        WEIGHT_DOG_INCREASED = CUSTOM_MEMORY.WEIGHT_DOG > SYSTEM.WEIGHT_DOG,
    }
    
};
