group consumable_heal() {
    @install(CONSUMABLE_HEAL_DATA.POINTER + CONSUMABLE_HEAL_DATA.PETAL, False)
    fun petal_heal() {
        code(0d0020, "// petal heal 40->20");
    }

    @install(CONSUMABLE_HEAL_DATA.POINTER + CONSUMABLE_HEAL_DATA.NECTAR, False)
    fun petal_nectar() {
        code(0d0020, "// nectar heal 120->20");
    }

    @install(CONSUMABLE_HEAL_DATA.POINTER + CONSUMABLE_HEAL_DATA.HONEY, False)
    fun petal_honey() {
        code(0d0050, "// honey heal 300->50");
    }
};
