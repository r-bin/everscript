group npc_shared() {
    fun test_death() {
        debug_memory(dead(<SCRIPT_OWNER>), _dead(<SCRIPT_OWNER>), <SCRIPT_OWNER>[HP]);

        guard_dead(<SCRIPT_OWNER>, {
            debug_subtext("guard_dead");
        });
        _guard_dead(<SCRIPT_OWNER>, {
            debug_subtext("_guard_dead");
        });
        guard_no_hp(<SCRIPT_OWNER>, {
            debug_subtext("guard_no_hp");
        });
    }

    fun upgrade_alchemy(alchemy:CUSTOM_ITEM, level_low, price, callback_positive, callback_negative) {
        item_pay(MONEY, price, False);
        
        if(CUSTOM_MEMORY.RETURN) {
            level_low--;
            
            custom_reward(alchemy, True);

            callback_positive();
        } else {
            callback_negative();
        }
    }
};
