group npc_alchemists() {
    group alchemist_helper() {
        fun dialog_alchemist_reward() {
            dialog("[SLOW]It's dangerous outside, take this[B]");
        }

        fun reward_formula(flag:FLAG, formula:ITEM, alchemy_index:ALCHEMY_INDEX, callback) {
            if!(flag) {
                if(callback !is None) {
                    callback();
                } else {
                    dialog_alchemist_reward();
                }

                reward(formula, True);
                souls_select_alchemy(alchemy_index);
            }
        }
    };

    // "A"
    group npc_alchemist_acid_rain() {
        fun add_souls_npc_alchemist_acid_rain(x, y, direction:DIRECTION) {
            if(direction is Word) {
                add_enemy(VILLAGER_2_8, x, y, INACTIVE);
                face(LAST_ENTITY, direction);
            } else {
                add_enemy(VILLAGER_2_8, x, y);
            }
            <LAST_ENTITY>[HP] = NPC_SHARED.DEFAULT_HP;
            
            attach_script(LAST_ENTITY, B, reference(@install() {
                smart_conversation({
                    if(<SCRIPT_OWNER>[GENERAL_PURPOSE] > 0d0) {
                        dialog("[SLOW]How can you be so calm with all those raptors around you?![B]");
                    } else {
                        reward_formula(ACID_RAIN, ACID_RAIN, ACID_RAIN);

                        arg[0x10] = randrange(0d3);
                        if(arg[0x10] == 0d0) {
                            dialog("[SLOW]Slowness is not weakness… It's inevitability…[B]");
                        } else if(arg[0x10] == 0d1) {
                            dialog("[SLOW]Why hurry? The grave waits for us all.[B]");
                        } else if(arg[0x10] == 0d2) {
                            dialog("[SLOW]Patience… is the greatest reagent.[B]");
                        }
                    }
                }, False);
            }));
        }
    };

    // "C"
    group npc_alchemist_corrosion() {
        fun add_souls_npc_alchemist_corrosion(x, y, direction:DIRECTION) {
            if(direction is Word) {
                add_enemy(VILLAGER_2_8, x, y, INACTIVE);
                face(LAST_ENTITY, direction);
            } else {
                add_enemy(VILLAGER_2_8, x, y);
            }
            <LAST_ENTITY>[HP] = NPC_SHARED.DEFAULT_HP;
            
            attach_script(LAST_ENTITY, B, reference(@install() {
                smart_conversation({
                    reward_formula(CORROSION, CORROSION, CORROSION);

                    dialog("unused[B]");
                }, False);
            }));
        }
    };
    group npc_alchemist_crush() {
        fun add_souls_npc_alchemist_crush(x, y, direction:DIRECTION) {
            if(direction is Word) {
                add_enemy(VILLAGER_2_8, x, y, INACTIVE);
                face(LAST_ENTITY, direction);
            } else {
                add_enemy(VILLAGER_2_8, x, y);
            }
            <LAST_ENTITY>[HP] = NPC_SHARED.DEFAULT_HP;
            
            attach_script(LAST_ENTITY, B, reference(@install() {
                smart_conversation({
                    reward_formula(CRUSH, CRUSH, CRUSH);
                    
                    arg[0x10] = randrange(0d3);
                    if(arg[0x10] == 0d0) {
                        dialog("[SLOW]Rock beats flesh. Every time.[B]");
                    } else if(arg[0x10] == 0d1) {
                        dialog("[SLOW]Stone remembers this strike.[B]");
                    } else if(arg[0x10] == 0d2) {
                        dialog("[SLOW]Flattened nicely.[B]");
                    }
                }, False);
            }));
        }
    };

    // "D"
    group npc_alchemist_defend() {
        fun add_souls_npc_alchemist_defend(x, y, direction:DIRECTION) {
            if(direction is Word) {
                add_enemy(VILLAGER_2_8, x, y, INACTIVE);
                face(LAST_ENTITY, direction);
            } else {
                add_enemy(VILLAGER_2_8, x, y);
            }
            <LAST_ENTITY>[HP] = NPC_SHARED.DEFAULT_HP;
            
            attach_script(LAST_ENTITY, B, reference(@install() {
                smart_conversation({
                    reward_formula(DEFEND, DEFEND, DEFEND);
                    
                    arg[0x10] = randrange(0d3);
                    if(arg[0x10] == 0d0) {
                        dialog("[SLOW]A flicker of protection. Nothing more.[B]");
                    } else if(arg[0x10] == 0d1) {
                        dialog("[SLOW]Stand strong… If only for the moment.[B]");
                    } else if(arg[0x10] == 0d2) {
                        dialog("[SLOW]It will fade as quickly as it shines.[B]");
                    }
                }, False);
            }));
        }
    };
    group npc_alchemist_drain() {
        fun add_souls_npc_alchemist_drain(x, y, direction:DIRECTION) {
            if(direction is Word) {
                add_enemy(MONK, x, y, INACTIVE);
                face(LAST_ENTITY, direction);
            } else {
                add_enemy(MONK, x, y);
            }
            attribute(LAST_ENTITY, INVINCIBLE, True);
            
            attach_script(LAST_ENTITY, B, reference(@install() {
                smart_conversation({
                    reward_formula(DRAIN, DRAIN, DRAIN);

                    arg[0x10] = randrange(0d3);
                    if(arg[0x10] == 0d0) {
                        dialog("[SLOW]Vitality flows… Straight to me.[B]");
                    } else if(arg[0x10] == 0d1) {
                        dialog("[SLOW]Life is wasted on the living.[B]");
                    } else if(arg[0x10] == 0d2) {
                        dialog("[SLOW]Wither so that I may thrive.[B]");
                    }
                }, False);
            }));
        }
    };

    // "E"
    group npc_alchemist_energize() {
        fun add_souls_npc_alchemist_energize(x, y, direction:DIRECTION) {
            if(direction is Word) {
                add_enemy(VILLAGER_2_8, x, y, INACTIVE);
                face(LAST_ENTITY, direction);
            } else {
                add_enemy(VILLAGER_2_8, x, y);
