    };

    // "R"
    group npc_alchemist_revive() {
        fun add_souls_npc_alchemist_revive(x, y, direction:DIRECTION) {
            if(direction is Word) {
                add_enemy(VILLAGER_2_8, x, y, INACTIVE);
                face(LAST_ENTITY, direction);
            } else {
                add_enemy(VILLAGER_2_8, x, y);
            }
            <LAST_ENTITY>[HP] = NPC_SHARED.DEFAULT_HP;
            
            attach_script(LAST_ENTITY, B, reference(@install() {
                smart_conversation({
                    reward_formula(REVIVE, REVIVE, REVIVE);

                    dialog("unused[B]");
                }, False);
            }));
        }
    };

    // "S"
    group npc_alchemist_speed() {
        fun add_souls_npc_alchemist_speed(x, y, direction:DIRECTION) {
            if(direction is Word) {
                add_enemy(VILLAGER_2_8, x, y, INACTIVE);
                face(LAST_ENTITY, direction);
            } else {
                add_enemy(VILLAGER_2_8, x, y);
            }
            <LAST_ENTITY>[HP] = NPC_SHARED.DEFAULT_HP;
            
            attach_script(LAST_ENTITY, B, reference(@install() {
                smart_conversation({
                    return_raycast(<ACTIVE>, <SCRIPT_OWNER>, 0d10);

                    if((<ACTIVE>[FACE_DIRECTION] >= FACE_DIRECTION.NORTH_EAST) && (<ACTIVE>[FACE_DIRECTION] <= FACE_DIRECTION.SOUTH_WEST) && (CUSTOM_MEMORY.RETURN > 0d1)) {
                        dialog("[SLOW]Can you please speak up, I can't understand you![B]");
                    } else {
                        reward_formula(SPEED, SPEED, SPEED);

                        arg[0x10] = randrange(0d6);
                        if(arg[0x10] == 0d0) {
                            dialog("[SLOW]Speed is not haste, but mastery of motion.[B]");
                        } else if(arg[0x10] == 0d1) {
                            dialog("[SLOW]Now you'll feel the breeze before the storm.[B]");
                        } else if(arg[0x10] == 0d2) {
                            dialog("[SLOW]Your feet were dragging. Let's fix that.[B]");
                        } else {
                            dialog("[SLOW]With enough speed you might even be able to outrun the wind![B]");
                        }
                    }
                }, False);
            }));
        }
    };
    group npc_alchemist_stop() {
        fun add_souls_npc_alchemist_stop(x, y, direction:DIRECTION) {
            if(direction is Word) {
                add_enemy(VILLAGER_2_8, x, y, INACTIVE);
                face(LAST_ENTITY, direction);
            } else {
