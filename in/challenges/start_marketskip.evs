    sound(WEIRD_SOUND);
    
    <0x225d, 0x08> = True;
}

@install()
@inject(ADDRESS.HOTKEY_START_R)
@count_limit(0x20)
fun hotkey_start_r() {
    attribute(ACTIVE, NO_CLIP, True);
}