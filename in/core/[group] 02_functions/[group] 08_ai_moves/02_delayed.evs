group delayed() {
    @install()
    @async()
    @weak()
    fun _projectile_delayed(target, height) {
        _add_placeholder(LEAVES_FALLING_2, target[X], target[Y], LOOP);
        attach_to_script(LAST_ENTITY);
        <SCRIPT_OWNER>[Z] = height;

        yield();
        while(<SCRIPT_OWNER>[Z] > 0d0) {
            yield();
        }
        animate(SCRIPT_OWNER, PAUSE, DEFAULT);

        shoot_entity_entity(SCRIPT_OWNER, BOOMERANG, BOY, 0d10, 0d100);

        sleep(0d60);

        animate(SCRIPT_OWNER, ONCE_FREEZE, INVISIBLE_FADE);
        wait(<SCRIPT_OWNER>);

        destroy(<SCRIPT_OWNER>);
    }
    @install()
    @weak()
    fun projectile_delayed(target, height, repeat) {
        repeat++;

        while(repeat > 0d0) {
            repeat--;

            _projectile_delayed(target, height);

            if(repeat > 0d0) {
                sleep(0d20);
            }
        }
    }

    @install()
    @async()
    @weak()
    fun projectile_barage_delayed(target, height) {
        _add_placeholder(LEAVES_FALLING_1, target[X], target[Y], LOOP);
        attach_to_script(LAST_ENTITY);
        <SCRIPT_OWNER>[Z] = height;
        
        yield();
        while(<SCRIPT_OWNER>[Z] > 0d0) {
            yield();
        }
        animate(SCRIPT_OWNER, PAUSE, DEFAULT);

        ai_move_projectile_puke(<SCRIPT_OWNER>, BOOMERANG, <BOY>, 0d4);

        sleep(0d60);

        destroy(<SCRIPT_OWNER>);
    }
};
