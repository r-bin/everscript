group chicken() {
    @install()
    @async()
    @weak()
    fun _chickens_taunted(x, y) {
        _add_placeholder(DOVES_1, x, y);
        attach_to_script(LAST_ENTITY);

        <SCRIPT_OWNER>[Z] = 0d1500 + randrange(0d500);

        while(<SCRIPT_OWNER>[Z] > 0d0) {
            yield();
        }

        bomb_entity(<SCRIPT_OWNER>, 0d50, 0d5);

        animate(SCRIPT_OWNER, ONCE_FREEZE, ANIMATION_PLACEHOLDER.EXPLOSION_1);

        wait(SCRIPT_OWNER);

        destroy(SCRIPT_OWNER);
    }
    @install()
    @weak()
    fun chickens_taunted(count) {
        while(count > 0d3) {
            count -= 0d3;

            _chickens_taunted(<ACTIVE>[X], <ACTIVE>[Y]);
            sleep(0d20);
            if(randrange(0d1)) {
                _chickens_taunted(<ACTIVE>[X] + 0d30 + randrange(0d50), <ACTIVE>[Y] + 0d30 + randrange(0d100));
            }
            sleep(0d20);
            if(randrange(0d1)) {
                _chickens_taunted(<ACTIVE>[X] - 0d30 - randrange(0d50), <ACTIVE>[Y] - 0d30 - randrange(0d100));
            }
            sleep(0d20 + randrange(0d30));
        }
    }
};
