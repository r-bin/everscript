    fun _replace_enemy_with_type(enemy:ENEMY, type:CHARACTER_TYPE, wait_for_input?, extra_details) {
        arg[0x0e]++;
        debug_memory(arg[0x0e], type, enemy);

        // replace_enemy(arg[0x10], enemy);
        replace_enemy(arg[0x10], enemy, INACTIVE_IMORTAL);
        arg[0x10] = <LAST_ENTITY>;
        // face(LAST_ENTITY, EAST);
        // animate(LAST_ENTITY, ONCE, SLASH_1);
        <LAST_ENTITY>[TYPE] = type;
        attribute(LAST_ENTITY, ROOT, True);

        if(extra_details) {
            replace_enemy(arg[0x14], enemy, INACTIVE_IMORTAL);
            arg[0x14] = <LAST_ENTITY>;
            face(LAST_ENTITY, EAST);
            // animate(LAST_ENTITY, ONCE, SLASH_1);
            <LAST_ENTITY>[TYPE] = type;
            attribute(LAST_ENTITY, ROOT, True);

            if(True) {
                replace_enemy(arg[0x16], enemy, INACTIVE_IMORTAL);
                arg[0x16] = <LAST_ENTITY>;
                <LAST_ENTITY>[TYPE] = type;
                attribute(LAST_ENTITY, ROOT, True);
                
                sleep(0d5);
                animate(LAST_ENTITY, ONCE, SLASH_1);
            }
        }

        replace_enemy(arg[0x12], enemy, INACTIVE_IMORTAL);
        arg[0x12] = <LAST_ENTITY>;
        attribute(LAST_ENTITY, ROOT, True);

        if(False) {
            sleep(0d30);
            animate(arg[0x10], ONCE, SLASH_1);
        }

        if(wait_for_input) {
            while!(CUSTOM_MEMORY.INPUT_P1) {
                yield();
            }
            while(CUSTOM_MEMORY.INPUT_P1) {
                yield();
            }
        } else {
            sleep(0d30);
        }
    }
    fun replace_enemy_with_type(enemy:ENEMY, type:CHARACTER_TYPE, wait_for_input?, extra_details) {
        destroy(<DOG>);
        attribute(BOY, INVINCIBLE_TEMP, True);

        arg[0x0e] = 0d0;

        _add_enemy(enemy, <BOY>[X] + 0d50, <BOY>[Y]);
        arg[0x10] = <LAST_ENTITY>;
        attribute(LAST_ENTITY, ROOT, True);
        _add_enemy(enemy, <BOY>[X] + 0d100, <BOY>[Y]);
        arg[0x12] = <LAST_ENTITY>;
        attribute(LAST_ENTITY, ROOT, True);

        if(extra_details) {
            _add_enemy(enemy, <BOY>[X], <BOY>[Y]);
            arg[0x14] = <LAST_ENTITY>;
            attribute(LAST_ENTITY, ROOT, True);

