            arg[0x16] = <LAST_ENTITY>;
            attribute(LAST_ENTITY, ROOT, True);
        }

        // 1…9
        _replace_enemy_with_type(FIRE_EYES, type, wait_for_input, extra_details);
        _replace_enemy_with_type(EVIL_FIRE_EYES, type, wait_for_input, extra_details);
