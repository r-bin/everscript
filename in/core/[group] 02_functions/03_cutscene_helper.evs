group cutscene_helper() {
    @install()
    @async()
    @weak()
    fun single_animation(entity, animation:ANIMATION_PLACEHOLDER, offset_x, offset_y) {
        if(animation == ANIMATION_PLACEHOLDER.TELEPORT_OUT) {
            _add_placeholder(TELEPORT_OUT, entity[X] + offset_x, entity[Y] + offset_y, ONCE);
        } else if(animation == ANIMATION_PLACEHOLDER.TELEPORT_IN) {
            _add_placeholder(TELEPORT_IN, entity[X] + offset_x, entity[Y] + offset_y, ONCE);
        } else if(animation == ANIMATION_PLACEHOLDER.EXPLOSION_1) {
            _add_placeholder(EXPLOSION_1, entity[X] + offset_x, entity[Y] + offset_y, ONCE);
        }
        attach_to_script(LAST_ENTITY);

        wait(SCRIPT_OWNER);
        _destroy(SCRIPT_OWNER);
    }

    fun fake_loot() {
        animate(BOY, ONCE, ANIMATION_BOY.LOOT);
        sleep(0d15);
        sound(CLICK_3);
        sleep(0d15);
    }

    fun fake_loot_gourd() {
        sound(CLICK_3);
    }

    fun fake_b() {
        animate(ACTIVE, ONCE, SLASH_1);
    }

    fun fake_chest(flag, object_index, object_value) {
        fake_loot_gourd();

        flag = True;

        if(object_value !is None) {
            object[object_index] = object_value;
        } else {
            object[object_index] = 0x01;
        }
    }
    fun fake_chest_init(flag, object_index, object_value) {
        if(flag) {
            if(object_value !is None) {
                object[object_index] = object_value;
            } else {
                object[object_index] = 0x01;
            }
        }
    }
};
