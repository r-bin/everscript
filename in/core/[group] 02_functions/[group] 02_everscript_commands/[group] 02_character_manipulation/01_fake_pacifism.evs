group fake_pacifism() {
    enum AI_BEHAVIOR {
        DEBUG = False,

        COMBATIVENESS_0 = 0x0000,
        COMBATIVENESS_1 = 0x0001,
        COMBATIVENESS_2 = 0x0002,
        COMBATIVENESS_3 = 0x0003,
        COMBATIVENESS_4 = 0x0004,
        COMBATIVENESS_5 = 0x0005,
        COMBATIVENESS_6 = 0x0006,

        COMBATIVENESS_UNKNOWN = 0xffff,
    }

    fun _fake_compativeness(memory_combativeness_temp, memory_combativeness, value:AI_BEHAVIOR) {
        memory_combativeness_temp = 0x80 | memory_combativeness;
        memory_combativeness = value;
    }
    @install()
    @weak()
    fun fake_compativeness(aggro:AI_BEHAVIOR) {
        if(AI_BEHAVIOR.DEBUG) {
            MEMORY.STRING_PARAMETER_1 = aggro;
            MEMORY.STRING_PARAMETER_2 = CUSTOM_MEMORY.BOY_TEMP_AGGRO;
            _subtext("fake compativeness: [MEM2]->[MEM1]");
        }
        
        _fake_compativeness(CUSTOM_MEMORY.BOY_TEMP_AGGRO, MEMORY.BOY_COMBATIVENESS, aggro);
        _fake_compativeness(CUSTOM_MEMORY.DOG_TEMP_AGGRO, MEMORY.DOG_COMBATIVENESS, aggro);
    }

    fun _restore_fake_compativeness(memory_combativeness_temp, memory_combativeness) {
        if(memory_combativeness_temp & 0x80) {
            memory_combativeness = memory_combativeness_temp & 0x7f;
            memory_combativeness_temp = 0x00;
        }
    }
    @install()
    @weak()
    fun restore_fake_compativeness() {
        if(AI_BEHAVIOR.DEBUG) {
            MEMORY.STRING_PARAMETER_1 = CUSTOM_MEMORY.BOY_TEMP_AGGRO;
            MEMORY.STRING_PARAMETER_2 = CUSTOM_MEMORY.DOG_TEMP_AGGRO;
            _subtext("restore fake compativeness: [MEM1]/[MEM2]");
        }
        
        _restore_fake_compativeness(CUSTOM_MEMORY.BOY_TEMP_AGGRO, MEMORY.BOY_COMBATIVENESS);
        _restore_fake_compativeness(CUSTOM_MEMORY.DOG_TEMP_AGGRO, MEMORY.DOG_COMBATIVENESS);
    }
};            
