    fun unlock_weapons(unlocked) {
        if(unlocked == True) {
            <0x22DA> = 0xff;
            <0x22DB> = 0xff;

            MEMORY.AMMO_1 = 0xff;
            MEMORY.AMMO_2 = 0xff;
            MEMORY.AMMO_3 = 0xff;
        } else {
            <0x22DA> = 0x00;
            <0x22DB> = 0x00;

            MEMORY.AMMO_1 = 0x00;
            MEMORY.AMMO_2 = 0x00;
            MEMORY.AMMO_3 = 0x00;
        }
    }
    fun unlock_alchemy(unlocked) {
        if(unlocked == True) {
            <0x2258> = 0xff;
