            subtext("Found Dry Ice");
        } else {
            subtext("Found Invalid Item");
        }

        if(without_fanfare is Word) {
            if!(without_fanfare) {
                fanfare_item();
            }
        } else {
            fanfare_item();
        }
    }
    @install()
    @weak()
    fun reward(item:ITEM, push_music) {
        _reward(item, True);
        
        if(push_music > 0d0) {
            fanfare_item(True);
        } else {
            fanfare_item();
        }
    }
