    }

    @install()
    @async()
    @weak()
    fun meteor(x, y) {
        if!(CUSTOM_MEMORY.METEOR) {
            _add_enemy(STONE, x, y);
            CUSTOM_MEMORY.METEOR = <LAST_ENTITY>;

            attach_to_script(LAST_ENTITY);
            <SCRIPT_OWNER>[Z] = 0d3000;

            while(<SCRIPT_OWNER>[Z] > 0d0) {
                yield();
            }

            bomb_entity(<BOY>, 0d50, 0d20);
            bomb_entity(<SCRIPT_OWNER>, 0d50, 0d20);
        } else if(False) {
            subtext("nope");
        }
    }

    fun _morph(type:CHARACTER_TYPE) {
        arg[0x20]++;

        if(arg[0x20] == START_GIMMICK.BOMB_TIME) {
            if(<SCRIPT_OWNER>[TYPE] == CHARACTER_TYPE.BOMB) {
                vanilla_bomb_explosion(True);
            }
        } else {
            if(
                (<SCRIPT_OWNER> == <ACTIVE>)
                && (!(<SCRIPT_OWNER>[FLAGS_1] & ATTRIBUTE_FLAGS.DISABLED))
                && (!(<SCRIPT_OWNER>[FLAGS_1] & ATTRIBUTE_FLAGS.IN_ANIMATION))
            ) {

                if((MEMORY.INPUT_P1 & INPUT.B) == INPUT.B) {
                    if(
                        (<SCRIPT_OWNER>[TYPE] != CHARACTER_TYPE.STONE)
                    ){
                        if(True) {
                            attribute(SCRIPT_OWNER, INVISIBLE, True);
                            <SCRIPT_OWNER>[TYPE] = arg[0x12];
                            if!(MEMORY.PACIFIED) {
                                MEMORY.PACIFIED = True;
                                yield();
                                MEMORY.PACIFIED = False;
                            } else {
                                yield();
                            }
                            <SCRIPT_OWNER>[TYPE] = type;
                            attribute(SCRIPT_OWNER, INVISIBLE, False);
                        }

                        animate(SCRIPT_OWNER, ONCE, SLASH_1);
                        wait(SCRIPT_OWNER);

                        sleep(START_GIMMICK.MORPH_COOLDOWN);
                        // subtext("up");
                    }
                } else if(((MEMORY.INPUT_P1 & INPUT.A) == INPUT.A) && (<SCRIPT_OWNER>[Z] == 0d0)) {
                    if(True) {
                        if(False) {
                            <SCRIPT_OWNER>[VELOCITY] = 0d30;
                        } else {
                            animate(SCRIPT_OWNER, ONCE, SLASH_1_3);
                            wait(SCRIPT_OWNER);
                        }
                    } else {
                        mario_yump(False);
                    }
                    sleep(0d10);
                    // subtext("up");
                }

                if((MEMORY.INPUT_P1 & (INPUT.UP | INPUT.RIGHT)) == (INPUT.UP | INPUT.RIGHT)) {
                    _face(<SCRIPT_OWNER>, NORTH_EAST);
                    sleep(0d10);
                    // subtext("up");
                } else if((MEMORY.INPUT_P1 & (INPUT.RIGHT | INPUT.DOWN)) == (INPUT.RIGHT | INPUT.DOWN)) {
                    _face(<SCRIPT_OWNER>, SOUTH_EAST);
                    sleep(0d10);
                    // subtext("up");
                } else if((MEMORY.INPUT_P1 & (INPUT.DOWN | INPUT.LEFT)) == (INPUT.DOWN | INPUT.LEFT)) {
                    _face(<SCRIPT_OWNER>, SOUTH_WEST);
                    sleep(0d10);
                    // subtext("up");
                } else if((MEMORY.INPUT_P1 & (INPUT.UP | INPUT.LEFT)) == (INPUT.UP | INPUT.LEFT)) {
                    _face(<SCRIPT_OWNER>, NORTH_WEST);
                    sleep(0d10);
                    // subtext("up");
                } else if((MEMORY.INPUT_P1 & INPUT.UP) == INPUT.UP) {
                    face(SCRIPT_OWNER, NORTH);
                    sleep(0d10);
                    // subtext("up");
                } else if((MEMORY.INPUT_P1 & INPUT.RIGHT) == INPUT.RIGHT) {
                    face(SCRIPT_OWNER, EAST);
                    sleep(0d10);
                    // subtext("right");
                } else if((MEMORY.INPUT_P1 & INPUT.DOWN) == INPUT.DOWN) {
                    face(SCRIPT_OWNER, SOUTH);
                    sleep(0d10);
                    // subtext("down");
                } else if((MEMORY.INPUT_P1 & INPUT.LEFT) == INPUT.LEFT) {
                    face(SCRIPT_OWNER, WEST);
                    sleep(0d10);
                    // subtext("left");
                }
            }
        }

        yield();

        if(False) {
            debug_memory(MEMORY.INPUT_P1, INPUT.UP, MEMORY.INPUT_P1 | INPUT.UP);
            sleep(0d10);
        }
    }
    @install()
    @async()
    @weak()
    fun morph(type:CHARACTER_TYPE) {
        while(<BOY>[TYPE] == type) {
            _morph(type);
        }
    }
    @install()
    @async()
    @weak()
    fun morph_hold(type:CHARACTER_TYPE) {
        // good: RAT, MOSQUITO, RIMSALA, BOMB, STONE/STONE_ROUND, VERMINATOR
        // weird AI: RAPTOR_GREEN, OGLIN, FOOTKNIGHT, SLIME_*

        while(True) {
            <BOY>[TYPE] = CHARACTER_TYPE.BOY;

            while!((MEMORY.INPUT_P1 & INPUT.L) == INPUT.L) {
                yield();
            }

            <BOY>[TYPE] = type;

            while((MEMORY.INPUT_P1 & INPUT.L) == INPUT.L) {
                _morph(type);
            }
        }
    }
    @install()
    @async()
    @weak()
    fun morph_toggle(entity, type:CHARACTER_TYPE, with_toggle) {
        attach_to_script(entity);
        arg[0x10] = <SCRIPT_OWNER>[TYPE];
        if(<ACTIVE> == <BOY>) {
            if(SYSTEM.WITH_DEBUG_START) {
                subtext("boy");
            }
            arg[0x12] = CHARACTER_TYPE.BOY;
        } else {
            if(SYSTEM.WITH_DEBUG_START) {
                subtext("dog");
            }
            arg[0x12] = CHARACTER_TYPE.DOG;
        }

        if(SYSTEM.WITH_DEBUG_START && False) {
            _debug_memory(entity, <SCRIPT_OWNER>, <BOY>);
            sleep(0d30);
        }

        if(with_toggle) {
            single_animation(<SCRIPT_OWNER>, TELEPORT_OUT, 0d0, 0d1);
        }

        if(with_toggle && (<SCRIPT_OWNER>[TYPE] != arg[0x12])) {
            if(SYSTEM.WITH_DEBUG_START) {
                _debug_memory(0d1, <SCRIPT_OWNER>[TYPE], arg[0x12]);
            }
            <SCRIPT_OWNER>[TYPE] = arg[0x12];
            if(True) { // TODO: not sure why this is required - the game might assume that the boy is a boy
                yield();
                <SCRIPT_OWNER>[TYPE] = arg[0x12];
            }
        } else {
            if(SYSTEM.WITH_DEBUG_START) {
                _debug_memory(0d2, <SCRIPT_OWNER>[TYPE], arg[0x12]);
            }
            <SCRIPT_OWNER>[TYPE] = type;
            if(type == CHARACTER_TYPE.MOSQUITO) {
                attribute(SCRIPT_OWNER, NO_CLIP, True);
            }

            while((<SCRIPT_OWNER>[TYPE] == type) && (<SCRIPT_OWNER>[HP] > 0d0)) {
                _morph(type);
            }

            if(type == CHARACTER_TYPE.MOSQUITO) {
                attribute(SCRIPT_OWNER, NO_CLIP, False);
            }
            <SCRIPT_OWNER>[TYPE] = arg[0x10];
        }
    }
};
