group start_projectiles() {
    @install()
    @weak()
    fun spear_toss() {
        if(MEMORY.CURRENT_WEAPON_TYPE == WEAPON_TYPE.SPEAR) {
            face(BOY, NORTH);
            animate(BOY, ONCE, SLASH_3);
        } else {
            error_message(WRONG_WEAPON);
        }
    }
    
    @install()
    @weak()
    fun windwalker_rocket() {
        if((<BOY>[FLAGS_1] & ATTRIBUTE_FLAGS.IN_ANIMATION) || (<BOY>[FLAGS_2] & ATTRIBUTE_FLAGS.HEALED)) {
            end();
        }

        shoot_entity_offset_relative(BOY, ONION, 0d16, 0d0, 0d256, 0d0, 0x10, 0xff);
        sound(PROJECTILE_SHOOTING);
    }

    @install()
    @weak()
    fun spaceship_rocket(gun) {
        if((<BOY>[FLAGS_1] & ATTRIBUTE_FLAGS.IN_ANIMATION) || (<BOY>[FLAGS_2] & ATTRIBUTE_FLAGS.HEALED)) {
            _debug_memory(<BOY>[FLAGS_1] & ATTRIBUTE_FLAGS.IN_ANIMATION, <BOY>[FLAGS_2] & ATTRIBUTE_FLAGS.HEALED);
            end();
        }

        face(BOY, NORTH);
        if(gun == 0d1) {
            shoot_entity_offset_relative(BOY, MISSILE, -0d35, 0d30, 0d0, -0d300, 0x10, 0xff);
        } else if(gun == 0d2) {
            shoot_entity_offset_relative(BOY, MISSILE, 0d35, 0d30, 0d0, -0d300, 0x10, 0xff);
        } else {
            shoot_entity_offset_relative(BOY, MISSILE, 0d0, -0d10, 0d0, -0d300, 0x10, 0xff);
        }
        sound(PROJECTILE_SHOOTING);
    }
};
