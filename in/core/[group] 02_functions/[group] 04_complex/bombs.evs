group bombs() {
    enum BOMB {
        TRIGGER_DAMAGE = 0d9999,

        RANGE = 0d50,

        DAMAGE_VANILLA = 0d2000,
        DAMAGE_BOY = 0d200,
        
        DELAY_TRIGGER = 0d10,
        DELAY_CLEANUP = 0d60,
    }
    enum BOMBABLE_STATE {
        DEFAULT = 0x00,

        DOORS_LOCKED = 0x01,
        DOORS_UNLOCKED = 0x02,
    }

    @install()
    @weak()
    fun prepare_bombable_entity(entity) {
        attribute(entity, INVINCIBLE_TEMP, True);
        entity[HP] = 0d1;

        if!(CUSTOM_MEMORY.BOMBABLE_OBJECT_1) {
            CUSTOM_MEMORY.BOMBABLE_OBJECT_1 = entity;
        } else if!(CUSTOM_MEMORY.BOMBABLE_OBJECT_2) {
            CUSTOM_MEMORY.BOMBABLE_OBJECT_2 = entity;
        } else if!(CUSTOM_MEMORY.BOMBABLE_OBJECT_3) {
            CUSTOM_MEMORY.BOMBABLE_OBJECT_3 = entity;
        } else if!(CUSTOM_MEMORY.BOMBABLE_OBJECT_4) {
            CUSTOM_MEMORY.BOMBABLE_OBJECT_4 = entity;
        } else if!(CUSTOM_MEMORY.BOMBABLE_OBJECT_5) {
            CUSTOM_MEMORY.BOMBABLE_OBJECT_5 = entity;
        } else if!(CUSTOM_MEMORY.BOMBABLE_OBJECT_6) {
            CUSTOM_MEMORY.BOMBABLE_OBJECT_6 = entity;
        } else if!(CUSTOM_MEMORY.BOMBABLE_OBJECT_7) {
            CUSTOM_MEMORY.BOMBABLE_OBJECT_7 = entity;
        } else if!(CUSTOM_MEMORY.BOMBABLE_OBJECT_8) {
            CUSTOM_MEMORY.BOMBABLE_OBJECT_8 = entity;
        } else if!(CUSTOM_MEMORY.BOMBABLE_OBJECT_9) {
            CUSTOM_MEMORY.BOMBABLE_OBJECT_9 = entity;
        } else if!(CUSTOM_MEMORY.BOMBABLE_OBJECT_10) {
            CUSTOM_MEMORY.BOMBABLE_OBJECT_10 = entity;
        } else if!(CUSTOM_MEMORY.BOMBABLE_OBJECT_11) {
            CUSTOM_MEMORY.BOMBABLE_OBJECT_11 = entity;
        } else if!(CUSTOM_MEMORY.BOMBABLE_OBJECT_12) {
            CUSTOM_MEMORY.BOMBABLE_OBJECT_12 = entity;
        }
    }
    fun _unprepare_bombable_entity(entity) {
        if((entity) && (entity[ATTACHED_SCRIPT_ID] == arg[0x10])) {
            destroy(entity);
            entity = 0x0000;

            if(False) {
                MEMORY.STRING_PARAMETER_1 = entity;
                debug_subtext("removed entity [MEM1]");
            }
        }
    }
    @install()
    @weak()
    fun unprepare_bombable_entity(entity) { // TODO: the entity still gets damage, which should not happen
        if(entity != <BOY>) {
            heal(entity, 0d0, False);
            attribute(entity, INVINCIBLE, True);
            attribute(entity, INVINCIBLE_TEMP, True);
            destroy(entity);

            arg[0x10] = entity[ATTACHED_SCRIPT_ID];

            _unprepare_bombable_entity(CUSTOM_MEMORY.BOMBABLE_OBJECT_1);
            _unprepare_bombable_entity(CUSTOM_MEMORY.BOMBABLE_OBJECT_2);
            _unprepare_bombable_entity(CUSTOM_MEMORY.BOMBABLE_OBJECT_3);
            _unprepare_bombable_entity(CUSTOM_MEMORY.BOMBABLE_OBJECT_4);
            _unprepare_bombable_entity(CUSTOM_MEMORY.BOMBABLE_OBJECT_5);
            _unprepare_bombable_entity(CUSTOM_MEMORY.BOMBABLE_OBJECT_6);
            _unprepare_bombable_entity(CUSTOM_MEMORY.BOMBABLE_OBJECT_7);
            _unprepare_bombable_entity(CUSTOM_MEMORY.BOMBABLE_OBJECT_8);
            _unprepare_bombable_entity(CUSTOM_MEMORY.BOMBABLE_OBJECT_9);
            _unprepare_bombable_entity(CUSTOM_MEMORY.BOMBABLE_OBJECT_10);
            _unprepare_bombable_entity(CUSTOM_MEMORY.BOMBABLE_OBJECT_11);
            _unprepare_bombable_entity(CUSTOM_MEMORY.BOMBABLE_OBJECT_12);
        }
    }

    fun _vanilla_bomb_explosion(invincible) {
        if(invincible) {
            if(dead(CUSTOM_MEMORY.BOMBABLE_OBJECT_1)) {
                CUSTOM_MEMORY.BOMBABLE_OBJECT_1 = 0x0000;
            }
            if(dead(CUSTOM_MEMORY.BOMBABLE_OBJECT_2)) {
                CUSTOM_MEMORY.BOMBABLE_OBJECT_2 = 0x0000;
            }
            if(dead(CUSTOM_MEMORY.BOMBABLE_OBJECT_3)) {
                CUSTOM_MEMORY.BOMBABLE_OBJECT_3 = 0x0000;
            }
            if(dead(CUSTOM_MEMORY.BOMBABLE_OBJECT_4)) {
                CUSTOM_MEMORY.BOMBABLE_OBJECT_4 = 0x0000;
            }
            if(dead(CUSTOM_MEMORY.BOMBABLE_OBJECT_5)) {
                CUSTOM_MEMORY.BOMBABLE_OBJECT_5 = 0x0000;
            }
            if(dead(CUSTOM_MEMORY.BOMBABLE_OBJECT_6)) {
                CUSTOM_MEMORY.BOMBABLE_OBJECT_6 = 0x0000;
            }
            if(dead(CUSTOM_MEMORY.BOMBABLE_OBJECT_7)) {
                CUSTOM_MEMORY.BOMBABLE_OBJECT_7 = 0x0000;
            }
            if(dead(CUSTOM_MEMORY.BOMBABLE_OBJECT_8)) {
                CUSTOM_MEMORY.BOMBABLE_OBJECT_8 = 0x0000;
            }
            if(dead(CUSTOM_MEMORY.BOMBABLE_OBJECT_9)) {
                CUSTOM_MEMORY.BOMBABLE_OBJECT_9 = 0x0000;
            }
            if(dead(CUSTOM_MEMORY.BOMBABLE_OBJECT_10)) {
                CUSTOM_MEMORY.BOMBABLE_OBJECT_10 = 0x0000;
            }
            if(dead(CUSTOM_MEMORY.BOMBABLE_OBJECT_11)) {
                CUSTOM_MEMORY.BOMBABLE_OBJECT_11 = 0x0000;
            }
            if(dead(CUSTOM_MEMORY.BOMBABLE_OBJECT_12)) {
                CUSTOM_MEMORY.BOMBABLE_OBJECT_12 = 0x0000;
            }
        }

        if(CUSTOM_MEMORY.BOMBABLE_OBJECT_1) {
            attribute(CUSTOM_MEMORY.BOMBABLE_OBJECT_1, INVINCIBLE_TEMP, invincible);
        }
        if(CUSTOM_MEMORY.BOMBABLE_OBJECT_2) {
            attribute(CUSTOM_MEMORY.BOMBABLE_OBJECT_2, INVINCIBLE_TEMP, invincible);
        }
        if(CUSTOM_MEMORY.BOMBABLE_OBJECT_3) {
            attribute(CUSTOM_MEMORY.BOMBABLE_OBJECT_3, INVINCIBLE_TEMP, invincible);
        }
        if(CUSTOM_MEMORY.BOMBABLE_OBJECT_4) {
            attribute(CUSTOM_MEMORY.BOMBABLE_OBJECT_4, INVINCIBLE_TEMP, invincible);
        }
        if(CUSTOM_MEMORY.BOMBABLE_OBJECT_5) {
            attribute(CUSTOM_MEMORY.BOMBABLE_OBJECT_5, INVINCIBLE_TEMP, invincible);
        }
        if(CUSTOM_MEMORY.BOMBABLE_OBJECT_6) {
            attribute(CUSTOM_MEMORY.BOMBABLE_OBJECT_6, INVINCIBLE_TEMP, invincible);
        }
        if(CUSTOM_MEMORY.BOMBABLE_OBJECT_7) {
            attribute(CUSTOM_MEMORY.BOMBABLE_OBJECT_7, INVINCIBLE_TEMP, invincible);
        }
        if(CUSTOM_MEMORY.BOMBABLE_OBJECT_8) {
            attribute(CUSTOM_MEMORY.BOMBABLE_OBJECT_8, INVINCIBLE_TEMP, invincible);
        }
        if(CUSTOM_MEMORY.BOMBABLE_OBJECT_9) {
            attribute(CUSTOM_MEMORY.BOMBABLE_OBJECT_9, INVINCIBLE_TEMP, invincible);
        }
        if(CUSTOM_MEMORY.BOMBABLE_OBJECT_10) {
            attribute(CUSTOM_MEMORY.BOMBABLE_OBJECT_10, INVINCIBLE_TEMP, invincible);
        }
        if(CUSTOM_MEMORY.BOMBABLE_OBJECT_11) {
            attribute(CUSTOM_MEMORY.BOMBABLE_OBJECT_11, INVINCIBLE_TEMP, invincible);
        }
        if(CUSTOM_MEMORY.BOMBABLE_OBJECT_12) {
            attribute(CUSTOM_MEMORY.BOMBABLE_OBJECT_12, INVINCIBLE_TEMP, invincible);
        }
    }

    @install()
    @weak()
    fun vanilla_bomb_explosion(fake_bomb) {
        if(fake_bomb) {
            if(False) {
                animate(SCRIPT_OWNER, ONCE, ANIMATION_PLACEHOLDER.EXPLOSION_1);
            } else {
                single_animation(<SCRIPT_OWNER>, EXPLOSION_1, 0d0, 0d1);
            }
            
            damage(SCRIPT_OWNER, BOMB.TRIGGER_DAMAGE, False);
            attach_to_script(LAST_ENTITY);
        }

        sleep(BOMB.DELAY_TRIGGER);

        _vanilla_bomb_explosion(False);
        
        bomb_entity(<SCRIPT_OWNER>, BOMB.RANGE, BOMB.DAMAGE_BOY);
        if(CUSTOM_FLAG.VANILLA_BOMB_DAMAGE) {
            bomb_entity_entity(BOY, <SCRIPT_OWNER>, BOMB.RANGE, BOMB.DAMAGE_VANILLA);
        } else {
            bomb_entity_entity(BOY, <SCRIPT_OWNER>, BOMB.RANGE);
        }

        yield();
        _vanilla_bomb_explosion(True);

        if(!fake_bomb) {
            sleep(BOMB.DELAY_CLEANUP);
            destroy(<SCRIPT_OWNER>);
        }
    }

    fun _fake_b() { // TODO: remove
        code(0x78, entity_t(CHARACTER.ACTIVE), 0x0000 + ANIMATION_ALL.SLASH_1, param(ANIMATION_MODE.ONCE), "// (78) UNTRACED INSTR for $2846, 0x0010 2 changes sprite/animation/...?");
    }

    fun bark() {
        animate(DOG, ONCE, ANIMATION_DOG.ACT1_BARK);
        sound(DOG_ATTACK);
    }

    fun _bombable_object_error(error:ERROR_TYPE) {
        if(error) {
            error_message(error);
        } else {
            error_message(DOOR_LOCKED);
        }
    }
    @install()
    @weak()
    fun _bombable_object(type:RETAINABLE_OBJECT, permission, error:ERROR_TYPE) {
        CUSTOM_MEMORY.RETURN = False;

        if(SYSTEM.WITH_DEBUG_BOMBABLE) {
            _debug_memory(<SCRIPT_OWNER>, <ACTIVE>, <BOY>);
            sleep(0d60);
        }

        if(<SCRIPT_OWNER> == <ACTIVE>) {
            if(SYSTEM.WITH_DEBUG_BOMBABLE) {
                MEMORY.STRING_PARAMETER_1 = type;
                _subtext("object ([MEM1])");
                sleep(0d120);
            }

            if((type == RETAINABLE_OBJECT.WALL_AXE2) || (type == RETAINABLE_OBJECT.WALL_AXE3)) {
                if(type == RETAINABLE_OBJECT.WALL_AXE2) {
                    guard_weapon(AXE_2, AXE);
                } else if(type == RETAINABLE_OBJECT.WALL_AXE3) {
                    guard_weapon(AXE_3, AXE);
                }

                explode_barrier(<BOY>);
            } else if((type == RETAINABLE_OBJECT.DOOR_TRIGGER) || (type == RETAINABLE_OBJECT.DOOR)) {
                if!(permission) {
                    _bombable_object_error(error);
                    end();
                } else {
                    nop(); // smart_sound(DOOR);
                }
            } else if(type == RETAINABLE_OBJECT.ILLUSION) {
                if!(permission) {
                    end();
                } else {
                    sound(WEIRD_SOUND);
                }
            } else {
                end();
            }
        } else if(<SCRIPT_OWNER>[HP] > 0d0) { // if(script[0x9] == SCRIPT9.ALIVE)
            if(SYSTEM.WITH_DEBUG_BOMBABLE) {
                _subtext("bombable-b");
                sleep(0d120);
            }
            
            if((type == RETAINABLE_OBJECT.WALL_AXE2_FAKE) || (type == RETAINABLE_OBJECT.WALL_AXE3_FAKE)) {
                if(type == RETAINABLE_OBJECT.WALL_AXE2_FAKE) {
                    guard_weapon(AXE_2, AXE);
                } else if(type == RETAINABLE_OBJECT.WALL_AXE3_FAKE) {
                    guard_weapon(AXE_3, AXE);
                }

                destroy(SCRIPT_OWNER);

                explode_barrier(<BOY>);
            } else if(type == RETAINABLE_OBJECT.DOOR_FAKE) {
                if!(permission) {
                    _bombable_object_error(error);
                    end();
                } else {
                    nop(); // smart_sound(DOOR);
                }
            } else {
                _fake_b();
                end();
            }
        } else {
            if(SYSTEM.WITH_DEBUG_BOMBABLE) {
                _subtext("bombable-damage");
                sleep(0d120);
            }

            if((type == RETAINABLE_OBJECT.WALL_AXE2_FAKE) || (type == RETAINABLE_OBJECT.WALL_AXE3_FAKE)) {
                destroy(SCRIPT_OWNER);
            }
        }

        CUSTOM_MEMORY.RETURN = True;
    }
    fun bombable_object(type:RETAINABLE_OBJECT, permission, flag, object_id, value) {
        if(flag !is None) {
            if(flag) {
                if(type != RETAINABLE_OBJECT.DOOR_TRIGGER) {
                    if((<SCRIPT_OWNER> != <BOY>) && (<SCRIPT_OWNER>[HP] > 0d0)) {
                        _fake_b();
                    }

                    unprepare_bombable_entity(<SCRIPT_OWNER>);
                    end();
                } else {
                    if((<SCRIPT_OWNER> != <BOY>) && (<SCRIPT_OWNER>[HP] > 0d0)) {
                        _fake_b();

                        unprepare_bombable_entity(<SCRIPT_OWNER>);
                        end();
                    } else if(type == RETAINABLE_OBJECT.DOOR_TRIGGER) {
                        if(object_id is Function) {
                            object_id();
                            end();
                        }
                    }
                }
            }
        }

        if(SYSTEM.WITH_DEBUG_BOMBABLE) {
            _debug_memory(<SCRIPT_OWNER>, <ACTIVE>, <BOY>);
            sleep(0d60);
        }
        
        _bombable_object(type, permission);

        if(CUSTOM_MEMORY.RETURN) {
            if(flag is Memory) {
                flag = True;
            }
            
            if(object_id is Function) {
                if(type == RETAINABLE_OBJECT.DOOR_TRIGGER) {
                    if(<SCRIPT_OWNER> == <ACTIVE>) {
                        object_id();
                    }
                }
            } else if(object_id !is None) {
                if(value !is None) {
                    object[object_id] = value;
                } else {
                    object[object_id] = 0d0;
                }
            }
        } else {
            end();
        }
    }
    fun bombable_trigger(permission, flag, error:ERROR_TYPE, callback, object_id, value) {
        if(flag !is None) {
            if(flag) {
                if((<SCRIPT_OWNER> != <BOY>) && (<SCRIPT_OWNER>[HP] > 0d0)) {
                    _fake_b();

                    unprepare_bombable_entity(<SCRIPT_OWNER>);
                } else {
                    callback();
                }
                end();
            }
        }

        _bombable_object(DOOR_TRIGGER, permission, error);

        if(CUSTOM_MEMORY.RETURN) {
            if(flag is Memory) {
                flag = True;
            }
            
            if(<SCRIPT_OWNER> == <ACTIVE>) {
                callback();
            }
            if(object_id !is None) { // TODO: should be "else"
                if(<SCRIPT_OWNER> != <ACTIVE>) {
                    if(value !is None) {
                        object[object_id] = value;
                    } else {
                        object[object_id] = 0d0;
                    }
                }
            }
        } else {
            end();
        }
    }

    fun add_bombable(x, y, flag, trigger, entity_sprite:ENEMY, entity_animation:ANIMATION_PLACEHOLDER) {
        if!(flag) {
            if(False) {
                add_enemy(THRAXX2_HEART, x, y, BOMBABLE);
            } else {
                if(entity_sprite !is None) {
                    add_enemy(entity_sprite, x, y, BOMBABLE);
                    if(entity_animation !is None) {
                        animate(LAST_ENTITY, LOOP, entity_animation);
                    }
                    attribute(LAST_ENTITY, INVINCIBLE, False);
                } else {
                    add_enemy(RIMSALA_STATUTE_ENTITY, x, y, BOMBABLE);
                }
            }

            prepare_bombable_entity(<LAST_ENTITY>);
            
            attach_script(LAST_ENTITY, B_DEATH, trigger);
        }
    }

    fun add_bombable_double_door(x, y, flag, trigger, door_width) {
        add_bombable(x, y + 0d1, flag, trigger);

        add_bombable(x, y + door_width - 0d1, flag, trigger);
    }

};