group hole() {
    enum HOLE {
        DEBUG = False,
    }

    enum HOLE_SIZE {
        NONE = 0d0,

        SMALL = 0d1,
        NORMAL = 0d7,
        BIG = 0d10,
    }

    fun add_hole(size:HOLE_SIZE) {
        _add_placeholder(SANDPIT_PUKE, <BOY>[X], <BOY>[Y]);
        sleep(size);
        animate(LAST_ENTITY, PAUSE, DEFAULT);
    }
    fun _animate_hole(entity, size:HOLE_SIZE) {
        if(HOLE.DEBUG) {
            _debug_memory(entity, size);
        }

        animate(entity, ONCE, ANIMATION_PLACEHOLDER.SANDPIT_PUKE);
        sleep(size);
        animate(entity, PAUSE, DEFAULT);
    }
    @install()
    @async()
    @weak()
    fun animate_hole(entity, size:HOLE_SIZE) {
        _animate_hole(entity, size);
    }
};
