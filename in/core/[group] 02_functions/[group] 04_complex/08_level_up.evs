group level_up() {
    @install()
    @weak()
    fun level_up(character:CHARACTER, price) {
        item_pay(MONEY, MEMORY.BOY_LEVEL * price, False);

        if(False) {
            debug_memory(CUSTOM_MEMORY.RETURN, arg[0x10]);
        }

        if(CUSTOM_MEMORY.RETURN) {
            if((character == CHARACTER.BOY) || (character == CHARACTER.BOTH)) {
                MEMORY.BOY_XP_REQUIRED = 0d1;
            }

            if((character == CHARACTER.DOG) || (character == CHARACTER.BOTH)) {
                MEMORY.DOG_XP_REQUIRED = 0d1;
            }

            if(False) {
                _add_colored_enemy(MOSQUITO, BOY, <ACTIVE>[X], <ACTIVE>[Y], INACTIVE_INVISIBLE);
            } else {
                _add_enemy(MOSQUITO, <ACTIVE>[X], <ACTIVE>[Y], INACTIVE_INVISIBLE);
            }
            attach_to_script(LAST_ENTITY);
            attribute(SCRIPT_OWNER, MUTE, True);

            damage(SCRIPT_OWNER, SYSTEM.HP_MAX, False);
            // teleport(SCRIPT_OWNER, 0d0, 0d0);

            clean_up(<SCRIPT_OWNER>);
        }
    }
};
