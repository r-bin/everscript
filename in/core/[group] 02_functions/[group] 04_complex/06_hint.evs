group hint() {
    enum HINT {
        PRESS_START = 0x00,
        PRESS_R = 0x01,
    }

    fun _hint(condition, callback) {
        // arg[0x12] = False;

        while!(arg[0x12]) {
            if(arg[0x10] > 0d180) {
                arg[0x10] = 0d0;

                callback();
            } else if!(condition) {
                arg[0x10]++;
            } else {
                end();
            }

            yield();
        }
    }
    @install()
    @weak()
    @async()
    fun hint(hint:HINT) {
        if(hint == HINT.PRESS_START) {
            _hint(CUSTOM_MEMORY.INPUT_P1 & INPUT.START, { subtext("Press the [START] Button"); });
        } else if(hint == HINT.PRESS_R) {
            _hint(CUSTOM_MEMORY.INPUT_P1 & INPUT.R, { subtext("Press the [R] Button"); });
        }
    }
};
