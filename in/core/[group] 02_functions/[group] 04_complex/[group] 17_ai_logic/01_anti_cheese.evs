group anti_cheese() {
    fun _anti_cheese_mosquito_callback(entity) {
        arg[0x10] = <ACTIVE>[X];
        arg[0x12] = <ACTIVE>[Y];

        walk(entity, COORDINATE_ABSOLUTE, <ACTIVE>[X], <ACTIVE>[Y], False, False);
        
        arg[0x16] = 0d0;
        while((arg[0x16] < 0d120) && !((entity[X] == arg[0x10]) && (entity[Y] == arg[0x12]))) {
            arg[0x16]++;

            yield();
        }

        control(entity, False);
    }
    fun _anti_cheese_mosquito(entity, callback) {
        attach_to_script(entity);

        while(alive(entity)) {
            while!(entity[FLAGS_7] & ATTRIBUTE_FLAGS.WALKING) {
                yield();
            }

            arg[0x10] = entity[X];
            arg[0x12] = entity[Y];

            sleep(0d5);

            if(
                (entity[X] == arg[0x10]) && (entity[Y] == arg[0x12])
                || ((entity[Y] < MEMORY.CAMERA_BOUNDRY_Y_START) || (entity[Y] == 0d0))
                || (entity[X] > MEMORY.CAMERA_BOUNDRY_X_END)
                || (entity[Y] > MEMORY.CAMERA_BOUNDRY_Y_END)
                || ((entity[X] < MEMORY.CAMERA_BOUNDRY_X_START) || (entity[X] == 0d0))
            ) {
                if(callback !is None) {
                    callback();
                } else {
                    _anti_cheese_mosquito_callback(entity);
                }
            }
        }
    }
    @install()
    @async()
    @weak()
    fun anti_cheese_mosquito(entity) {
        _anti_cheese_mosquito(entity);
    }

    fun _anti_cheese_magic_spam_callback(entity) {
        while(entity[FLAGS_2] & ATTRIBUTE_FLAGS.HEALED) {
            yield();
        }
    }
    fun _anti_cheese_magic_spam(entity, callback) {
        attach_to_script(entity);
        
        while(alive(entity)) {
            if(entity[FLAGS_2] & ATTRIBUTE_FLAGS.HEALED) {
                arg[0x10] += 0d3;
            } else if(arg[0x10] > 0d0) {
                arg[0x10]--;
            }

            if(arg[0x10] > 0d400) {
                arg[0x10] = 0d0;

                if(callback !is None) {
                    callback();
                } else {
                    _anti_cheese_magic_spam_callback(entity);
                }
            }

            sleep(0d5);

            if(False) {
                _debug_memory(arg[0x10], entity[FLAGS_2] & ATTRIBUTE_FLAGS.HEALED);
            }
        }
    }
    @install()
    @async()
    @weak()
    fun anti_cheese_magic_spam(entity) {
        _anti_cheese_magic_spam(entity);
    }
};
