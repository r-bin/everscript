group shared() {
    fun smart_timer(memory, time, condition, callback) {
        memory = 0d0;

        if(False) {
            _debug_memory(memory, time, condition);
            sleep(0d60);
        }

        while((memory < time) && (condition)) {
            memory++;

            if(callback is Function) {
                callback();
            }

            yield();
        }

        if(False) {
            _debug_memory(memory, time, condition);
            sleep(0d60);
        }
    }
};
