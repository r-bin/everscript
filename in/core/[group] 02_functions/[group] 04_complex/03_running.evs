group running() {
    fun update_no_running() {
        if(CUSTOM_MEMORY.NO_RUNNING > 0d0) {
            CUSTOM_FLAG.NO_RUNNING = True;
        } else {
            CUSTOM_FLAG.NO_RUNNING = False;
        }

        if(False) {
            _debug_memory(CUSTOM_MEMORY.NO_RUNNING, CUSTOM_FLAG.NO_RUNNING);
        }
    }
    fun _increment_no_running() {
        CUSTOM_MEMORY.NO_RUNNING++;

        update_no_running();
    }
    fun increment_no_running(flag) {
        if(flag is Memory) {
            if!(flag) {
                flag = True;

                _increment_no_running(flag);
            }
        } else {
            _increment_no_running();
        }
    }
    fun _decrement_no_running() {
        if(CUSTOM_MEMORY.NO_RUNNING > 0d0) {
            CUSTOM_MEMORY.NO_RUNNING--;
        }

        update_no_running();
    }
    fun decrement_no_running(flag) {
        if(flag is Memory) {
            if(flag) {
                flag = False;

                _decrement_no_running(flag);
            }
        } else {
            _decrement_no_running();
        }
    }
};
