group sprite_stacking() {
    @install()
    @async()
    @weak()
    fun _stack_sprite(entity_mount, entity_rider, offset_x, offset_y) {
        while(_alive(entity_mount)) {
            _teleport(entity_rider, entity_mount[X] + offset_x, entity_mount[Y] - offset_y);

            yield();
        }
    }
    @install()
    @async()
    @weak()
    fun stack_sprite(entity_mount, entity_rider, offset_x, offset_y) {
        while(alive(entity_mount)) {
            _teleport(entity_rider, entity_mount[X] + offset_x, entity_mount[Y] - offset_y);

            yield();
        }
    }
};
