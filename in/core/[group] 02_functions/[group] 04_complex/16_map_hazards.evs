group map_hazards() {
    fun _desert_damage(interval, tick_damage, condition_avoid_boy, condition_avoid_dog) {
        while(True) {
            sleep(interval);

            if(condition_avoid_boy !is None) {
                if!(condition_avoid_boy) {
                    damage(BOY, tick_damage, True, True);        
                }
            } else {
                damage(BOY, tick_damage, True, True);
            }
            if(condition_avoid_dog !is None) {
                if!(condition_avoid_dog) {
                    damage(DOG, tick_damage, True, True);        
                }
            } else {
                damage(DOG, tick_damage, True, True);
            }
        }
    }
    @install()
    @async()
    @weak()
    fun desert_damage(interval, tick_damage) {
        _desert_damage(interval, tick_damage);
    }
};
