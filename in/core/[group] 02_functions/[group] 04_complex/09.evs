group shared() {
    @install()
    @weak()
    fun cast_team(character, spell:CAST, level, skip_dead_dog, rand_range) {
        if(rand_range > 0d0) {
            arg[0x10] = randrange(rand_range);
        } else {
            arg[0x10] = randrange(0d4);
        }
    
        if(arg[0x10] == 0d0) {
            cast(character, BOY, spell, level);
        } else if(arg[0x10] == 0d1) {
            if(skip_dead_dog == True && <DOG>[HP] <= 0d0) {
                cast(character, BOY, spell, level);
            } else {
                cast(character, DOG, spell, level);
            }
        } else {
            cast(character, BOTH, spell, level);
        }
    }
    
    fun loot(animation:ADDRESS_ID, flag, object_id, loot_reward:LOOT_REWARD, amount, next) {
        if(flag) {
            end();
        }
    
        if(loot_reward is Function) {
            if(True) {
                MEMORY.LOOT_ITEM = LOOT_REWARD.NOTHING;
                MEMORY.LOOT_OBJECT = object_id;
    
                enable_subtext(False);
                call_id(animation);
                enable_subtext(True);
            } else {
                if(animation == ADDRESS_ID.LOOT_SNIFF) {
                    fake_loot();
                } else {
                    fake_loot_gourd();
                }
            }
    
            loot_reward();
    
            if(flag is Memory) {
                flag = True;
            }
        } else {
            if(loot_reward < 0x1000) {
                MEMORY.LOOT_ITEM = loot_reward;
    
                MEMORY.LOOT_OBJECT = object_id;
    
                if(loot_reward < 0x0100) { 
                    if(amount > 0d0) {
                        MEMORY.LOOT_AMOUNT_CURRENCY = amount;
                    }
                } else {
                    if(amount > 0d1) {
                        MEMORY.LOOT_AMOUNT = amount - 0d1;
                    }
                }
    
                call_id(animation);
                
                if(next > 0d0) {
                    MEMORY.LOOT_AMOUNT = next;
                }
    
                if(flag is Memory) {
                    if(FLAG.LOOT_SUCCESSFUL) {
                        flag = True;
                    }
                }
            } else {
                MEMORY.LOOT_ITEM = LOOT_REWARD.NOTHING;
                MEMORY.LOOT_OBJECT = object_id;
    
                enable_subtext(False);
                call_id(animation);
                enable_subtext(True);
    
                if(next > 0d0) {
                    MEMORY.LOOT_AMOUNT = next;
                }
    
                if(FLAG.LOOT_SUCCESSFUL) {
                    if(loot_reward == LOOT_REWARD.SPOON) {
                        MEMORY.SPOON += amount;
    
                        subtext("Found a Spoon");
                    } else if(loot_reward == LOOT_REWARD.TICKET_FOR_EXHIBITION) {
                        MEMORY.TICKET_FOR_EXHIBITION += amount;
    
                        subtext("Found a Ticket");
                    } else if(loot_reward == LOOT_REWARD.LIMESTONE_TABLET) {
                        MEMORY.LIMESTONE_TABLET += amount;
    
                        subtext("Found a Limestone Tablet");
                    } else if(loot_reward == LOOT_REWARD.JEWELED_SCARAB) {
                        MEMORY.JEWELED_SCARAB += amount;
    
                        subtext("Found a Jeweled Scarab");
                    } else if(loot_reward == LOOT_REWARD.GOLDEN_JACKAL) {
                        MEMORY.GOLDEN_JACKAL += amount;
    
                        subtext("Found a Golden Jackal");
                    } else if(loot_reward == LOOT_REWARD.BAZOOKA) {
                        MEMORY.GAIN_WEAPON = GAIN_WEAPON.BAZOOKA_1;
    
                        subtext("Found a Bazooka");
                    } else if(loot_reward == LOOT_REWARD.CHOCOBO_EGG) {
                        unlock(CHOCOBO_EGG);
    
                        subtext("Found a Chocobo Egg");
                    }
    
                    if(flag is Memory) {
                        flag = True;
                    }
                }
            }
        }
    }
};
