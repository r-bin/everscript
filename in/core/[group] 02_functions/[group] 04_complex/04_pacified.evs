group pacified() {
    fun update_pacified() {
        if(CUSTOM_MEMORY.PACIFIED > 0d0) {
            MEMORY.PACIFIED = True;
        } else {
            MEMORY.PACIFIED = False;
        }

        if(False) {
            _debug_memory(CUSTOM_MEMORY.PACIFIED, MEMORY.PACIFIED);
        }
    }
    fun _increment_pacified() {
        CUSTOM_MEMORY.PACIFIED++;

        update_pacified();
    }
    fun increment_pacified(flag) {
        if(flag is Memory) {
            if!(flag) {
                flag = True;

                _increment_pacified();
            }
        } else {
            _increment_pacified();
        }
    }
    fun _decrement_pacified() {
        if(CUSTOM_MEMORY.PACIFIED > 0d0) {
            CUSTOM_MEMORY.PACIFIED--;
        }

        update_pacified();
    }
    fun decrement_pacified(flag) {
        if(flag is Memory) {
            if(flag) {
                flag = False;

                _decrement_pacified();
            }
        } else {
            _decrement_pacified();
        }
    }
};
