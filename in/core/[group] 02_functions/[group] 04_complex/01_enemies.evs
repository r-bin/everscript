group enemies() {
    fun _clean_up(entity:CHARACTER) {
        if(dead(entity)) {
            wait(entity);

            destroy(entity);
            subtext("cleaned up");
        } else {
            subtext("not cleaned up");
        }
    }
    fun clean_up(entity, callback) {
        if(entity[HP] <= 0d0) {
            if(callback !is None) {
                callback();
            }
            
            wait(entity);

            destroy(entity);
        }
    }
};
