group error_messages() {
    enum ERROR_TYPE {
        UNKNOWN = 0x00,
        DLC = 0x01,
        WRONG_WEAPON = 0x02,
        TOO_LIGHT = 0x03,
        TOO_NARROW = 0x04,

        DOOR_LOCKED = 0x10,
        DOOR_CONTRAPTION = 0x11,
        DOOR_WRONG_SIDE = 0x12,
        DOOR_COMPLETED = 0x13,
        DOOR_REQUIRES_DIG = 0x14,

        SWITCH_STUCK = 0x20,
        SWITCH_ENERGY = 0x21,
    }

    fun error_walk_back(exit_direction:DIRECTION) {
        if(exit_direction == DIRECTION.NORTH) {
            walk(ACTIVE, TILE_RELATIVE_DIRECT, 0d0, -0d2, ACTIVE, BOTH);
        } else if(exit_direction == DIRECTION.EAST) {
            walk(ACTIVE, TILE_RELATIVE_DIRECT, 0d2, 0d0, ACTIVE, BOTH);
        } else if(exit_direction == DIRECTION.SOUTH) {
            walk(ACTIVE, TILE_RELATIVE_DIRECT, 0d0, 0d2, ACTIVE, BOTH);
        } else if(exit_direction == DIRECTION.WEST) {
            walk(ACTIVE, TILE_RELATIVE_DIRECT, -0d2, 0d0, ACTIVE, BOTH);
        }
    }

    @install()
    @weak()
    fun error_message(error:ERROR_TYPE, direction:DIRECTION) {
        if(error > 0xff) {
            direction = (error >> 0x8);
            error &= 0xff;
        }
        
        if(error == ERROR_TYPE.DLC) {
            subtext("DLC content…");
        } else if(error == ERROR_TYPE.WRONG_WEAPON) {
            if(SYSTEM.WITH_HINT_INTERACTION) {
                subtext("(Wrong weapon…)");
            }
        } else if(error == ERROR_TYPE.TOO_LIGHT) {
            if(SYSTEM.WITH_HINT_INTERACTION) {
                subtext("(Too light…)");
            }
        } else if(error == ERROR_TYPE.TOO_NARROW) {
            if(SYSTEM.WITH_HINT_INTERACTION) {
                subtext("(Too narrow…)");
            }
        } else if(error == ERROR_TYPE.DOOR_LOCKED) {
            subtext("Locked.");
        } else if(error == ERROR_TYPE.DOOR_CONTRAPTION) {
            subtext("Locked by some contraption.");
        } else if(error == ERROR_TYPE.DOOR_WRONG_SIDE) {
            subtext("Does not open from this side.");
        } else if(error == ERROR_TYPE.DOOR_COMPLETED) {
            subtext("Does not open anymore.");
        } else if(error == ERROR_TYPE.DOOR_REQUIRES_DIG) {
            subtext("Filled with rubble.");
        } else if(error == ERROR_TYPE.SWITCH_STUCK) {
            subtext("Does not move.");
        } else if(error == ERROR_TYPE.SWITCH_ENERGY) {
            subtext("Not enough power.");
        } else {
            subtext("…");
        }

        if(direction) {
            error_walk_back(direction);
        }
    }
};
