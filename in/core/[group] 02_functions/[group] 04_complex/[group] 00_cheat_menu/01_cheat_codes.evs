group cheat_codes() {
    fun init_cheat_page() {
        open_message_box(TRANSPARENT_CENTERED, 0x04 - 0d2, 0x04, 0x18 + 0d2, 0x14 + 0d2);
    }

    fun code() {
        while(True) {
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.NONE) {
                yield();
            }
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.UP) {
                yield();
            }
            subtext("up");
            
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.NONE) {
                yield();
            }
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.UP) {
                yield();
            }
            subtext("up");
            
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.NONE) {
                yield();
            }
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.DOWN) {
                yield();
            }
            subtext("down");
            
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.NONE) {
                yield();
            }
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.DOWN) {
                yield();
            }
            subtext("down");
            
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.NONE) {
                yield();
            }
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.LEFT) {
                yield();
            }
            subtext("left");
            
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.NONE) {
                yield();
            }
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.RIGHT) {
                yield();
            }
            subtext("right");
            
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.NONE) {
                yield();
            }
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.LEFT) {
                yield();
            }
            subtext("left");
            
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.NONE) {
                yield();
            }
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.RIGHT) {
                yield();
            }
            subtext("right");
            
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.NONE) {
                yield();
            }
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.B) {
                yield();
            }
            subtext("b");
            
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.NONE) {
                yield();
            }
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.A) {
                yield();
            }
            subtext("a");
            
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.NONE) {
                yield();
            }
            while(CUSTOM_MEMORY.INPUT_P1 != INPUT.START) {
                yield();
            }
            subtext("start");

            sleep(0d60);

            subtext("yay");
            
            yield();
        }
    }
    fun check_code_konami(position, input, callback) {
        if!(input) {
            nop();
        } else if(
            ((position == 0d0) && (input == INPUT.UP))
            || ((position == 0d1) && (input == INPUT.UP))
            || ((position == 0d2) && (input == INPUT.DOWN))
            || ((position == 0d3) && (input == INPUT.DOWN))
            || ((position == 0d4) && (input == INPUT.LEFT))
            || ((position == 0d5) && (input == INPUT.RIGHT))
            || ((position == 0d6) && (input == INPUT.LEFT))
            || ((position == 0d7) && (input == INPUT.RIGHT))
            || ((position == 0d8) && (input == INPUT.B))
            || ((position == 0d9) && (input == INPUT.A))
        ) {
            if(False) {
                debug_memory(MEMORY.INPUT_P1, input, position);
            }

            position++;
        } else if(((position == 0d10) && (input == INPUT.START))) {
            position = 0xff;

            if(False) {
                subtext("konami!");
            }

            if(callback !is None) {
                sound(WEIRD_SOUND);

                callback();
            }
        } else {
            position = 0d0;

            if(False) {
                debug_memory(MEMORY.INPUT_P1, input, 0xffff);
            }
        }
    }
    fun check_code_leftright(position, input) {
        if(
            ((position == 0d0) && (input == INPUT.LEFT))
            || ((position == 0d1) && (input == INPUT.RIGHT))
            || ((position == 0d2) && (input == INPUT.LEFT))
            || ((position == 0d3) && (input == INPUT.RIGHT))
        ) {
            position++;
        } else if(((position == 0d4) && (input == INPUT.START))) {
            position = 0xff;

            subtext("left right!");
            end();
        } else {
            position = 0d0;
        }
    }
    fun advanced_code() {
        control(NONE);

        while(arg[0x10] < 0d30) {
            if!((CUSTOM_MEMORY.INPUT_P1 & (INPUT.L | INPUT.R)) == (INPUT.L | INPUT.R)) {
                arg[0x10]++;
            }

            arg[0x12] = CUSTOM_MEMORY.INPUT_P1 & (~(INPUT.L | INPUT.R));
            
            if(True) {
                if(arg[0x14] < 0d0) {
                    arg[0x14]++;
                } else if(arg[0x12] == 0x0000) {
                    arg[0x14] = 0d0;
                } else if(arg[0x14] < 0d3) {
                    arg[0x14]++;
                } else if(arg[0x14] == 0d3) {
                    check_code_konami(arg[0x16], arg[0x12]);
                    check_code_leftright(arg[0x18], arg[0x12]);

                    arg[0x14] = -0d3;

                    if(False) {
                        debug_memory(arg[0x14], arg[0x12], arg[0x16]);
                    }
                }
            }

            yield();

            // debug_memory(arg[0x12], arg[0x14], arg[0x16]);
            // debug_memory(arg[0x0e], arg[0x14], arg[0x16]);
        }
    }
};
