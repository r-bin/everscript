group position_manipulation() {
    fun _move_towards(entity, entity_target, distance, with_collision) {
        if(entity[X] > entity_target[X]) {
            arg[0x10] = entity[X] - entity_target[X];

            if(arg[0x10] > distance) {
                arg[0x10] = distance;
            }

            arg[0x10] = -(arg[0x10]);
        } else if(entity[X] < entity_target[X]) {
            arg[0x10] = entity_target[X] - entity[X];

            if(arg[0x10] > distance) {
                arg[0x10] = distance;
            }
        } else {
            arg[0x10] = 0d0;
        }

        if(entity[Y] > entity_target[Y]) {
            arg[0x12] = entity[Y] - entity_target[Y];

            if(arg[0x12] > distance) {
                arg[0x12] = distance;
            }

            arg[0x12] = -(arg[0x12]);
        } else if(entity[Y] < entity_target[Y]) {
            arg[0x12] = entity_target[Y] - entity[Y];

            if(arg[0x12] > distance) {
                arg[0x12] = distance;
            }
        } else {
            arg[0x12] = 0d0;
        }
        yield();

        if(with_collision) {
            teleport_relative(entity, arg[0x10], arg[0x12]);
        } else {
            _teleport(entity, entity[X] + arg[0x10], entity[Y] + arg[0x12]);
        }
    }
    @install()
    @weak()
    fun move_towards(entity, entity_target, distance, with_collision) {
        _move_towards(entity, entity_target, distance, with_collision);
    }
};
