group act_2() {
    fun act2_arena_bridge_show(show) {
        if(show) {
            object[0x00] = 0x01;
        } else {
            object[0x00] = 0x00;
        }
    }
    @install()
    @async()
    @weak()
    fun act2_arena_bridge_entrance() {
        sleep(0d15);

        act2_arena_bridge_show(True);

        sleep(0d30);

        act2_arena_bridge_show(False);
    }

    fun _act2_axe2_wall(door_id, flag) {
        guard_axe_2();

        animate(BOY, ONCE, ANIMATION_ALL.SLASH_2);
        object_animator(AXE2_DOOR, flag, door_id, True, False);
    }
    @install()
    @weak()
    fun act2_axe2_wall(door_id) {
        _act2_axe2_wall(door_id, False);
    }

    fun act2_snake_trap(x, y, object_id, right_looking) {
        if(right_looking) {
            add_enemy(SNAKE_STATUE_LEFT, x, y);
            animate(LAST_ENTITY, FREEZE, ANIMATION_ENEMY.STONE_SNAKE_AWAKE_RIGHT_1);
        } else {
            add_enemy(SNAKE_STATUE_RIGHT, x, y);
            animate(LAST_ENTITY, FREEZE, ANIMATION_ENEMY.STONE_SNAKE_AWAKE_LEFT_1);
        }
        
        yield();
        sound(FLOWER_ATTACK);

        if(right_looking) {
            animate(LAST_ENTITY, ONCE, ANIMATION_ENEMY.STONE_SNAKE_AWAKE_RIGHT_2);
        } else {
            animate(LAST_ENTITY, ONCE, ANIMATION_ENEMY.STONE_SNAKE_AWAKE_LEFT_2);
        }

        object[object_id] = 0x01; // activate snake_west_1
    }

    fun act2_lotus_bridge_1(bridge_id, flag, x, y, value, direction:DIRECTION) {
        if!(flag) {
            walk(ACTIVE, TILE_ABSOLUTE, x, y, ACTIVE, NONE);

            if(direction == DIRECTION.NORTH) {
                walk(ACTIVE, TILE_RELATIVE, 0d0, -0d1, ACTIVE, NONE);
            } else if(direction == DIRECTION.SOUTH) {
                walk(ACTIVE, TILE_RELATIVE, 0d0, 0d1, ACTIVE, NONE);
            }
            control(ACTIVE, False);

            sound(WATER_PLOP);

            object[bridge_id] = 0x7e; // collpse bridge_west_2

            object_animator(LOTUS_BRIDGE, flag, bridge_id, value, True);
        }
    }
    fun act2_lotus_bridge_2(bridge_id, flag, x1, y1, x2, y2, value, direction:DIRECTION) {
        act2_lotus_bridge_1(bridge_id, flag, x2, y2, value, direction);
    }
    fun act2_lotus_bridge_3(bridge_id, flag, x1, y1, x2, y2, x3, y3, value, direction:DIRECTION) {
        act2_lotus_bridge_1(bridge_id, flag, x3, y3, value, direction);
    }
};
