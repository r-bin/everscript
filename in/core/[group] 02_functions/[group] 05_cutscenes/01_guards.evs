group guards() {
    fun guard_z() {
        if((<ACTIVE>[Z] > 0d0) || CUSTOM_FLAG.START_MARIO_YUMP || CUSTOM_MEMORY.START_ROCKET_JUMP_COUNT > 0d0) {
            end();
        }
    }

    fun guard_b(entity, callback) {
        if(entity[LAST_DAMAGE]) {
            if(callback is Function) {
                callback();
            }
            end();
        }
    }

    fun _guard_dead(entity:CHARACTER, callback) {
        if(_dead(entity)) {
            if(callback is Function) {
                callback();
            }
            end();
        }
    }
    fun guard_dead(entity:CHARACTER, callback) {
        if(dead(entity)) {
            if(callback is Function) {
                callback();
            }
            end();
        }
    }
    fun guard_no_hp(entity, callback) {
        if(entity[HP] <= 0d0) {
            if(callback is Function) {
                callback();
            }
            end();
        }
    }

    fun guard_boy(callback) {
        if(<ACTIVE> != <BOY>) {
            if(callback is Function) {
                callback();
            }
            end();
        }
    }
    fun guard_dog(callback) {
        if(<ACTIVE> != <DOG>) {
            if(callback !is None) {
                callback();
            }
            end();
        }
    }

    fun guard_not_flag(flag, callback) {
        if(flag) {
            if(callback !is None) {
                callback();
            }
            
            end();
        }
    }

    fun guard_bone() {
        guard_boy();
        
        if(MEMORY.CURRENT_WEAPON != WEAPON_INDEX.SWORD_1) {
            end();
        }
    }

    fun guard_critter(entity, callback) {
        if(
            (entity[TYPE] != CHARACTER_TYPE.RAT)
            && (entity[TYPE] != CHARACTER_TYPE.MOSQUITO)
        ) {
            if(callback !is None) {
                callback();
            }
            end();
        }
    }

    fun guard_true(flag, callback) {
        if!(flag) {
            if(callback !is None) {
                callback();
            }
            end();
        }
    }
    fun guard_false(flag, callback) {
        if(flag) {
            if(callback !is None) {
                callback();
            }
            end();
        }
    }
};
