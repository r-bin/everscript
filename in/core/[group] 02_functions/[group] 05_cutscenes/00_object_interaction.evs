group object_interaction() {
    enum OBJECT_ANIMATOR_MODE {
        BRIDGE_HALLS = 0x00,
        BRIDGE_HALLS_NORTH_WEST = 0x01,
        SWITCH_GROUND_HALLS = 0x10,
        SWITCH_SPEAR_HALLS = 0x11,
        GATE_HALLS = 0x12,

        REVEALER = 0x20,

        SECRET_OPEN = 0x30,
        SECRET_ACTIVE = 0x31,

        AXE2_DOOR = 0x40,
        GATE_PYRAMID = 0x41,
        LOTUS_BRIDGE = 0x42,
    }

    fun _object_animator_simple(object_id, value_active, value_inactive, sound_id:SOUND, active, delay, instant) {
        if!((instant is Word) && instant) {
            smart_sound(sound_id);

            if(active) {
                object[object_id] = value_active;
            } else {
                object[object_id] = value_inactive;
            }

            sleep(0d10);
        } else {
            if(active) {
                object[object_id] = value_active;
            } else {
                object[object_id] = value_inactive;
            }
        }
    }
    fun _object_animator(object_id, from, to, sound_id:SOUND, delay, instant) {
        if!((instant is Word) && instant) {
            if(from < to) {
                arg[0x20] = from;

                while(arg[0x20] <= to) {
                    smart_sound(sound_id);
                    object[object_id] = arg[0x20];

                    sleep(delay);

                    arg[0x20]++;
                }
            } else {
                arg[0x20] = from;

                while(arg[0x20] > to) {
                    smart_sound(sound_id);
                    object[object_id] = arg[0x20];

                    sleep(delay);

                    arg[0x20]--;
                }

                // sleep(delay);

                smart_sound(sound_id);
                object[object_id] = arg[0x20];
            }
        } else {
            object[object_id] = to;
        }
    }
    fun _object_animator_revealer(object_id, count, delay, instant) {
        while(arg[0x20] < count) {
            object[object_id + arg[0x20]] = 0x7e;
            arg[0x20]++;

            if!((instant is Word) && instant) {
                if(arg[0x20] < count) {
                    sleep(delay);
                }
            }
        }
    }
    fun object_animator(mode:OBJECT_ANIMATOR_MODE, flag, object_id, value, instant) {
        if(mode == OBJECT_ANIMATOR_MODE.SWITCH_GROUND_HALLS) {
            _object_animator_simple(object_id, 0x7e, 0x00, MAGMA_HARDENING, value, 0d10, instant);
            
            if(flag is Memory) {
                flag = True;
            }
        } else if(mode == OBJECT_ANIMATOR_MODE.SWITCH_SPEAR_HALLS) {
            _object_animator_simple(object_id, 0x01, 0x00, MECHANICAL_MOVEMENT, value, 0d10, instant);
            
            if(flag is Memory) {
                flag = True;
            }
        } else if(mode == OBJECT_ANIMATOR_MODE.BRIDGE_HALLS) {
            if(value) {
                if(flag is Memory) {
                    flag = True;
                }

                _object_animator(object_id, 0d1, 0d8, MECHANICAL_MOVEMENT, 0d8, instant);
            } else {
                _object_animator(object_id, 0d7, 0d0, MECHANICAL_MOVEMENT, 0d8, instant);

                if(flag is Memory) {
                    flag = False;
                }
            }
        } else if(mode == OBJECT_ANIMATOR_MODE.BRIDGE_HALLS_NORTH_WEST) {
            if(value) {
                if(flag is Memory) {
                    flag = True;
                }

                _object_animator(object_id, 0d1, 0d11, MECHANICAL_MOVEMENT, 0d8, instant);
            } else {
                _object_animator(object_id, 0d10, 0d0, MECHANICAL_MOVEMENT, 0d8, instant);

                if(flag is Memory) {
                    flag = False;
                }
            }
        } else if(mode == OBJECT_ANIMATOR_MODE.GATE_HALLS) {
            if(value) {
                if(flag is Memory) {
                    flag = True;
                }

                _object_animator(object_id, 0d1, 0d3, ELEVATOR_DOOR, 0d20, instant);
            } else {
                _object_animator(object_id, 0d2, 0d0, ELEVATOR_DOOR, 0d20, instant);

                if(flag is Memory) {
                    flag = False;
                }
            }
        } else if(mode == OBJECT_ANIMATOR_MODE.REVEALER) {
            if(value) {
                if(flag is Memory) {
                    flag = True;
                }

                _object_animator_revealer(object_id, value, 0d30, instant);
            } else {
                _object_animator_revealer(object_id, value, 0d30, instant);

                if(flag is Memory) {
                    flag = False;
                }
            }
        } else if(mode == OBJECT_ANIMATOR_MODE.SECRET_OPEN) {
            if(value) {
                if(flag is Memory) {
                    flag = True;
                }

                _object_animator(object_id, 0d1, 0d8, NONE, 0d8, instant);
            } else {
                _object_animator(object_id, 0d7, 0d0, NONE, 0d8, instant);

                if(flag is Memory) {
                    flag = False;
                }
            }
        } else if(mode == OBJECT_ANIMATOR_MODE.SECRET_ACTIVE) {
            if(value) {
                if(flag is Memory) {
                    flag = True;
                }

                _object_animator(object_id, 0d10, 0d12, NONE, 0d8, instant);
            } else {
                _object_animator(object_id, 0d11, 0d09, NONE, 0d8, instant);

                if(flag is Memory) {
                    flag = False;
                }
            }
        } else if(mode == OBJECT_ANIMATOR_MODE.AXE2_DOOR) {
            if(value) {
                if(flag is Memory) {
                    flag = True;
                }

                _object_animator_simple(object_id, 0d4, 0d0, THRAXX_BRIDGE_COLLAPSING, value, 0d0, True);
            } else {
                _object_animator_simple(object_id, 0d4, 0d0, THRAXX_BRIDGE_COLLAPSING, value, 0d0, True);

                if(flag is Memory) {
                    flag = False;
                }
            }
        } else if(mode == OBJECT_ANIMATOR_MODE.LOTUS_BRIDGE) {
            if(value) {
                if(flag is Memory) {
                    flag = True;
                }

                _object_animator_simple(object_id, value, 0d0, False, value, 0d0, True);
            } else {
                _object_animator_simple(object_id, value, 0d0, False, value, 0d0, True);

                if(flag is Memory) {
                    flag = False;
                }
            }
        }
    }
    fun restore_object_animator(mode:OBJECT_ANIMATOR_MODE, flag, object_id, value) {
        if(mode == OBJECT_ANIMATOR_MODE.SWITCH_GROUND_HALLS) {
            _object_animator_simple(object_id, 0x7e, 0x00, MAGMA_HARDENING, flag, 0d10, True);
        } else if(mode == OBJECT_ANIMATOR_MODE.SWITCH_SPEAR_HALLS) {
            _object_animator_simple(object_id, 0x01, 0x00, MECHANICAL_MOVEMENT, flag, 0d10, True);
        } else if(mode == OBJECT_ANIMATOR_MODE.BRIDGE_HALLS) {
            if(flag) {
                _object_animator(object_id, 0d1, 0d8, MECHANICAL_MOVEMENT, 0d8, True);
            } else {
                _object_animator(object_id, 0d7, 0d0, MECHANICAL_MOVEMENT, 0d8, True);
            }
        } else if(mode == OBJECT_ANIMATOR_MODE.BRIDGE_HALLS_NORTH_WEST) {
            if(flag) {
                _object_animator(object_id, 0d1, 0d11, MECHANICAL_MOVEMENT, 0d8, True);
            } else {
                _object_animator(object_id, 0d10, 0d0, MECHANICAL_MOVEMENT, 0d8, True);
            }
        } else if(mode == OBJECT_ANIMATOR_MODE.GATE_HALLS) {
            if(flag) {
                _object_animator(object_id, 0d1, 0d3, ELEVATOR_DOOR, 0d20, True);
            } else {
                _object_animator(object_id, 0d2, 0d0, ELEVATOR_DOOR, 0d20, True);
            }
        } else if(mode == OBJECT_ANIMATOR_MODE.REVEALER) {
            if(flag) {
                _object_animator_revealer(object_id, value, 0d30, True);
            } else {
                _object_animator_revealer(object_id, value, 0d30, True);
            }
        } else if(mode == OBJECT_ANIMATOR_MODE.SECRET_OPEN) {
            if(flag) {
                _object_animator(object_id, 0d1, 0d9, NONE, 0d8, True);
            } else {
                _object_animator(object_id, 0d8, 0d0, NONE, 0d8, True);
            }
        } else if(mode == OBJECT_ANIMATOR_MODE.SECRET_ACTIVE) {
            if(flag) {
                _object_animator(object_id, 0d10, 0d12, NONE, 0d8, True);
            } else {
                _object_animator(object_id, 0d11, 0d09, NONE, 0d8, True);
            }
        } else if(mode == OBJECT_ANIMATOR_MODE.AXE2_DOOR) {
            _object_animator_simple(object_id, 0x04, 0x00, THRAXX_BRIDGE_COLLAPSING, flag, 0d0, True);
        } else if(mode == OBJECT_ANIMATOR_MODE.LOTUS_BRIDGE) {
            _object_animator_simple(object_id, value, 0d0, False, flag, 0d0, True);
        }
    }
};
