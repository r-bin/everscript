group act_4() {
    @install()
    @weak()
    fun door_act4_airlock_out(x, y, door_id, wait_for_inactive) {
        control(NONE);

        if((!wait_for_inactive) || FLAG.DOG_UNAVAILABLE || FLAG.BOY_UNAVAILABLE) {
            walk(ACTIVE, TILE_ABSOLUTE_DIRECT, x, y, ACTIVE, NONE);

            face(ACTIVE, SOUTH);
        } else {
            walk(ACTIVE, TILE_ABSOLUTE_DIRECT, x, y, NONE, NONE);
            walk(INACTIVE, TILE_ABSOLUTE_DIRECT, x, y, NONE, NONE);
            // walk(ACTIVE, COORDINATE_ABSOLUTE, (x << 0d0003) - 0d8, y << 0d0003, NONE, NONE);
            // walk(INACTIVE, COORDINATE_ABSOLUTE, (x << 0d0003) + 0d8, y << 0d0003, NONE, NONE);

            wait(ACTIVE);
            face(ACTIVE, SOUTH);
            yield();

            wait(INACTIVE);
            face(INACTIVE, SOUTH);

            set_camera(TILE_CENTER, x, y, 0x18);
        }

        object[door_id] = 0x7e;
        sound(ACT4_DOOR_OPENING);

        sleep(0d20);

        arg[0x00] = <ACTIVE>[Y] + 0d40;
        while(<ACTIVE>[Y] < arg[0x00]) {
            <ACTIVE>[Y] += 0x02;
            if!((!wait_for_inactive) || FLAG.DOG_UNAVAILABLE || FLAG.BOY_UNAVAILABLE) {
                <INACTIVE>[Y] += 0x02;
            }
            yield();
        }

        animate(ACTIVE, ONCE_FREEZE, INVISIBLE);
        if!(FLAG.DOG_UNAVAILABLE || FLAG.BOY_UNAVAILABLE) {
            animate(INACTIVE, ONCE_FREEZE, INVISIBLE);
        }

        object[door_id] = 0x00;
        sound(ACT4_DOOR_OPENING);

        sleep(0d16);
    }
    @install()
    @weak()
    @async()
    fun door_act4_airlock_in(door_id) {
        control(NONE);
        yield();
        
        face(ACTIVE, SOUTH);
        face(INACTIVE, SOUTH);

        arg[0x10] = <ACTIVE>[Y];
        <ACTIVE>[Y] += 0d40;
        if!(FLAG.DOG_UNAVAILABLE || FLAG.BOY_UNAVAILABLE) {
            <INACTIVE>[Y] += 0d40;
        }

        animate(ACTIVE, ONCE_FREEZE, INVISIBLE);
        if!(FLAG.DOG_UNAVAILABLE || FLAG.BOY_UNAVAILABLE) {
            animate(INACTIVE, ONCE_FREEZE, INVISIBLE);
        }

        object[door_id] = 0x7e;
        sound(ACT4_DOOR_OPENING);

        sleep(0d20);

        animate(ACTIVE, ONCE_FREEZE, DEFAULT);
        if!(FLAG.DOG_UNAVAILABLE || FLAG.BOY_UNAVAILABLE) {
            animate(INACTIVE, ONCE_FREEZE, DEFAULT);
        }

        while(<ACTIVE>[Y] > arg[0x10]) {
            <ACTIVE>[Y] -= 0d2;
            if!(FLAG.DOG_UNAVAILABLE || FLAG.BOY_UNAVAILABLE) {
                <INACTIVE>[Y] -= 0d2;
            }

            yield();
        }

        sleep(0d16);

        object[door_id] = 0x00;
        sound(ACT4_DOOR_OPENING);

        control(BOTH);
    }
    
    @install()
    @weak()
    fun door_act4_airlock_secret_out(x, y, wait_for_inactive) {
        control(NONE);

        if!(wait_for_inactive) {
            walk(ACTIVE, TILE_ABSOLUTE_DIRECT, x, y, ACTIVE, NONE);

            face(ACTIVE, SOUTH);
        } else {
            walk(ACTIVE, TILE_ABSOLUTE_DIRECT, x, y, NONE, NONE);
            walk(INACTIVE, TILE_ABSOLUTE_DIRECT, x, y, NONE, NONE);
            // walk(ACTIVE, COORDINATE_ABSOLUTE, (x << 0d0003) - 0d8, y << 0d0003, NONE, NONE);
            // walk(INACTIVE, COORDINATE_ABSOLUTE, (x << 0d0003) + 0d8, y << 0d0003, NONE, NONE);

            wait(ACTIVE);
            face(ACTIVE, SOUTH);
            yield();

            wait(INACTIVE);
            face(INACTIVE, SOUTH);

            set_camera(TILE_CENTER, x, y, 0x18);
        }

        object_animator(SECRET_ACTIVE, False, 0x02, True, False);
        sound(ACT4_DOOR_OPENING);

        sleep(0d20);

        arg[0x00] = <ACTIVE>[Y] + 0d32;
        while(<ACTIVE>[Y] < arg[0x00]) {
            <ACTIVE>[Y] += 0x02;
            if(wait_for_inactive) {
                <INACTIVE>[Y] += 0x02;
            }
            yield();
        }

        animate(ACTIVE, ONCE_FREEZE, INVISIBLE);
        animate(INACTIVE, ONCE_FREEZE, INVISIBLE);

        object_animator(SECRET_ACTIVE, False, 0x02, False, False);
        sound(ACT4_DOOR_OPENING);

        sleep(0d16);
    }
    @install()
    @weak()
    @async()
    fun door_act4_airlock_secret_in() {
        control(NONE);
        face(ACTIVE, SOUTH);
        face(INACTIVE, SOUTH);

        arg[0x10] = <ACTIVE>[Y];
        <ACTIVE>[Y] += 0d32;
        <INACTIVE>[Y] += 0d32;

        animate(ACTIVE, ONCE_FREEZE, INVISIBLE);
        animate(INACTIVE, ONCE_FREEZE, INVISIBLE);

        object_animator(SECRET_ACTIVE, False, 0x02, True, False);
        sound(ACT4_DOOR_OPENING);

        sleep(0d20);

        animate(ACTIVE, ONCE_FREEZE, DEFAULT);
        animate(INACTIVE, ONCE_FREEZE, DEFAULT);

        while(<ACTIVE>[Y] > arg[0x10]) {
            <ACTIVE>[Y] -= 0d2;
            <INACTIVE>[Y] -= 0d2;

            yield();
        }

        sleep(0d16);

        object_animator(SECRET_ACTIVE, False, 0x02, False, False);
        sound(ACT4_DOOR_OPENING);

        control(BOTH);
    }

    @install()
    @async()
    @weak()
    fun door_act4_beam_in() {
        control(NONE);

        <ACTIVE>[X] -= 0d8;
        if!(FLAG.DOG_UNAVAILABLE || FLAG.BOY_UNAVAILABLE) {
            <INACTIVE>[X] += 0d8;
        }

        arg[0x10] = 0x0400;

        while(arg[0x10] > 0d0) {
            <ACTIVE>[Z] = arg[0x10];
            if!(FLAG.DOG_UNAVAILABLE || FLAG.BOY_UNAVAILABLE) {
                <INACTIVE>[Z] = arg[0x10];
            }

            yield();

            arg[0x10] -= 0x10;
        }

        if!(FLAG.DOG_UNAVAILABLE || FLAG.BOY_UNAVAILABLE) {
            walk(ACTIVE, TILE_RELATIVE, 0d0, 0d1, NONE, NONE);
            walk(INACTIVE, TILE_RELATIVE, 0d0, 0d1, BOTH, BOTH);
        } else {
            walk(ACTIVE, TILE_RELATIVE, 0d0, 0d1, ACTIVE, ACTIVE);
        }
    }

    @install()
    @async()
    @weak()
    fun _door_act4_beam_out(z) {
        while(True) {
            z += 0x10;

            <ACTIVE>[Z] = z;
            if!(FLAG.DOG_UNAVAILABLE || FLAG.BOY_UNAVAILABLE) {
                <INACTIVE>[Z] = z;
            }
            
            yield();
        }
    }
    @install()
    @weak()
    fun door_act4_beam_out(x, y) {
        control(NONE);

        walk(ACTIVE, TILE_ABSOLUTE, x - 0d1, y, NONE, NONE);
        if!(FLAG.DOG_UNAVAILABLE || FLAG.BOY_UNAVAILABLE) {
            walk(INACTIVE, TILE_ABSOLUTE, x + 0d1, y, BOTH, NONE);

            walk(INACTIVE, COORDINATE_ABSOLUTE, <ACTIVE>[X] - 0d8, <ACTIVE>[Y], INACTIVE, NONE);
        }

        while(arg[0x10] < 0x470) {
            <ACTIVE>[Z] = arg[0x10];
            if!(FLAG.DOG_UNAVAILABLE || FLAG.BOY_UNAVAILABLE) {
                <INACTIVE>[Z] = arg[0x10];
            }

            yield();

            arg[0x10] += 0x10;
        }

        _door_act4_beam_out(arg[0x10]);
    }

    fun door_act4_passage(object_id, flag) {
        if!(flag) {
            sound(ACT4_DOOR_OPENING);

            object[object_id] = 0x7e;
        }
    }

    @install()
    @weak()
    fun act4_heater_touched(direction:FACE_DIRECTION) {
        control(ACTIVE, True);

        _face(<ACTIVE>, direction);

        // <0x23d7> = 0d1;

        damage(ACTIVE, 0d1, True);

        control(ACTIVE, False);
    }

    @install()
    @async()
    @weak()
    fun _act4_evermoremachine_in(height) {
        while(True) {
            height += 0d5;

            <BOY>[Z] = height;

            yield();
        }
    }
    @install()
    @weak()
    fun act4_evermoremachine_in(x, y) {
        walk(BOY, TILE_ABSOLUTE, x, y, BOY, NONE);

        face(BOY, SOUTH);

        animate(BOY, LOOP, ANIMATION_BOY.SWIRL_EXIT);

        while(arg[0x10] < 0d1000) {
            arg[0x10] += 0d5;

            <BOY>[Z] = arg[0x10];

            yield();
        }

        animate(BOY, ONCE_FREEZE, INVISIBLE_FADE);

        _act4_evermoremachine_in(arg[0x10]);
    }
    @install()
    @async()
    @weak()
    fun act4_evermoremachine_out() {
        control(NONE);

        animate(BOY, LOOP, ANIMATION_BOY.FALL_2);

        arg[0x10] = 0d120;
        while(arg[0x10]) {
            arg[0x10]--;

            <BOY>[Z] = 0d1000;
            yield();
        }

        animate(BOY, LOOP, ANIMATION_BOY.FALL_1);
        while(<BOY>[Z] > 0d0) {
            yield();
        }

        animate(BOY, ONCE, DEFAULT);

        walk(BOY, TILE_RELATIVE, 0d0, 0d2, BOY, BOTH);
    }
};
