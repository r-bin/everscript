group dog() {
    @install()
    @async()
    @weak()
    fun _check_dog_stairs() {
        yield();

        while((<ACTIVE>[FLAGS_1] & ATTRIBUTE_FLAGS.IN_ANIMATION) || (<ACTIVE>[FLAGS_1] & ATTRIBUTE_FLAGS.DISABLED)) {
            yield();
        }

        FLAG.DOG_UNAVAILABLE = False;
        CUSTOM_FLAG.DOG_BUSY = False;
    }
    fun check_dog_stairs(flag:SOULS_MEMORY, x, y, reachable) {
        CUSTOM_FLAG.DOG_BUSY = True;

        teleport(DOG, x + 0d2, y + 0d2);

        if!(reachable) {
            smart_animate(<DOG>, ONCE_FREEZE, ANIMATION_DOG.ACT2_SIT);
        } else {
            flag = False;
            _check_dog_stairs();
        }
    }
    fun dog_stairs(flag:SOULS_MEMORY, x, y) {
        if!(CUSTOM_FLAG.NO_DOG) {
            flag = True;
            available(BOY);
            CUSTOM_FLAG.NO_DOG = True;
            FLAG.DOG_UNAVAILABLE = True;
            control(NONE);

            walk(DOG, TILE_ABSOLUTE_DIRECT, x + 0d2, y + 0d2, NONE, NONE);
            walk(BOY, TILE_ABSOLUTE, x, y - 0d5, NONE, NONE);

            wait(BOY);
            sleep(0d5);
            face(BOY, SOUTH);

            wait(DOG);
            sleep(0d16);
            face(DOG, WEST);
            sleep(0d8);

            smart_animate(<DOG>, ONCE_FREEZE, ANIMATION_DOG.ACT2_SIT);
            sleep(0d30);

            face(BOY, NORTH);
            control(BOY);
        } else {
            flag = False;
            CUSTOM_FLAG.NO_DOG = False;
            FLAG.DOG_UNAVAILABLE = False;

            available(BOTH);
            walk(BOY, TILE_ABSOLUTE_DIRECT, x - 0d3, y + 0d1, BOY, BOTH);
        }
    }
};
