group explosions() {
    fun _small_explosion(x, y) {
        add_placeholder(EXPLOSION_1, x, y, ONCE);
        attach_to_script(LAST_ENTITY);

        wait(SCRIPT_OWNER);
        destroy(SCRIPT_OWNER);
    }
    @install()
    @async()
    @weak()
    fun small_explosion(x, y) {
        _small_explosion(x, y);
    }
};
