group snes() {
    enum INPUT { // see INPUT_P1
        NONE = 0x0000,

        START = 0x1000,
        SELECT = 0x0000, // blocks inputs, including SELECT

        UP = 0x0800,
        DOWN = 0x0400,
        LEFT = 0x0200,
        RIGHT = 0x0100,

        A = 0x0080,
        B = 0x8000,
        X = 0x0040,
        Y = 0x4000,

        R = 0x0010,
        L = 0x0020,
    }
};
