group shared() {
    enum SYSTEM {
        SNIFF_SPOT_MEMORY_TYPE = 0x01, // See MEMORY_TYPE

        WITH_NO_DOG_DIALOG = False, // can double the compile time for big projects

        WITH_DEBUG_SUBTEXT = True,
        WITH_DEBUG_MUSIC = False,
        WITH_DEBUG_SOUND = False,
        WITH_DEBUG_BOMBABLE = False,
        WITH_DEBUG_START = False,
        WITH_DEBUG_CAVE = False,
        WITH_DEBUG_POISE = False,
        WITH_DEBUG_FALL = False,

        WITH_HINT_INTERACTION = True,

        HP_MAX = 0x7fff,
        ITEM_MAX = 0d99,

        WEIGHT_BOY = 0d1,
        WEIGHT_DOG = 0d1,
    }
};
