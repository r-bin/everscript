group projectile() {
    enum PROJECTILE_TYPE {
        BEACH_BALL = 0x0001,
        SPOON = 0x3255,
        SPEAR = 0x2b3f,
        MISSILE = 0x2ec1, // bazooka projectile, same as MISSILE_2
        LIGHTNING_BALL = 0x07b1,
        BIDENT = 0x1c7e,
        BOOMERANG = 0x1c43,

        ONION = 0x1656, // same as ONION_2
        BOTTLE = 0x5d35,
        BOTTLE_BROKEN = 0x5d4a,
        CITRON = 0x505d,
        ROCK = 0x5d56,
    }

    enum PROJECTILE {
        // 56 16 C9 56 16 01 E7 3C CD 00 00 00 0C 00 20 00 00 00 00 00 B0 08 E0 07 0A 00 04 00 00 00 00 00 30 00 00 00 F0 FF 0E 00 11 00 02 00 = onion
        // 0B 00 C7 01 00 01 95 3C CC 00 00 00 0A 00 14 00 00 00 00 00 20 18 E0 0E 00 00 04 00 00 00 00 00 F0 00 00 00 F6 FF 0E 00 D0 07 04 00 = beach ball

        // 05 00 C7 01 00 01 8E 3C CC 00 00 00 0A 00 01 00 89 4E 00 00 04 04 50 0C B5 00 04 00 00 00 00 00 04 00 00 00 5B 00 0E 00 D0 07 04 00 = beach ball
        // 3F 2B C7 3F 2B 01 00 00 00 00 00 00 0C 00 00 00 89 4E 00 00 40 05 20 0F 19 00 04 00 00 00 00 00 10 00 00 00 19 00 0E 00 11 00 02 00 = spear
        // 42 2B C7 3F 2B 01 8B 77 CA 00 00 00 0C 00 01 00 89 4E 00 00 4B 05 20 0F 4A 00 04 00 00 00 00 00 0B 00 00 00 23 00 0E 00 11 00 02 00 = spear

        // C1 2E C7 C1 2E 01 40 09 CB 00 00 00 0C 00 06 00 89 4E 00 00 1A 09 F0 0E D1 00 04 00 00 00 00 00 0F 00 00 00 14 00 0E 00 11 00 02 00 = vigor boomerang
        // 47 1C C9 43 1C 01 34 67 CD 00 00 00 0C 00 03 00 89 4E 00 00 48 08 30 0F DB 00 04 00 00 00 00 00 08 00 00 00 2F 00 0E 00 11 00 02 00 = boomerang

        // 00 00 00 00 00 00 00 00 00 00 00 00 0C 00 00 00 89 4E 00 00 D8 00 B8 00 00 00 0C 00 00 00 00 00 32 00 32 00 00 00 00 00 11 00 1A 00 = exploding bomb

        UNKNOWN = 0x00,
        UNKNOWN = 0x02, // [Byte]
        TYPE = 0x03, // see PROJECTILE_TYPE

        UNKNOWN = 0x0c, // 
        UNKNOWN = 0x0e, // 

        X = 0x14,
        Y = 0x16, // inverted, from 0/0
        Z = 0x18,
        VELOCTIY_X = 0x20,
        VELOCTIY_Y = 0x22,
        VELOCITY_Z = 0x24, // Z from projectile() = velocity

        TRAVEL_TIME = 0x0e, // in frames
        SOURCE = 0x10, // resets to 0x0000 after hitting or reaching

        UNKNOWN = 0x28, // stored in <0x0e9c>
        UNKNOWN = 0x2a, // stored in <0x0e9e>

        // special
        SIZE = 0x2c,
        SLOT_1 = 0x6387,
        SLOT_2 = 0x63cb,
        SLOT_3 = 0x640f,
        SLOT_4 = 0x6453,
        SLOT_5 = 0x6497,
        SLOT_6 = 0x64db,
        SLOT_7 = 0x651f,
        SLOT_8 = 0x6563,
    }
};
