    enum ANIMATION_TYPE {
        MENU_OPEN_BOY = 0xa8ed,
        MENU_CLOSE = 0x61a7,
    }
    enum ANIMATION {
        // includes: ring menus, consumables/alchemy, status effect glowing, damage effects

        // [A7 61 7E] 10 00 20 00, [89 62 7E] 81 00 FE 00 = MENU_CLOSE
        // [ED A8 90] C1 00 1E 00, [A9 61 7E] 11 00 DE 00, [4D A9 90] 81 00 1E 00 = MENU_OPEN
        // [0D AA 90] 81 00 1E 00 = menu consumables
        // [0D C0 90] 81 00 1E 00, [0D AE 90] 91 00 1E 00, [4D A9 90] A1 00 1E 00 = menu debug
        // [8D AA 90] 81 00 1E 00 = menu weapons (weapons, bazooka munition)
        // [2D C3 90] 81 00 1E 00, [0D C3 90] 91 00 1E 00 = menu alchemy
        // [AD AA 90] D1 00 1E 00, [CD AA 90] C1 00 1E 00, [8D AA 90] 91 00 1E 00, [AD C3 90] A1 00 1E 00, [8D A9 90] B1 00 1E 00 = open "player status"
        // [6D AA 90] 81 00 1E 00, [CD A8 90] 91 00 1E 00, [8D A9 90] C1 00 1E 00 = open "action"
        // [8D AA 90] 91 00 1E 00, [8D A9 90] C1 00 1E 00, [6D AD 90] A1 00 1E 00 = open "weapon skill"
        // [AD C3 90] 81 00 1E 00 = open "equipment" ring (chest, glove, helm, collar, up, down)

        // [2D A9 90] B1 00 1E 00 = target consumable?
        // [0D AA 90] 81 00 1E 00 = canel target consumable?

        // [A7 61 7E] 10 00 20 00, [89 62 7E] 81 00 FE 00 + [ED A7 90] A1 00 1E 00 = MENU_CLOSE + use petal (actual animation is far bigger than the table)
        // [A7 61 7E] 10 00 20 00, [89 62 7E] 81 00 FE 00 + ED A7 90 E1 00 1E = MENU_CLOSE + use petal (actual animation is far bigger than the table)

        TYPE = 0x00, // [24bit Word] see ANIMATION_TYPE
        ADDRESS_ROM = 0x00, // see TYPE
        
        ADDRESS_CGRAM = 0x03, // [Word] ?
        COUNT_COLORS = 0x05, // [Word] ?, x2
        
        // special
        POINTER_BASE = 0x1292,
        SIZE = 0x07,

        PALETTE_ANIMATION_START = <0x1290>,
        PALETTE_ANIMATION_END = <0x1290>,
    }

