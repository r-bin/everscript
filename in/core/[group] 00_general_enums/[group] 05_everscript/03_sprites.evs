        DOG_4_BLACK = 0x8e, // #139, "Dark Toaster", slash(1-2=default attack, 3=charged attack)
        MAGMAR_METAL = 0x7f, // #140, "Magmar"
        CARLTRON_ROBOT = 0x87, // #141, "Carltron's Robot", slash(1-3=idle?), palette(good=THRAXX2_*_ARM, THRAXX_*_ARM, decent=STONE, GATE_BOT, BONE_SNAKE, LANTERN_LIGHT*, RAT_RED, DOG_1_BLACK)

        // special
