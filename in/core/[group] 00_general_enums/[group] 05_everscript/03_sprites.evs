        STONE = 0x1e, // #23, "Rock", palette(good=GATE_BOT, DOG_4_BLACK, BONE_SNAKE, BUZZARD_BLACK, DOG_1_BLACK, MOSQUITO_BLACK, MAGMAR, VIGOR, MINITAUR, FOOTKNIGHT, RIMSALA_*, decent=RAPTOR_BLACK, LANTERN_LIGHT*, OGLIN, SPARK, MOSQUITO, RAT, SLIME_GREEN, DANCING_FOOL*, GUARD_BOT, funny=MAGGOT_RED)
        STONE_ROUND = 0x1f, // #24, "Rock"

