    enum ATTRIBUTE {
        // See data crystals: 7E3DE5 to 7E4E88 = Monster/NPC data for the current room. Each Monster/NPC gets x8E bytes of data.

        POINTER_BEHAVIOR_CURRENT = 0x00, // ?

        POINTER_BEHAVIOR_BASE = 0x03, // ?

        POINTER_BODY_SPRITE_INFO = 0x06, // ? (3 bytes)
        POINTER_SHADOW_SPRITE_INFO = 0x09, // ? (3 bytes)

        UNKNOWN = 0x10, // checks DAMAGE_SOURCE & 0x1000
        UNKNOWN = 0x12,

        PALETTE = 0x0c, // [Word] offset in palette slots, see PALETTE_SLOT_* (some seem to start with 0x08, mostly bosses) OLD: 0x0004 seems to be grayed out for some palettes (same as during the ring menu and stop)

        // used in the scripts
        MAX_HP = 0x0f, // OLD: <0x23e5>[0x0f] = boy max hp, <0x23e7>[0x0f] = dog max hp

        // see ATTRIBUTE_FLAGS (1 byte each)
        FLAGS_1 = 0x10,
        FLAGS_2 = 0x11,
        FLAGS_3 = 0x12,
        FLAGS_4 = 0x13,
        FLAGS_5 = 0x14,
        FLAGS_6 = 0x15,
        FLAGS_7 = 0x16,
        // positioning
        Z_LEVEL = 0x18, // used for stairs/bridges, masked with 0x0030 (0x10 = upper floor, 0x20 = lower floor, 0x60 = stairs?)
        X = 0x1a,
        Y = 0x1c,
        Z = 0x1e, // used for boss rush intro
        VELOCITY = 0x20, // used for wings (0xe0 signed), magmar, megataur, act2 intro, puppets, sterling flight
        FACE_DIRECTION = 0x22, // enum FACE_DIRECTION
        TARGET_LAST_WEAPON_DAMAGE = 0x24, // contains _entity_x
        HP = 0x2a,

        STAMINA = 0x2e, // enum STAMINA (seems to instantly regenerate during some animations?)
        GENERAL_PURPOSE = 0x30, // DOES NOT RESET WHEN THE SPRITE CHANGES! used for secret boss bombs (set to 0 for exploded bombs) and speakers (indexed from 2^0 to 2^8)
        UNKNOWN = 0x32, // TODO: used for secret boss and boss rush fans
        DAMAGE_SOURCE = 0x36, // entity that caused the most recent damage, only valid for 1 frame(?), used for vigor (weapon: <BOY>, dog: <DOG>, magic and projectile: 0x0000)
        DAMAGE_SOURCE_TIMER = 0x38, // when decremented from 0x14 to 0x00 sets DAMAGE_SOURCE to 0x0000
        CURRENT_GROUND = 0x3c, // good: 10 (80?, 28?, 23?, 24?, 48) bad: 31 (22?, 26?, 63?) TODO: used in ebon keep sewers (seems to be based on the tile the character stands on)

        // status effect #1
        STATUS_ID_1 = 0x46,
        STATUS_TIMER_1 = 0x48,
        STATUS_BONUS_1 = 0x4a,
        // status effect #2
        STATUS_ID_2 = 0x4c,
        STATUS_TIMER_2 = 0x4e,
        STATUS_BONUS_2 = 0x50,
        // status effect #3
        STATUS_ID_3 = 0x52,
        STATUS_TIMER_3 = 0x54,
        STATUS_BONUS_3 = 0x56,
        // status effect #4
        STATUS_ID_4 = 0x58,
        STATUS_TIMER_4 = 0x5a,
        STATUS_BONUS_4 = 0x5c,

        NEXT_ENTITY = 0x5e, // ?
        TYPE = 0x60, // see CHARACTER_TYPE

        X_TILE = 0x62, // [byte, read_only]
        Y_TILE = 0x63, // [byte, read_only]

        ATTACHED_SCRIPT_ID = 0x66, // see "attach_script(…)"
        ATTACHED_SCRIPT_TRIGGER = 0x68, // see SCRIPT_TRIGGER
        
        POINTER_STATUS_ICON_SPRITE = 0x6e, // ?

        PALETTE_COPY_1 = 0x74, // [Byte] copy palette slot offset (sometimes accessed in combination with ATTRIBUTE.PALETTE_COPY_2)
        PALETTE_COPY_2 = 0x75, // [Byte] see ATTRIBUTE.PALETTE_COPY_1
        LAST_DAMAGE = 0x76, // only available for one frame?
        PROCESSED_Z_LEVEL = 0x84, // contains: ((((Z_LEVEL & 0x0030) ^ 0x0030) << 0x01) + 0x40) + <0x0040>

        // special
        SCALING_LEVEL = 0x8a, // hack: level offset for all stats, but hp
        // WEAKNESSES = 0x8b, // hack: 
        // DAMAGE_SOURCE_DETAILS = 0x8b, // hack: dumps spell name that caused the damage, see ALCHEMY_TYPE_PROJECTILE and ALCHEMY_TYPE_ANIMATION
        
        UNKNOWN = 0x86, // read after hitting some enemies, maybe linked with animation
        UNKNOWN = 0x8c, // ffff makes the enemy despawn, when he is off screen

        ///////////////////////////////////////////////////////////////////////////////////////////
        // BOY/DOG SPECIFIC
        ///////////////////////////////////////////////////////////////////////////////////////////

        POINTER_STATUS_BAR_INFO = 0x8e, // ?
        
        TOTAL_XP_REQUIRED = 0x94,

        // outline
        OUTLINE_ID = 0x9a, // see OUTLINE, has to be set to be changed while OUTLINE_PROGRESS==0
        OUTLINE_CHOICE = 0x9c, // ?
        OUTLINE_PROGRESS = 0x9e, // 0…30…0 (MSB decides about the direction)
        // status effect boosts
        BOOST_ATTACK = 0xa0,
        BOOST_DEFEND = 0xa2,
        BOOST_EVADE = 0xa4,
        BOOST_HIT = 0xa6,
        // BOOST_MAGIC_DEFEND = 0x??,

        PIXIE_DUST = 0xac, // 0x0000->0x0001 while pixie dust is active

        ///////////////////////////////////////////////////////////////////////////////////////////
        // weird
        ///////////////////////////////////////////////////////////////////////////////////////////
        
        PALETTE_BLACK_GREEN = 0x00,
        INVISIBLE = 0x05,
        TILE_GLITCH_1 = 0x06,
        INVISIBLE_OR_TILE_GLITCH = 0x07,
        TILE_GLITCH_3 = 0x0a,
        PALETTE_BLACK_OR_TILE_GLITCH = 0x0c,
        TILE_GLITCH_4 = 0x0d,
        WEIRD_KNOCKBACK = 0x12,
        TURN_NORTH = 0x22,

        ///////////////////////////////////////////////////////////////////////////////////////////
        // special
        ///////////////////////////////////////////////////////////////////////////////////////////
        
        _BOY = 0x4E89,
        _DOG = 0x4F37,

        _entity_0_1 = 0x3de5,
        _entity_0_2 = 0x3e73,
        _entity_0_3 = 0x3f01,
        _entity_0_4 = 0x3f8f,
        _entity_0_5 = 0x401d,
        _entity_0_6 = 0x40ab,

        _entity_1 = 0x4139,
        _entity_2 = 0x41fd,
        _entity_3 = 0x4255,
        _entity_4 = 0x42E3,
        _entity_5 = 0x4371,
        _entity_6 = 0x43FF,
        _entity_7 = 0x448D,
        _entity_8 = 0x451B,
        _entity_9 = 0x45A9,
        _entity_10 = 0x4637,
        _entity_11 = 0x46C5,
        _entity_12 = 0x4753,
        _entity_13 = 0x47E1,
        _entity_14 = 0x486F,
        _entity_15 = 0x48FD,
        _entity_16 = 0x498B,
        _entity_17 = 0x4A19,
        _entity_18 = 0x4AA7,
        _entity_19 = 0x4B35,
        _entity_20 = 0x4BC3,
        _entity_21 = 0x4C51,
        _entity_22 = 0x4CDF,
        _entity_24 = 0x4DFB,
    }
    enum ATTRIBUTE_BITS {
        // used by the game

        VINCIBLE_TEMP = 0x10,
        INVINCIBLE_TEMP = 0x12, // used for: outro, boss kills (doubles, drake, verminator)

        INVINCIBLE = 0x14,
        VINCIBLE = 0x16,

        UNROOT = 0x18,
        ROOT = 0x1a,

        UNKNOWN_1_1 = 0x1c,
        UNKNOWN_1_2 = 0x1e, // used for: dog enter/exit the upper level of act4, boss rush bomb

        NO_CLIP = 0x20,
        CLIP = 0x22,

        UNKNOWN_2_1 = 0x24, // used for: thraxx knockback
        UNKNOWN_2_2 = 0x26,

        INVISIBLE = 0x28,
        VISIBLE = 0x2a,

        UNMUTE = 0x2c,
        MUTE = 0x2e, // used for: boy during bazooka cutscene
        
        AI_RUN = 0x34,
        AI_WALK = 0x36,

        UNKNOWN_3_1 = 0x30, // used for: boss rush bomb
        UNKNOWN_3_2 = 0x32,

        // unknown/weird (used for vigor)

        TURN_NORTH = 0x00,
        TURN_EAST_1 = 0x02,
        TURN_EAST_2 = 0x04,
        TURN_EAST_3 = 0x06,
        TURN_SOUTH = 0x08,
        TURN_WEST_1 = 0x0a,
        TURN_WEST_2 = 0x0c,
        TURN_WEST_3 = 0x0e

        // CRASH: 38, 3a, …
    }
    enum ATTRIBUTE_GENERAL {
        NAME_POINTER = 0x00, // static pointer to BOY_NAME/DOG_NAME

        MAX_HP = 0x0f,

        ATTACK = 0x19,
        DEFENSE = 0x1b,
        MAGIC_DEFENSE = 0x1d,
        EVASION = 0x1f,
        HIT = 0x21,
        XP = 0x23, // [Double Word]

        LEVEL = 0x2a,
        CHARGE_MAX = 0x2c,
        CHARGE_RATE = 0x2f,

        // pointer

        POINTER_SPRITE_DEFAULT = 0x32,
        POINTER_SPRITE_WALKING = 0x34,
        POINTER_SPRITE_RUNNIN = 0x46,
        POINTER_SPRITE_ATTACK_DEFAULT = 0x38, // charged <100
        POINTER_SPRITE_ATTACK_LEVEL_1 = 0x3a, // charged >=100
        POINTER_SPRITE_ATTACK_LEVEL_2 = 0x3c, // level 2
        POINTER_SPRITE_ATTACK_LEVEL_3 = 0x3e, // level 3

        // special
        POINTER_BOY = 0x0a26,
        POINTER_DOG = 0x0a70,

        SIZE = 0x48, // ?
    }

    enum THROWABLE {
        BEACH_BALL = 0x00,
        SPOON = 0x02,
        SPEAR = 0x04,
        MISSILE_2 = 0x06,
        LIGHTNING_BALL = 0x08, // has a sound attached, used: salabog
        BIDENT = 0x0a, // direction: EAST, WEST, usage: vigor
        BOOMERANG = 0x0c, // vigor

        ONION = 0x0e,
        ONION_2 = 0x10,
        BOTTLE = 0x12,
        BOTTLE_BROKEN = 0x14,
        CITRON = 0x16,
        ROCK = 0x18,

        // special
        LIGHTNING = 0x1a, // no damage, usage: evermore machine, aegis, metal magmar
        BOMB_EXPLOSION = 0x1c, // piercing, usage: bombs, carltron
        MISSILE = 0x1e, // carltron
        // CRASH: 20, 22, …
    }
};
