            LEVEL_HIGH_STOP = <0x2Fda>,
            LEVEL_LOW_SUPER_HEAL = <0x2F96>,
            LEVEL_HIGH_SUPER_HEAL = <0x2Fdc>,

            // rooms
            DARK_FOREST_XY = <0x2835>,
            DARK_FOREST_LAYOUT = <0x2839>,

            DESERT_X = (Byte) <0x22fd>,
            DESERT_Y = (Byte) <0x22fc>,

            // fade effect (used for wings and cutscenes)
            FADE_X = <0x23ad>, // usually 0x80 (center)
            FADE_Y = <0x23af>, // usually 0x70 (center)
            FADE_START = <0x23b1>, // usually 0xff (closing) or 0d2 (opening)
            FADE_STEP = <0x23b3>, // usually -0d3 (closing) or 0d3 (opening)
            FADE_TRIGGER = <0x23b5>, // usually 0d1 (TODO: sometimes 0-4 are being used), causes a lot of lag

            // ring menus (see RING_MENU)
            RING_MENU_BOY = <0x0810>, // [pointer]
            RING_MENU_BOY_ARMOR_CHEST = <0x0bfe>, // [pointer]
            RING_MENU_BOY_ARMOR_HELM = <0x0c23>, // [pointer]
            RING_MENU_BOY_ARMOR_ARMLET = <0x0c47>, // [pointer]
            RING_MENU_WEAPON = <0x07a4>, // [pointer]
            RING_MENU_WEAPON_BAZOOKA = <0x0c8f>, // [pointer]
            RING_MENU_DEBUG = <0x0f5a>, // [pointer]
            RING_MENU_CONSUMABLES = <0x07c8>, // [pointer]
            RING_MENU_CONSUMABLES_CALLBEADS = <0x0cd9>, // [pointer]
            RING_MENU_CONSUMABLES_CALLBEADS_INNER = <0x0cb5>, // [pointer], shared for all 4 categories

            RING_MENU_DOG = <0x0834>, // [pointer]
            RING_MENU_DOG_ARMOR = <0x0c6b>, // [pointer]
            
            RING_MENU_SHOP = <0x0ba1>, // [pointer]

            // reserved/hack (not part of the original engine)
            CURRENT_MUSIC = (Byte) <0x2445>, // [CUSTOM] originally "<0x0E4B>"
            MUSIC_STACK_1 = (Byte) <0x2446>, // [CUSTOM]
            MUSIC_STACK_2 = (Byte) <0x2447>, // [CUSTOM]
            MUSIC_STACK_3 = (Byte) <0x2448>, // [CUSTOM]
            MUSIC_STACK_4 = (Byte) <0x2449>, // [CUSTOM]

            CURRENT_MAP = (Byte) <0x2265>, // [CUSTOM] originally "(Byte) <0x0ADB>"
            CURRENT_MAP_VARIANT = (Byte) <0x2266>, // [CUSTOM] has to be set during the transition, before the room was entered
            CURRENT_MAP_ENTRANCE_ID = (Byte) <0x244c>, // [CUSTOM]

            // palettes

            // pallette slots (see PALETTE)
            PALETTE_SLOT_1 = <0x1278>, // some sprites are hard coded to use slot 1+2 and will overwrite the content (e.g. ENEMY.VIGOR)
            PALETTE_SLOT_2 = <0x127a>,
            PALETTE_SLOT_3 = <0x127c>, // prioritized by consumables/alchemy
            PALETTE_SLOT_4 = <0x127e>, // TODO: seems to be unused, always contains 0x0000
            PALETTE_SLOT_5 = <0x1280>, // preferred starting index for some enemies (offset 0x08)
            PALETTE_SLOT_6 = <0x1282>,
            PALETTE_SLOT_BOY = <0x1284>, // slot 7 (offset 0x0c)
            PALETTE_SLOT_DOG = <0x1286>, // slot 8 (offset 0x0e)

            // animations (?)
            ANIMATION_START_COPY = <0x128e>, // see ANIMATION_START
            ANIMATION_START = <0x1290>, // points at next free byte in ANIMATION_STACK
            ANIMATION_STACK = <0x1292>, // <0x1292>…<0x1371>, contains animation structs, see ANIMATION

            // hit boxes?
            ATTACK_SLOT_1 = <0x3bbc>, // <0x3abe>…<0x3bbd>, 0x0000 or 0x0080?
            ATTACK_SLOT_128 = <0x3abe>, // see ATTACK_SLOT_1

            // unknown
            UNKNOWN_ETERNAL_DUST_DROP_PROPERTY = <0x23d9>, // used in: boss rush (1=for eternal dust drops)

            UNKNOWN_1 = <0x23c1>, // used in: sandpits, bugmuck, bbm_2, swamp, pipemaze_rooms, waterfall, swamp_bridge, greenhouse (1=?)
            UNKNOWN_2 = <0x23d7>, // used in: sterling grab, reactor room (1=?)
        }

        enum FLAG {
