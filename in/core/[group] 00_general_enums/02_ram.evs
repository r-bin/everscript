            LEVEL_LOW_LIGHTNING_STORM = <0x2F7e>,
            LEVEL_HIGH_LIGHTNING_STORM = <0x2Fc4>,
            LEVEL_LOW_MIRACLE_CURE = <0x2F80>,
            LEVEL_HIGH_MIRACLE_CURE = <0x2Fc6>,

            LEVEL_LOW_NITRO = <0x2F82>,
            LEVEL_HIGH_NITRO = <0x2Fc8>,
            LEVEL_LOW_ONE_UP = <0x2F84>,
            LEVEL_HIGH_ONE_UP = <0x2Fca>,
            LEVEL_LOW_REFLECT = <0x2F86>,
            LEVEL_HIGH_REFLECT = <0x2Fcc>,
            LEVEL_LOW_REGROWTH = <0x2F88>,
            LEVEL_HIGH_REGROWTH = <0x2Fce>,
            LEVEL_LOW_REVEALER = <0x2F8a>,
            LEVEL_HIGH_REVEALER = <0x2Fd0>,
            LEVEL_LOW_REVIVE = <0x2F8c>,
            LEVEL_HIGH_REVIVE = <0x2Fd2>,
            LEVEL_LOW_SLOW_BURN = <0x2F8e>,
            LEVEL_HIGH_SLOW_BURN = <0x2Fd4>,
            LEVEL_LOW_SPEED = <0x2F90>,
            LEVEL_HIGH_SPEED = <0x2Fbd6>,

            LEVEL_LOW_STING = <0x2F92>,
            LEVEL_HIGH_STING = <0x2Fd8>,
